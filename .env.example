# Advertising stays disabled until AdSense Privacy & messaging is actually
# configured with a Google-certified TCF CMP for EEA, UK and Swiss traffic.
# PUBLIC_GOOGLE_CERTIFIED_CMP is only our deployment assertion; setting it to
# true does not certify this site's own analytics-only consent banner.
PUBLIC_ADSENSE_ENABLED=false
PUBLIC_GOOGLE_CERTIFIED_CMP=false
# Set true only after account-wide Auto ads and overlay formats are disabled.
PUBLIC_ADSENSE_MANUAL_ONLY=false
PUBLIC_ADSENSE_HOME_FEED_SLOT=
PUBLIC_ADSENSE_HOME_CONTENT_SLOT=
PUBLIC_ADSENSE_BOYAMA_INDEX_SLOT=
PUBLIC_ADSENSE_BOYAMA_DETAIL_SLOT=
