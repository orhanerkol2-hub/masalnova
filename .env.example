# The Google Privacy & messaging CMP is published account-side. The publisher
# tag may be enabled independently so the CMP can appear while ad units remain
# disabled. These values assert account state; they cannot configure AdSense.
PUBLIC_ADSENSE_TAG_ENABLED=false
PUBLIC_GOOGLE_CMP_PUBLISHED=false
PUBLIC_ADSENSE_ENABLED=false
# Set true only after account-wide Auto ads and overlay formats are disabled.
PUBLIC_ADSENSE_MANUAL_ONLY=false
PUBLIC_ADSENSE_HOME_FEED_SLOT=
PUBLIC_ADSENSE_HOME_CONTENT_SLOT=
PUBLIC_ADSENSE_BOYAMA_INDEX_SLOT=
PUBLIC_ADSENSE_BOYAMA_DETAIL_SLOT=
