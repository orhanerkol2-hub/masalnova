# Advertising stays disabled until AdSense Privacy & messaging is configured
# with a Google-certified TCF CMP for EEA, UK and Swiss traffic.
PUBLIC_ADSENSE_ENABLED=false
PUBLIC_GOOGLE_CERTIFIED_CMP=false
PUBLIC_ADSENSE_HOME_FEED_SLOT=
PUBLIC_ADSENSE_HOME_CONTENT_SLOT=
PUBLIC_ADSENSE_BOYAMA_INDEX_SLOT=
PUBLIC_ADSENSE_BOYAMA_DETAIL_SLOT=
PUBLIC_ADSENSE_BOYAMA_FOCUS_TOP_SLOT=

# GamePix is enabled for the games area. MasalNova AdSense is explicitly
# disabled on both /oyunlar/ and every /oyna/ gameplay page.
PUBLIC_GAMEPIX_ENABLED=true
PUBLIC_GAMEPIX_SID=58EIS
