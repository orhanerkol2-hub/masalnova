---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import StoryCard from '../components/StoryCard.astro';
import { getIslamicStories, getMasalStories, popularStories } from '../data/stories';
import {
  ageLabel,
  storyCategoryLabel,
} from '../data/taxonomy';
import {
  dateKeyInTimeZone,
  dailyRotationIndex,
} from '../lib/daily-story';

const stories = await getMasalStories();
const islamicStories = await getIslamicStories();
const buildNow = new Date();
const audienceForStory = (story: (typeof stories)[number]) =>
  story.data.audienceLabel ?? (story.data.ageGroups[0] ? ageLabel(story.data.ageGroups[0]) : 'Her yaş');

const moodForStory = (story: (typeof stories)[number]) => {
  const signals = [...story.data.categories, ...story.data.themes].join(' ').toLocaleLowerCase('tr');
  if (/(uyku|sakin|huzur|sabır|sabir|şefkat|sefkat)/.test(signals)) return 'sakin';
  if (/(macera|cesaret|keşif|kesif|kahraman)/.test(signals)) return 'macera';
  return 'neseli';
};

const storiesWithCovers = stories.filter((story) => story.data.coverImage);
const latestStories = storiesWithCovers.slice(0, 6);
const popularSelection = popularStories(storiesWithCovers, 8);
const carouselFeed = popularSelection.map((story) => ({
  id: story.id,
  title: story.data.title,
  coverImage: story.data.coverImage,
  altText: story.data.altText ?? `${story.data.title} resimli masal kapağı`,
  category: story.data.categories[0] ? storyCategoryLabel(story.data.categories[0]) : 'Çocuk masalı',
  age: audienceForStory(story),
  readingTime: story.data.readingTime,
  publishedAt: story.data.publishedAt,
  publishedLabel: new Intl.DateTimeFormat('tr-TR', {
    day: 'numeric',
    month: 'short',
  }).format(new Date(`${story.data.publishedAt}T12:00:00Z`)),
  isNew: Boolean(story.data.isNew),
}));
const carouselWindowSize = Math.min(24, carouselFeed.length);
const initialCarouselFeed = carouselFeed.slice(0, carouselWindowSize);
const serializedCarouselFeed = JSON.stringify(carouselFeed).replaceAll('<', '\\u003c');
const preferredDailyStoryId = 'keloglan-ve-yildiz-kervani';
const preferredDailyStory = storiesWithCovers.find((story) => story.id === preferredDailyStoryId);
const dailyStoryCandidates = [
  ...(preferredDailyStory ? [preferredDailyStory] : []),
  ...storiesWithCovers
    .filter((story) => story.id !== preferredDailyStoryId)
    .slice(0, 59),
];
const buildDateKey = dateKeyInTimeZone(buildNow);
const tonightStory = dailyStoryCandidates[
  dailyRotationIndex(buildDateKey, dailyStoryCandidates.length)
] ?? latestStories[0];
const dailyStoryFeed = dailyStoryCandidates.map((story) => ({
  id: story.id,
  title: story.data.title,
  shortDescription: story.data.shortDescription,
  coverImage: story.data.coverImage,
  altText: story.data.altText ?? `${story.data.title} resimli masal kapağı`,
  age: audienceForStory(story),
  readingTime: story.data.readingTime,
  moodLabel: moodForStory(story) === 'sakin' ? 'Sakin' : 'MasalNova seçkisi',
}));
const serializedDailyStoryFeed = JSON.stringify(dailyStoryFeed).replaceAll('<', '\\u003c');

const classicStoryIds = [
  'kirmizi-baslikli-kiz',
  'pamuk-prenses-ve-yedi-cuceler',
  'kulkedisi',
  'pinokyo',
  'uyuyan-guzel',
  'keloglan-dev',
];

const classicStories = classicStoryIds.flatMap((id) => {
  const story = storiesWithCovers.find((candidate) => candidate.id === id);
  return story ? [story] : [];
});

const continueStories = [...classicStories, ...popularStories(storiesWithCovers, 12)]
  .filter((story, index, list) => list.findIndex((candidate) => candidate.id === story.id) === index)
  .slice(0, 10);

const calmStories = storiesWithCovers
  .filter((story) => story.id !== tonightStory?.id && moodForStory(story) === 'sakin')
  .slice(0, 2);
const eveningStories = [tonightStory, ...calmStories].flatMap((story) => story ? [story] : []);

const categoryLinks = [
  {
    href: '/masallar/kategori/uyku/',
    label: 'Uyku masalları',
    description: 'Sakin bir gece için',
    icon: 'moon-stars',
    count: stories.filter((story) => story.data.categories.includes('uyku')).length,
    itemLabel: 'masal',
  },
  {
    href: '/masallar/kategori/egitici/',
    label: 'Eğitici masallar',
    description: 'Merakla öğrenmek için',
    icon: 'leaf',
    count: stories.filter((story) => story.data.categories.includes('egitici')).length,
    itemLabel: 'masal',
  },
  {
    href: '/masallar/kategori/hayvan/',
    label: 'Hayvan masalları',
    description: 'Sevimli dostlarla',
    icon: 'paw-print',
    count: stories.filter((story) => story.data.categories.includes('hayvan')).length,
    itemLabel: 'masal',
  },
];

const ageLinks = [3, 4, 5, 6, 7].map((age) => ({
  href: `/masallar/yas/${age}-yas/`,
  label: `${age} Yaş Masalları`,
  description: age <= 4
    ? 'Kısa, yalın ve birlikte okumaya uygun'
    : age <= 6
      ? 'Merak ve duygu odaklı hikâyeler'
      : 'Daha gelişmiş olay örgüleri',
}));

const buildDate = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  timeZone: 'Europe/Berlin',
}).format(buildNow);

const faqs = [
  {
    question: 'Masallar ücretsiz mi?',
    answer: 'Evet. MasalNova’daki yazılı masallar ücretsizdir ve hesap açmadan çevrimiçi okunabilir.',
  },
  {
    question: 'Yaşa uygun masal nasıl bulunur?',
    answer: 'Yeni masal kartlarının üzerindeki yaş ve süre bilgilerini kullanabilir veya yaş, süre ve ruh hâli filtrelerinden seçim yapabilirsiniz.',
  },
  {
    question: 'Kısa mı, uzun mu seçmeliyim?',
    answer: 'Kısa bir mola için 2–5 dakikalık hikâyeleri; daha gelişmiş bir olay örgüsü için 8–10 dakikalık uzun masalları seçebilirsiniz.',
  },
  {
    question: 'Uyku masalı kaç dakika olmalı?',
    answer: 'Süre çocuğun yaşına ve akşamki dikkatine göre değişir. Küçük çocuklar için 2–5 dakika iyi bir başlangıçtır; ilgi sürüyorsa daha uzun bir masal seçilebilir.',
  },
  {
    question: 'Keloğlan masalları hangi yaş için uygundur?',
    answer: 'Her karttaki yaş etiketini kontrol edin. Kısa ve yalın Keloğlan hikâyeleri küçük yaşlara, daha ayrıntılı maceralar ise okul çağına daha uygundur.',
  },
];

const homeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://masalnova.com/#masal-koleksiyonu',
    name: 'MasalNova: Masal Oku, Uyku Masalları ve Çocuk Hikâyeleri',
    description: 'MasalNova’da çocuklar için yüzlerce ücretsiz Türkçe masal, uyku öncesi masalları ve eğitici hikâyeler.',
    url: 'https://masalnova.com/',
    inLanguage: 'tr-TR',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: popularSelection.length,
      itemListElement: popularSelection.map((story, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `https://masalnova.com/masallar/${story.id}/`,
        name: story.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];

const homeFeedAdSlot = import.meta.env.PUBLIC_ADSENSE_HOME_FEED_SLOT;
const homeContentAdSlot = import.meta.env.PUBLIC_ADSENSE_HOME_CONTENT_SLOT;

---

<BaseLayout
  title="Masal Oku – Ücretsiz Çocuk ve Uyku Masalları | MasalNova"
  description="Çocuğunuzun yaşına, ayırdığınız süreye ve temaya uygun yüzlerce ücretsiz Türkçe masalı keşfedin. Uyku, kısa, eğitici ve Keloğlan masallarını okuyun."
  path="/"
  image={tonightStory?.data.coverImage ?? latestStories[0]?.data.coverImage}
  imageAlt={tonightStory ? `${tonightStory.data.title} resimli masal kapağı` : 'MasalNova çocuk masalları'}
  preloadImage={tonightStory?.data.coverImage ?? latestStories[0]?.data.coverImage}
  jsonLd={homeJsonLd}
  activeNav="home"
>
  <div class="home-surface">
    <div class="home-container">
      <h1 class="mobile-page-title">Masal Oku: Ücretsiz Çocuk ve Uyku Masalları</h1>

      {tonightStory && (
        <section class="home-hero-m" aria-label="Bu akşamın masalı" data-daily-story-root>
          <a class="home-hero-m-link" href={`/masallar/${tonightStory.id}/`} data-daily-story-link>
            <img
              src={tonightStory.data.coverImage}
              alt={tonightStory.data.altText ?? `${tonightStory.data.title} masal kapağı`}
              width="720"
              height="520"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              data-daily-story-image
            />
            <div class="home-hero-m-copy">
              <p class="home-hero-m-kicker">
                <i class="ph-fill ph-moon-stars" aria-hidden="true"></i> Bu akşamın masalı
              </p>
              <h2 data-daily-story-title>{tonightStory.data.title}</h2>
              <p class="home-hero-m-meta" data-daily-story-meta="mobile">
                {audienceForStory(tonightStory)} · {tonightStory.data.readingTime} dk
              </p>
              <span class="home-hero-m-cta">Masalı oku <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
            </div>
          </a>
        </section>
      )}

      {tonightStory && (
        <section class="desktop-editorial" aria-label="Bu akşam için MasalNova seçkisi" data-daily-story-root>
          <a class="desktop-editorial-hero" href={`/masallar/${tonightStory.id}/`} data-daily-story-link>
            <img
              src={tonightStory.data.coverImage}
              alt={tonightStory.data.altText ?? `${tonightStory.data.title} masal kapağı`}
              width="960"
              height="720"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              data-daily-story-image
            />
            <span class="desktop-editorial-shade" aria-hidden="true"></span>
            <div class="desktop-editorial-copy">
              <p><i class="ph-fill ph-moon-stars" aria-hidden="true"></i> Bu akşamın masalı</p>
              <h2 data-daily-story-title>{tonightStory.data.title}</h2>
              <span class="desktop-editorial-description" data-daily-story-description>{tonightStory.data.shortDescription}</span>
              <small data-daily-story-meta="desktop">
                {audienceForStory(tonightStory)} · {tonightStory.data.readingTime} dk · {moodForStory(tonightStory) === 'sakin' ? 'Sakin' : 'MasalNova seçkisi'}
              </small>
              <strong>Masalı oku <i class="ph ph-arrow-right" aria-hidden="true"></i></strong>
            </div>
          </a>

          <aside class="desktop-editorial-side" aria-label="Kısayollar">
            {continueStories[0] && (
              <a class="desktop-resume-card" href={`/masallar/${continueStories[0].id}/`} data-continue-story={continueStories[0].id}>
                <img
                  src={continueStories[0].data.coverImage}
                  alt=""
                  width="180"
                  height="180"
                  loading="eager"
                />
                <span>
                  <small><i class="ph ph-bookmark-simple" aria-hidden="true"></i> Kaldığın yer</small>
                  <strong>{continueStories[0].data.title}</strong>
                  <span class="desktop-resume-progress" aria-hidden="true"><i data-story-progress></i></span>
                  <em data-progress-label>Masalı aç</em>
                </span>
              </a>
            )}

            <nav class="desktop-shortcuts" aria-label="MasalNova bölümleri">
              <a class="is-primary" href="/videolar/">
                <i class="ph-fill ph-play-circle" aria-hidden="true"></i>
                <strong>Videolar</strong>
                <span>Masal videoları</span>
              </a>
              <a href="/oyunlar/">
                <i class="ph ph-game-controller" aria-hidden="true"></i>
                <strong>Oyunlar</strong>
                <span>Mini oyunlar</span>
              </a>
              <a href="/boyama/">
                <i class="ph ph-paint-brush-broad" aria-hidden="true"></i>
                <strong>Boyama</strong>
                <span>Yazdır veya boya</span>
              </a>
              <a href="/kitapligim/">
                <i class="ph ph-book-bookmark" aria-hidden="true"></i>
                <strong>Kitaplığım</strong>
                <span>Favoriler, ilerleme</span>
              </a>
            </nav>
          </aside>
        </section>
      )}

      <script
        id="home-daily-story-feed"
        type="application/json"
        is:inline
        set:html={serializedDailyStoryFeed}
      ></script>

      <section class="welcome" aria-labelledby="welcome-title">
        <div class="welcome-heading">
          {tonightStory?.data.coverImage && (
            <img
              class="welcome-avatar"
              src={tonightStory.data.coverImage}
              alt=""
              width="64"
              height="64"
              loading="eager"
              data-daily-story-image
            />
          )}
          <div>
            <p class="welcome-date">
              <i class="ph ph-moon-stars" aria-hidden="true"></i>
              <span data-today-date>{buildDate}</span> · Bugün
            </p>
            <h2 id="welcome-title">MasalNova’da bugün hangi masalı okuyalım?</h2>
            <p class="welcome-intro">MasalNova’da çocuğunuzun yaşına, ayırdığınız süreye ve o akşamki ruh hâline uygun Türkçe masalı birkaç saniyede bulun. Uyku masalları, Keloğlan hikâyeleri, kısa ve eğitici masallar ücretsiz ve üyeliksiz.</p>
          </div>
        </div>

        <form class="discovery-bar" action="/ara/" method="get" role="search">
          <div class="story-search">
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            <label class="sr-only" for="home-story-search">Masal ara</label>
            <input id="home-story-search" type="search" name="q" placeholder="Masal ara" autocomplete="off" />
            <button type="submit" aria-label="Masalı ara">
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </button>
          </div>

          <div class="preference-bar" aria-label="Masal tercihleri">
            <label class="preference-chip">
              <i class="ph ph-child" aria-hidden="true"></i>
              <span class="sr-only">Yaş</span>
              <select name="age" data-story-preference="age" aria-label="Yaş seç">
                <option value="">Her yaş</option>
                <optgroup label="Yaş aralığı">
                  <option value="3-5">3–5 yaş</option>
                  <option value="5-7">5–7 yaş</option>
                  <option value="7-9">7–9 yaş</option>
                </optgroup>
                <optgroup label="Tek yaş">
                  <option value="3">3 yaş</option>
                  <option value="4">4 yaş</option>
                  <option value="5">5 yaş</option>
                  <option value="6">6 yaş</option>
                  <option value="7">7 yaş</option>
                  <option value="8">8 yaş</option>
                  <option value="9">9 yaş</option>
                </optgroup>
              </select>
              <i class="ph ph-caret-down" aria-hidden="true"></i>
            </label>
            <label class="preference-chip">
              <i class="ph ph-clock" aria-hidden="true"></i>
              <span class="sr-only">Süre</span>
              <select name="duration" data-story-preference="duration" aria-label="Okuma süresi seç">
                <option value="">Her süre</option>
                <option value="kisa">2 dakika</option>
                <option value="orta">5 dakika</option>
                <option value="uzun">10 dakika</option>
                <option value="cok_uzun">Uzun masal</option>
              </select>
              <i class="ph ph-caret-down" aria-hidden="true"></i>
            </label>
            <label class="preference-chip">
              <i class="ph ph-heart" aria-hidden="true"></i>
              <span class="sr-only">Ruh hâli veya tema</span>
              <select name="topic" data-story-preference="mood" aria-label="Ruh hâli veya tema seç">
                <option value="">Her ruh hâli</option>
                <optgroup label="Ruh hâli">
                  <option value="sakin">Sakin</option>
                  <option value="neseli">Neşeli</option>
                  <option value="macera">Macera</option>
                </optgroup>
                <optgroup label="Masal türü">
                  <option value="category_uyku">Uyku</option>
                  <option value="category_hayvan">Hayvanlar</option>
                  <option value="category_egitici">Eğitici</option>
                  <option value="category_keloglan">Keloğlan</option>
                </optgroup>
                <optgroup label="Tema">
                  <option value="theme_dostluk">Dostluk</option>
                  <option value="theme_paylasma">Paylaşma</option>
                  <option value="theme_sabir">Sabır</option>
                  <option value="theme_cesaret">Cesaret</option>
                  <option value="theme_huzur">Huzur</option>
                </optgroup>
              </select>
              <i class="ph ph-caret-down" aria-hidden="true"></i>
            </label>
          </div>
        </form>
      </section>

      <section class="islamic-section-card" aria-labelledby="islamic-section-title">
        <div class="islamic-section-icon" aria-hidden="true"><i class="ph ph-mosque"></i></div>
        <div class="islamic-section-copy">
          <p>Kaynaklı anlatılar · ayrı bölüm</p>
          <h2 id="islamic-section-title">İslami Hikâyeler</h2>
          <span>Kur’an-ı Kerim, sahih veya hasen hadis ve güvenilir siyer kaynaklarından; çocukların yaşına göre sadeleştirilmiş, özenle resimlenmiş hikâyeler.</span>
          <small><i class="ph ph-book-open-text" aria-hidden="true"></i> Kaynak görünür <b aria-hidden="true">·</b> <i class="ph ph-child" aria-hidden="true"></i> Yaşa uygun <b aria-hidden="true">·</b> <i class="ph ph-shield-check" aria-hidden="true"></i> Kutsal kişiler tasvir edilmez</small>
        </div>
        <a href="/islami-hikayeler/">
          {islamicStories.length} hikâyeyi keşfet <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </section>

      <section class="latest-section" aria-labelledby="latest-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker"><i class="ph ph-sparkle" aria-hidden="true"></i> Okur seçkisi</p>
            <h2 id="latest-title">En Çok Okunan Masallar</h2>
          </div>

          <div class="carousel-controls" aria-label="Masalları kaydır">
            <button type="button" data-carousel-prev aria-label="Önceki masallar">
              <i class="ph ph-arrow-left" aria-hidden="true"></i>
            </button>
            <button type="button" data-carousel-next aria-label="Sonraki masallar">
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div
          class="latest-carousel"
          data-latest-carousel
          tabindex="0"
          role="region"
          aria-roledescription="kesintisiz kayan masal listesi"
          aria-label="En çok okunan masallar"
          aria-live="off"
          data-latest-count={carouselFeed.length}
        >
          {initialCarouselFeed.map((story, index) => (
            <article
              class="latest-card"
              data-latest-card
              data-feed-index={index}
              data-story-id={story.id}
            >
              <a
                class="latest-cover"
                data-card-cover-link
                href={`/masallar/${story.id}/`}
                aria-label={`${story.title} masalını oku`}
              >
                <img
                  data-card-image
                  src={story.coverImage}
                  alt={story.altText}
                  width="520"
                  height="520"
                  loading={index < 4 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority={index === 0 ? 'high' : 'auto'}
                />
                <span class="new-badge" data-card-new hidden={!story.isNew}>Yeni</span>
                <span class="category-badge" data-card-category>{story.category}</span>
              </a>
              <div class="latest-card-body">
                <div class="card-title-row">
                  <a data-card-title-link href={`/masallar/${story.id}/`}>
                    <h3 data-card-title>{story.title}</h3>
                  </a>
                  <button
                    class="favorite-button"
                    type="button"
                    data-favorite-story={story.id}
                    data-favorite-title={story.title}
                    aria-label={`${story.title} masalını favorilere ekle`}
                    aria-pressed="false"
                  >
                    <i class="ph ph-heart" aria-hidden="true"></i>
                  </button>
                </div>
                <div class="story-meta" aria-label="Masal bilgileri">
                  <span>
                    <i class="ph ph-child" aria-hidden="true"></i>
                    <span data-card-age>{story.age}</span>
                  </span>
                  <span>
                    <i class="ph ph-clock" aria-hidden="true"></i>
                    <span data-card-duration>{story.readingTime} dk</span>
                  </span>
                  <time data-card-date datetime={story.publishedAt}>{story.publishedLabel}</time>
                </div>
              </div>
            </article>
          ))}
        </div>

        <script
          id="home-story-carousel-feed"
          type="application/json"
          is:inline
          set:html={serializedCarouselFeed}
        ></script>

        <div class="carousel-footer">
          <div class="carousel-track" aria-hidden="true"><span data-carousel-progress></span></div>
        </div>

        <a class="mobile-all-stories-link" href="/masallar/">
          Tüm masalları gör <i class="ph ph-arrow-right" aria-hidden="true"></i>
        </a>
      </section>

      <AdSlot slot={homeFeedAdSlot} placement="home-after-latest" />

      <section
        class="continue-section"
        aria-labelledby="continue-title"
        data-smart-story-section
        data-mode="calm"
      >
        <div class="section-heading">
          <div>
            <p class="section-kicker" data-smart-story-kicker>
              <i class="ph ph-leaf" aria-hidden="true"></i>
              <span data-smart-story-kicker-label>Bu akşam için</span>
            </p>
            <h2 id="continue-title" data-smart-story-title>Bu akşamın sakin seçkisi</h2>
          </div>
          <a class="section-link" href="/masallar/kategori/uyku/" data-smart-story-link>
            <span data-smart-story-link-label>Tüm uyku masalları</span>
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <div class="evening-list" data-continue-grid>
          {eveningStories.map((story, index) => (
            <a
              class="evening-card"
              href={`/masallar/${story.id}/`}
              data-continue-story={story.id}
              data-fallback-index={index}
            >
              <img
                src={story.data.coverImage}
                alt={story.data.altText ?? `${story.data.title} masal kapağı`}
                width="220"
                height="160"
                loading="lazy"
              />
              <div class="evening-copy">
                <span>{moodForStory(story) === 'sakin' ? 'Sakin seçim' : 'MasalNova seçkisi'}</span>
                <h3>{story.data.title}</h3>
                <p>{audienceForStory(story)} · {story.data.readingTime} dk</p>
                <div class="progress-track" aria-hidden="true"><span data-story-progress></span></div>
                <small data-progress-label>Masalı oku</small>
              </div>
              <span class="read-action">Masalı oku <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
            </a>
          ))}

          {continueStories.map((story, index) => (
            <a
              class="evening-card"
              href={`/masallar/${story.id}/`}
              data-continue-story={story.id}
              data-fallback-index={index + 3}
              data-recent-candidate
              hidden
            >
              <img
                src={story.data.coverImage}
                alt={story.data.altText ?? `${story.data.title} masal kapağı`}
                width="220"
                height="160"
                loading="lazy"
              />
              <div class="evening-copy">
                <span>Senin masalın</span>
                <h3>{story.data.title}</h3>
                <p>{audienceForStory(story)} · {story.data.readingTime} dk</p>
                <div class="progress-track" aria-hidden="true"><span data-story-progress></span></div>
                <small data-progress-label>Okumaya devam et</small>
              </div>
              <span class="read-action">Devam et <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
            </a>
          ))}
        </div>
      </section>

      <section class="category-section" aria-labelledby="category-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker"><i class="ph ph-compass" aria-hidden="true"></i> Keşfet</p>
            <h2 id="category-title">Birlikte seçin</h2>
          </div>
          <a class="section-link" href="/masallar/">
            Tüm kategoriler <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <div class="category-grid">
          {categoryLinks.map((category) => (
            <a href={category.href} class="category-card">
              <span class="category-icon"><i class={`ph ph-${category.icon}`} aria-hidden="true"></i></span>
              <div>
                <h3>{category.label}</h3>
                <p>{category.description}</p>
              </div>
              <span class="category-count">{category.count} {category.itemLabel} <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
            </a>
          ))}
        </div>
      </section>

      <section class="age-section" aria-labelledby="age-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker"><i class="ph ph-child" aria-hidden="true"></i> Yaşa göre</p>
            <h2 id="age-title">Yaşa Göre Masallar</h2>
          </div>
        </div>
        <div class="age-grid">
          {ageLinks.map((age) => (
            <a href={age.href}>
              <strong>{age.label}</strong>
              <span>{age.description}</span>
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          ))}
        </div>
      </section>

      <AdSlot slot={homeContentAdSlot} placement="home-before-guide" />

      <section class="home-guide" aria-labelledby="guide-title">
        <div class="guide-copy">
          <p class="section-kicker"><i class="ph ph-book-open-text" aria-hidden="true"></i> Ebeveynler için</p>
          <h2 id="guide-title">Doğru masalı kolayca bulun</h2>
          <p>
            MasalNova; özgün Türkçe uyku masallarını, eğitici çocuk hikâyelerini ve uzun masalları sakin bir okuma deneyiminde buluşturur. Kartlardaki yaş ve süre bilgileri, o akşam için uygun hikâyeyi hızlıca seçmenize yardımcı olur.
          </p>
        </div>

        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}<i class="ph ph-plus" aria-hidden="true"></i></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="new-stories-section" aria-labelledby="new-stories-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker"><i class="ph ph-clock" aria-hidden="true"></i> Son eklenenler</p>
            <h2 id="new-stories-title">Yeni Masallar</h2>
          </div>
          <a class="section-link" href="/masallar/">Tüm masallar <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
        </div>
        <div class="grid grid-3 story-grid home-new-grid">
          {latestStories.map((story) => <StoryCard story={story} />)}
        </div>
      </section>

      <section class="settings-section" id="ayarlar" aria-labelledby="settings-title">
        <div>
          <p class="section-kicker"><i class="ph ph-shield-check" aria-hidden="true"></i> Gizlilik</p>
          <h2 id="settings-title">Basit, özel ve hesapsız.</h2>
          <p>Favoriler ve okuma ilerlemesi yalnızca bu cihazda tutulur.</p>
        </div>
        <div class="settings-actions">
          <button class="settings-install-action" type="button" data-install-app>
            <i class="ph ph-download-simple" aria-hidden="true"></i> Uygulamayı yükle
          </button>
          <button type="button" data-open-cookie-settings>
            <i class="ph ph-cookie" aria-hidden="true"></i> Çerez tercihleri
          </button>
          <button type="button" data-clear-app-state>
            <i class="ph ph-trash" aria-hidden="true"></i> Yerel verileri temizle
          </button>
          <p data-settings-status role="status" aria-live="polite"></p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    APP_STATE_CHANGE_EVENT,
    APP_STATE_VERSION,
    loadState,
    saveState,
    setPreferences,
    toggleFavorite,
    type AppState,
  } from '../lib/app-state';
  import {
    dateKeyInTimeZone,
    dailyRotationIndex,
  } from '../lib/daily-story';

  type DailyStory = {
    id: string;
    title: string;
    shortDescription: string;
    coverImage: string;
    altText: string;
    age: string;
    readingTime: number;
    moodLabel: string;
  };

  type CarouselStory = {
    id: string;
    title: string;
    coverImage: string;
    altText: string;
    category: string;
    age: string;
    readingTime: number;
    publishedAt: string;
    publishedLabel: string;
    isNew: boolean;
  };

  const carousel = document.querySelector<HTMLElement>('[data-latest-carousel]');
  const carouselCards = [...document.querySelectorAll<HTMLElement>('[data-latest-card]')];
  const progressBar = document.querySelector<HTMLElement>('[data-carousel-progress]');
  const preferenceInputs = [...document.querySelectorAll<HTMLSelectElement>('[data-story-preference]')];
  const discoveryForm = document.querySelector<HTMLFormElement>('.discovery-bar');
  const storySearchInput = document.getElementById('home-story-search') as HTMLInputElement | null;
  const carouselFeedElement = document.getElementById('home-story-carousel-feed');
  const dailyStoryFeedElement = document.getElementById('home-daily-story-feed');

  let dailyStoryFeed: DailyStory[] = [];
  try {
    const parsedFeed = JSON.parse(dailyStoryFeedElement?.textContent ?? '[]');
    if (Array.isArray(parsedFeed)) dailyStoryFeed = parsedFeed;
  } catch {
    dailyStoryFeed = [];
  }

  let activeDailyStoryDate = '';

  function renderDailyStory() {
    const dateKey = dateKeyInTimeZone();
    if (!dailyStoryFeed.length || activeDailyStoryDate === dateKey) return;

    const story = dailyStoryFeed[dailyRotationIndex(dateKey, dailyStoryFeed.length)];
    if (!story) return;

    const href = `/masallar/${story.id}/`;
    document.querySelectorAll<HTMLElement>('[data-daily-story-root]').forEach((root) => {
      root.dataset.dailyStoryId = story.id;
    });
    document.querySelectorAll<HTMLAnchorElement>('[data-daily-story-link]').forEach((link) => {
      link.href = href;
    });
    document.querySelectorAll<HTMLImageElement>('[data-daily-story-image]').forEach((image) => {
      image.src = story.coverImage;
      image.alt = story.altText;
    });
    document.querySelectorAll<HTMLElement>('[data-daily-story-title]').forEach((title) => {
      title.textContent = story.title;
    });
    document.querySelectorAll<HTMLElement>('[data-daily-story-description]').forEach((description) => {
      description.textContent = story.shortDescription;
    });
    document.querySelectorAll<HTMLElement>('[data-daily-story-meta]').forEach((meta) => {
      const sharedMeta = `${story.age} · ${story.readingTime} dk`;
      meta.textContent = meta.dataset.dailyStoryMeta === 'mobile'
        ? sharedMeta
        : `${sharedMeta} · ${story.moodLabel}`;
    });

    activeDailyStoryDate = dateKey;
  }

  let carouselFeed: CarouselStory[] = [];
  try {
    const parsedFeed = JSON.parse(carouselFeedElement?.textContent ?? '[]');
    if (Array.isArray(parsedFeed)) carouselFeed = parsedFeed;
  } catch {
    carouselFeed = [];
  }

  let currentState: AppState | undefined;
  let nextFeedIndex = carouselFeed.length
    ? carouselCards.length % carouselFeed.length
    : 0;
  let carouselFrame: number | undefined;
  let previousFrameTime = 0;
  let carouselPixelRemainder = 0;
  let cachedCardStep = 0;
  const CAROUSEL_SPEED_PX_PER_SECOND = 32;

  function firstCarouselCard() {
    const first = carousel?.firstElementChild;
    return first instanceof HTMLElement ? first : undefined;
  }

  function lastCarouselCard() {
    const last = carousel?.lastElementChild;
    return last instanceof HTMLElement ? last : undefined;
  }

  function carouselCardStep() {
    if (cachedCardStep > 0) return cachedCardStep;
    const first = firstCarouselCard();
    if (!carousel || !first) return 0;
    const gap = Number.parseFloat(getComputedStyle(carousel).columnGap) || 0;
    cachedCardStep = first.offsetWidth + gap;
    return cachedCardStep;
  }

  function syncFavoriteButton(button: HTMLButtonElement, state = currentState) {
    const storyId = button.dataset.favoriteStory ?? '';
    const storyTitle = button.dataset.favoriteTitle ?? 'Masal';
    const favorite = state?.favorites.includes(storyId) ?? false;
    button.setAttribute('aria-pressed', String(favorite));
    button.setAttribute('aria-label', favorite
      ? `${storyTitle} masalını favorilerden çıkar`
      : `${storyTitle} masalını favorilere ekle`);
    button.classList.toggle('is-favorite', favorite);
    const icon = button.querySelector('i');
    if (icon) icon.className = favorite ? 'ph-fill ph-heart' : 'ph ph-heart';
  }

  function renderCarouselCard(card: HTMLElement, feedIndex: number) {
    const story = carouselFeed[feedIndex];
    if (!story) return;

    const href = `/masallar/${story.id}/`;
    card.dataset.feedIndex = String(feedIndex);
    card.dataset.storyId = story.id;

    const coverLink = card.querySelector<HTMLAnchorElement>('[data-card-cover-link]');
    if (coverLink) {
      coverLink.href = href;
      coverLink.setAttribute('aria-label', `${story.title} masalını oku`);
    }

    const titleLink = card.querySelector<HTMLAnchorElement>('[data-card-title-link]');
    if (titleLink) titleLink.href = href;

    const image = card.querySelector<HTMLImageElement>('[data-card-image]');
    if (image) {
      image.loading = 'lazy';
      image.fetchPriority = 'auto';
      image.src = story.coverImage;
      image.alt = story.altText;
    }

    const newBadge = card.querySelector<HTMLElement>('[data-card-new]');
    if (newBadge) newBadge.hidden = !story.isNew;

    const category = card.querySelector<HTMLElement>('[data-card-category]');
    if (category) category.textContent = story.category;

    const title = card.querySelector<HTMLElement>('[data-card-title]');
    if (title) title.textContent = story.title;

    const age = card.querySelector<HTMLElement>('[data-card-age]');
    if (age) age.textContent = story.age;

    const duration = card.querySelector<HTMLElement>('[data-card-duration]');
    if (duration) duration.textContent = `${story.readingTime} dk`;

    const date = card.querySelector<HTMLTimeElement>('[data-card-date]');
    if (date) {
      date.dateTime = story.publishedAt;
      date.textContent = story.publishedLabel;
    }

    const favoriteButton = card.querySelector<HTMLButtonElement>('[data-favorite-story]');
    if (favoriteButton) {
      favoriteButton.dataset.favoriteStory = story.id;
      favoriteButton.dataset.favoriteTitle = story.title;
      syncFavoriteButton(favoriteButton);
    }
  }

  function updateCarouselProgress() {
    const activeIndex = Number(firstCarouselCard()?.dataset.feedIndex ?? 0);
    const total = carouselFeed.length || Number(carousel?.dataset.latestCount ?? carouselCards.length);
    const percentage = total ? ((activeIndex + 1) / total) * 100 : 0;
    progressBar?.style.setProperty('width', `${percentage}%`);
  }

  function recycleCarouselForward() {
    if (!carousel || carouselCards.length < 2) return;
    const first = firstCarouselCard();
    const step = carouselCardStep();
    if (!first || step <= 0) return;

    if (carouselFeed.length > carouselCards.length) {
      renderCarouselCard(first, nextFeedIndex);
      nextFeedIndex = (nextFeedIndex + 1) % carouselFeed.length;
    }

    carousel.append(first);
    carousel.scrollLeft = Math.max(0, carousel.scrollLeft - step);
    updateCarouselProgress();
  }

  function recycleCarouselBackward() {
    if (!carousel || carouselCards.length < 2) return;
    const first = firstCarouselCard();
    const last = lastCarouselCard();
    if (!first || !last) return;

    if (carouselFeed.length > carouselCards.length) {
      const currentIndex = Number(first.dataset.feedIndex ?? 0);
      const previousIndex = (currentIndex - 1 + carouselFeed.length) % carouselFeed.length;
      renderCarouselCard(last, previousIndex);
      nextFeedIndex = (previousIndex + carouselCards.length) % carouselFeed.length;
    }

    carousel.prepend(last);
    carousel.scrollLeft = 0;
    updateCarouselProgress();
  }

  function moveCarousel(direction: 1 | -1) {
    if (direction === 1) recycleCarouselForward();
    else recycleCarouselBackward();
  }

  function normalizeCarousel() {
    if (!carousel) return;
    const step = carouselCardStep();
    let safety = 0;
    while (step > 0 && carousel.scrollLeft >= step && safety < carouselCards.length) {
      recycleCarouselForward();
      safety += 1;
    }
  }

  function runCarousel(timestamp: number) {
    if (!carousel || carouselCards.length < 2) {
      carouselFrame = undefined;
      return;
    }

    const elapsed = previousFrameTime
      ? Math.min(timestamp - previousFrameTime, 80)
      : 0;
    previousFrameTime = timestamp;
    carouselPixelRemainder += (elapsed / 1000) * CAROUSEL_SPEED_PX_PER_SECOND;
    const pixelsToMove = Math.floor(carouselPixelRemainder);
    if (pixelsToMove > 0) {
      carousel.scrollLeft += pixelsToMove;
      carouselPixelRemainder -= pixelsToMove;
      normalizeCarousel();
    }
    carouselFrame = window.requestAnimationFrame(runCarousel);
  }

  const desktopCarouselQuery = window.matchMedia('(min-width: 721px)');
  const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  function shouldAutoplayCarousel() {
    return desktopCarouselQuery.matches && !reducedMotionQuery.matches;
  }

  function stopCarousel() {
    if (carouselFrame !== undefined) window.cancelAnimationFrame(carouselFrame);
    carouselFrame = undefined;
    previousFrameTime = 0;
    carouselPixelRemainder = 0;
  }

  function startCarousel() {
    if (!shouldAutoplayCarousel() || carouselFrame !== undefined) return;
    previousFrameTime = 0;
    carouselFrame = window.requestAnimationFrame(runCarousel);
  }

  function syncCarouselAutoplay() {
    if (shouldAutoplayCarousel()) {
      startCarousel();
      return;
    }
    stopCarousel();
    if (!desktopCarouselQuery.matches && carousel) carousel.scrollLeft = 0;
  }

  document.querySelector('[data-carousel-next]')?.addEventListener('click', () => moveCarousel(1));
  document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => moveCarousel(-1));

  carousel?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowRight') {
      event.preventDefault();
      moveCarousel(1);
    }
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      moveCarousel(-1);
    }
  });

  window.addEventListener('resize', () => {
    cachedCardStep = 0;
    syncCarouselAutoplay();
  });

  desktopCarouselQuery.addEventListener('change', syncCarouselAutoplay);
  reducedMotionQuery.addEventListener('change', syncCarouselAutoplay);

  function valuesForPreferences() {
    return Object.fromEntries(preferenceInputs.map((input) => [input.dataset.storyPreference, input.value]));
  }

  function saveCurrentPreferences() {
    const values = valuesForPreferences();
    setPreferences({
      age: values.age || null,
      duration: values.duration || null,
      mood: values.mood || null,
    });
  }

  function resultsUrl(mode: 'search' | 'filter') {
    const url = new URL('/ara/', location.origin);

    if (mode === 'search') {
      const query = storySearchInput?.value.trim();
      if (query) url.searchParams.set('q', query);
    } else {
      preferenceInputs.forEach((input) => {
        if (input.value) url.searchParams.set(input.name, input.value);
      });
    }

    return `${url.pathname}${url.search}`;
  }

  discoveryForm?.addEventListener('submit', (event) => {
    event.preventDefault();
    const mode = storySearchInput?.value.trim() ? 'search' : 'filter';
    location.assign(resultsUrl(mode));
  });

  preferenceInputs.forEach((input) => {
    input.addEventListener('change', () => {
      saveCurrentPreferences();
      if (storySearchInput) storySearchInput.value = '';
      location.assign(resultsUrl('filter'));
    });
  });

  function applyPreferencesFromState(state: AppState) {
    preferenceInputs.forEach((input) => {
      const key = input.dataset.storyPreference as 'age' | 'duration' | 'mood';
      input.value = state.preferences[key] ?? '';
    });
  }

  function renderLocalState(state: AppState) {
    currentState = state;
    document.querySelectorAll<HTMLButtonElement>('[data-favorite-story]').forEach((button) => {
      syncFavoriteButton(button, state);
    });

    const continueCards = [...document.querySelectorAll<HTMLElement>('[data-continue-story]')];
    const candidates = continueCards.filter((card) => card.hasAttribute('data-recent-candidate'));
    const availableIds = new Set(candidates.map((card) => card.dataset.continueStory ?? ''));
    const recentIds = state.recentStoryIds.filter((id) => availableIds.has(id)).slice(0, 3);
    const hasRecentStories = recentIds.length > 0;

    const smartSection = document.querySelector<HTMLElement>('[data-smart-story-section]');
    const smartIcon = document.querySelector<HTMLElement>('[data-smart-story-kicker] i');
    const smartLabel = document.querySelector<HTMLElement>('[data-smart-story-kicker-label]');
    const smartTitle = document.querySelector<HTMLElement>('[data-smart-story-title]');
    const smartLink = document.querySelector<HTMLAnchorElement>('[data-smart-story-link]');
    const smartLinkLabel = document.querySelector<HTMLElement>('[data-smart-story-link-label]');

    if (smartSection) smartSection.dataset.mode = hasRecentStories ? 'recent' : 'calm';
    if (smartIcon) smartIcon.className = hasRecentStories ? 'ph ph-bookmark-simple' : 'ph ph-leaf';
    if (smartLabel) smartLabel.textContent = hasRecentStories ? 'Senin alanın' : 'Bu akşam için';
    if (smartTitle) smartTitle.textContent = hasRecentStories ? 'Kaldığın yerden devam et' : 'Bu akşamın sakin seçkisi';
    if (smartLink) smartLink.href = hasRecentStories ? '/kitapligim/' : '/masallar/kategori/uyku/';
    if (smartLinkLabel) smartLinkLabel.textContent = hasRecentStories ? 'Kitaplığı aç' : 'Tüm uyku masalları';

    continueCards.forEach((card) => {
      const id = card.dataset.continueStory ?? '';
      const isCandidate = card.hasAttribute('data-recent-candidate');
      const visible = hasRecentStories ? isCandidate && recentIds.includes(id) : !isCandidate;
      card.hidden = !visible;
      card.style.order = String(hasRecentStories ? recentIds.indexOf(id) : Number(card.dataset.fallbackIndex ?? 0));
      const progress = state.progress[id] ?? 0;
      card.querySelector<HTMLElement>('[data-story-progress]')?.style.setProperty('width', `${progress}%`);
      const label = card.querySelector<HTMLElement>('[data-progress-label]');
      if (label) label.textContent = hasRecentStories
        ? (progress > 0 ? `%${progress} tamamlandı` : 'Okumaya devam et')
        : 'Masalı oku';
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-favorite-story]').forEach((button) => {
    button.addEventListener('click', () => {
      const storyId = button.dataset.favoriteStory;
      if (storyId) renderLocalState(toggleFavorite(storyId));
    });
  });

  document.querySelector('[data-clear-app-state]')?.addEventListener('click', () => {
    const cleared = saveState({
      version: APP_STATE_VERSION,
      favorites: [],
      recentStoryIds: [],
      progress: {},
      preferences: { age: null, duration: null, mood: null },
    });
    preferenceInputs.forEach((input) => { input.value = ''; });
    renderLocalState(cleared);
    updateCarouselProgress();
    const status = document.querySelector<HTMLElement>('[data-settings-status]');
    if (status) status.textContent = 'Favoriler ve okuma ilerlemesi bu cihazdan temizlendi.';
  });

  document.querySelector('[data-open-cookie-settings]')?.addEventListener('click', () => {
    document.querySelector<HTMLButtonElement>('#stcm-icon')?.click();
  });

  window.addEventListener(APP_STATE_CHANGE_EVENT, (event) => {
    const detail = (event as CustomEvent<{ state: AppState }>).detail;
    if (detail?.state) renderLocalState(detail.state);
  });

  const dateTarget = document.querySelector<HTMLElement>('[data-today-date]');
  if (dateTarget) {
    dateTarget.textContent = new Intl.DateTimeFormat('tr-TR', {
      day: 'numeric',
      month: 'long',
      timeZone: 'Europe/Berlin',
    }).format(new Date());
  }

  renderDailyStory();
  window.setInterval(renderDailyStory, 60_000);

  const initialState = loadState();
  applyPreferencesFromState(initialState);
  renderLocalState(initialState);
  updateCarouselProgress();
  startCarousel();
</script>

<style>
  .home-surface {
    min-height: calc(100dvh - var(--app-nav-height));
    background: #fbf8f1;
    color: #0d2869;
  }

  .home-container {
    width: min(100%, 1320px);
    margin: 0 auto;
    padding: 34px clamp(28px, 4vw, 58px) 86px;
  }

  .home-kid-nav,
  .home-hero-m { display: none; }

  .mobile-page-title {
    display: block;
    max-width: 24ch;
    margin: 0 0 10px;
    color: #0b2b75;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.08;
    letter-spacing: -.05em;
  }

  .desktop-editorial {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(290px, .85fr);
    gap: 18px;
    margin-top: 24px;
  }

  .desktop-editorial-hero {
    position: relative;
    min-height: 398px;
    overflow: hidden;
    border-radius: 27px;
    background: #102e78;
    box-shadow: 0 20px 48px rgba(21,42,93,.15);
  }

  .desktop-editorial-hero > img {
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0;
    object-fit: cover;
  }

  .desktop-editorial-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(7,31,91,.94) 0%, rgba(7,31,91,.75) 46%, rgba(7,31,91,.08) 82%);
  }

  .desktop-editorial-copy {
    position: relative;
    z-index: 1;
    width: min(64%, 540px);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(28px, 4vw, 48px);
    color: #fff;
  }

  .desktop-editorial-copy > p {
    display: flex;
    align-items: center;
