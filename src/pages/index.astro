---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import { getStories, popularStories } from '../data/stories';
import {
  ageLabel,
  durationBucketForMinutes,
  storyCategoryLabel,
} from '../data/taxonomy';

const stories = await getStories();

const moodForStory = (story: (typeof stories)[number]) => {
  const signals = [...story.data.categories, ...story.data.themes].join(' ').toLocaleLowerCase('tr');
  if (/(uyku|sakin|huzur|sabır|sabir|şefkat|sefkat)/.test(signals)) return 'sakin';
  if (/(macera|cesaret|keşif|kesif|kahraman)/.test(signals)) return 'macera';
  return 'neseli';
};

const storiesWithCovers = stories.filter((story) => story.data.coverImage);
const latestStories = storiesWithCovers.slice(0, 12);
const tonightStory = storiesWithCovers.find((story) => story.data.isTodayStory)
  ?? storiesWithCovers.find((story) => moodForStory(story) === 'sakin')
  ?? latestStories[0];

const classicStoryIds = [
  'kirmizi-baslikli-kiz',
  'pamuk-prenses-ve-yedi-cuceler',
  'kulkedisi',
  'pinokyo',
  'uyuyan-guzel',
  'keloglan-dev',
];

const classicStories = classicStoryIds.flatMap((id) => {
  const story = storiesWithCovers.find((candidate) => candidate.id === id);
  return story ? [story] : [];
});

const continueStories = [...classicStories, ...popularStories(storiesWithCovers, 12)]
  .filter((story, index, list) => list.findIndex((candidate) => candidate.id === story.id) === index)
  .slice(0, 10);

const calmStories = storiesWithCovers
  .filter((story) => story.id !== tonightStory?.id && moodForStory(story) === 'sakin')
  .slice(0, 2);
const eveningStories = [tonightStory, ...calmStories].flatMap((story) => story ? [story] : []);

const categoryLinks = [
  {
    href: '/masallar/kategori/uyku/',
    label: 'Uyku masalları',
    description: 'Sakin bir gece için',
    icon: 'moon-stars',
    count: stories.filter((story) => story.data.categories.includes('uyku')).length,
  },
  {
    href: '/masallar/kategori/egitici/',
    label: 'Eğitici masallar',
    description: 'Merakla öğrenmek için',
    icon: 'leaf',
    count: stories.filter((story) => story.data.categories.includes('egitici')).length,
  },
  {
    href: '/masallar/kategori/hayvan/',
    label: 'Hayvan masalları',
    description: 'Sevimli dostlarla',
    icon: 'paw-print',
    count: stories.filter((story) => story.data.categories.includes('hayvan')).length,
  },
];

const formatPublishedDate = (value: string) => new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'short',
}).format(new Date(`${value}T12:00:00Z`));

const buildDate = new Intl.DateTimeFormat('tr-TR', {
  day: 'numeric',
  month: 'long',
  timeZone: 'Europe/Istanbul',
}).format(new Date());

const faqs = [
  {
    question: 'Masallar ücretsiz mi?',
    answer: 'Evet. MasalNova’daki yazılı masallar ücretsizdir ve hesap açmadan çevrimiçi okunabilir.',
  },
  {
    question: 'Yaşa uygun masal nasıl bulunur?',
    answer: 'Yeni masal kartlarının üzerindeki yaş ve süre bilgilerini kullanabilir veya yaş, süre ve ruh hâli filtrelerinden seçim yapabilirsiniz.',
  },
  {
    question: 'Kısa mı, uzun mu seçmeliyim?',
    answer: 'Kısa bir mola için 2–5 dakikalık hikâyeleri; daha gelişmiş bir olay örgüsü için 8–10 dakikalık uzun masalları seçebilirsiniz.',
  },
];

const homeJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://masalnova.com/#masal-koleksiyonu',
    name: 'Masal Oku – Yeni Türkçe Uyku Masalları ve Çocuk Hikâyeleri',
    description: 'Çocuklar için ücretsiz Türkçe uyku masalları, eğitici masallar ve yeni çocuk hikâyeleri.',
    url: 'https://masalnova.com/',
    inLanguage: 'tr-TR',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: latestStories.length,
      itemListElement: latestStories.map((story, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: `https://masalnova.com/masallar/${story.id}/`,
        name: story.data.title,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
];

const homeFeedAdSlot = import.meta.env.PUBLIC_ADSENSE_HOME_FEED_SLOT;
const homeContentAdSlot = import.meta.env.PUBLIC_ADSENSE_HOME_CONTENT_SLOT;
---

<BaseLayout
  title="Masal Oku – Yeni Uyku Masalları ve Çocuk Hikâyeleri | MasalNova"
  description="Masal oku: Çocuklar için ücretsiz Türkçe uyku masalları, eğitici ve uzun çocuk hikâyeleri. En yeni masalları yaşa, süreye ve ruh hâline göre keşfet."
  path="/"
  image={latestStories[0]?.data.coverImage}
  imageAlt={latestStories[0] ? `${latestStories[0].data.title} resimli masal kapağı` : 'MasalNova çocuk masalları'}
  preloadImage={latestStories[0]?.data.coverImage}
  jsonLd={homeJsonLd}
  activeNav="home"
>
  <div class="home-surface">
    <div class="home-container">
      <section class="welcome" aria-labelledby="welcome-title">
        <div class="welcome-heading">
          {tonightStory?.data.coverImage && (
            <img
              class="welcome-avatar"
              src={tonightStory.data.coverImage}
              alt=""
              width="64"
              height="64"
              loading="eager"
            />
          )}
          <div>
            <p class="welcome-date">
              <i class="ph ph-moon-stars" aria-hidden="true"></i>
              <span data-today-date>{buildDate}</span> · Bugün
            </p>
            <h1 id="welcome-title">Bugün ne okuyalım?</h1>
            <p class="welcome-intro">Çocuğunuz için yeni, sakin ve yaşına uygun bir masalı birkaç saniyede bulun.</p>
          </div>
        </div>

        <form class="discovery-bar" action="/ara/" method="get" role="search">
          <div class="story-search">
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            <label class="sr-only" for="home-story-search">Masal ara</label>
            <input id="home-story-search" type="search" name="q" placeholder="Masal ara" autocomplete="off" />
            <button type="submit" aria-label="Masalı ara">
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </button>
          </div>

          <div class="preference-bar" aria-label="Masal tercihleri">
            <label class="preference-chip">
              <i class="ph ph-child" aria-hidden="true"></i>
              <span class="sr-only">Yaş</span>
              <select data-story-preference="age" aria-label="Yaş seç">
                <option value="">Her yaş</option>
                <option value="3-5">3–5 yaş</option>
                <option value="5-7">5–7 yaş</option>
                <option value="7-9">7–9 yaş</option>
              </select>
              <i class="ph ph-caret-down" aria-hidden="true"></i>
            </label>
            <label class="preference-chip">
              <i class="ph ph-clock" aria-hidden="true"></i>
              <span class="sr-only">Süre</span>
              <select data-story-preference="duration" aria-label="Okuma süresi seç">
                <option value="">Her süre</option>
                <option value="kisa">2 dakika</option>
                <option value="orta">5 dakika</option>
                <option value="uzun">Uzun masal</option>
              </select>
              <i class="ph ph-caret-down" aria-hidden="true"></i>
            </label>
            <label class="preference-chip">
              <i class="ph ph-heart" aria-hidden="true"></i>
              <span class="sr-only">Ruh hâli</span>
              <select data-story-preference="mood" aria-label="Ruh hâli seç">
                <option value="">Her ruh hâli</option>
                <option value="sakin">Sakin</option>
                <option value="neseli">Neşeli</option>
                <option value="macera">Macera</option>
              </select>
              <i class="ph ph-caret-down" aria-hidden="true"></i>
            </label>
          </div>
        </form>
      </section>

      <section class="latest-section" aria-labelledby="latest-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker"><i class="ph ph-sparkle" aria-hidden="true"></i> Kronolojik</p>
            <h2 id="latest-title">En yeni masallar</h2>
          </div>

          <div class="carousel-controls" aria-label="Yeni masalları kaydır">
            <button type="button" data-carousel-prev aria-label="Önceki masallar">
              <i class="ph ph-arrow-left" aria-hidden="true"></i>
            </button>
            <button
              class="autoplay-toggle"
              type="button"
              data-carousel-autoplay
              aria-label="Otomatik geçişi duraklat"
              aria-pressed="false"
            >
              <span class="autoplay-dot" aria-hidden="true"></span>
              <span data-autoplay-label>Otomatik</span>
              <i class="ph ph-pause" aria-hidden="true"></i>
            </button>
            <button type="button" data-carousel-next aria-label="Sonraki masallar">
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </button>
          </div>
        </div>

        <div
          class="latest-carousel"
          data-latest-carousel
          tabindex="0"
          role="region"
          aria-roledescription="otomatik kayan masal listesi"
          aria-label="En yeni masallar, en yeniden eskiye"
        >
          {latestStories.map((story, index) => {
            const d = story.data;
            const category = d.categories[0] ? storyCategoryLabel(d.categories[0]) : 'Çocuk masalı';
            const mood = moodForStory(story);
            return (
              <article
                class="latest-card"
                data-latest-card
                data-story-id={story.id}
                data-age={d.ageGroups.join(' ')}
                data-duration={durationBucketForMinutes(d.readingTime)}
                data-mood={mood}
              >
                <a class="latest-cover" href={`/masallar/${story.id}/`} aria-label={`${d.title} masalını oku`}>
                  <img
                    src={d.coverImage}
                    alt={d.altText ?? `${d.title} resimli masal kapağı`}
                    width="520"
                    height="520"
                    loading={index < 5 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority={index === 0 ? 'high' : 'auto'}
                  />
                  <span class="new-badge">Yeni</span>
                  <span class="category-badge">{category}</span>
                </a>
                <div class="latest-card-body">
                  <div class="card-title-row">
                    <a href={`/masallar/${story.id}/`}>
                      <h3>{d.title}</h3>
                    </a>
                    <button
                      class="favorite-button"
                      type="button"
                      data-favorite-story={story.id}
                      data-favorite-title={d.title}
                      aria-label={`${d.title} masalını favorilere ekle`}
                      aria-pressed="false"
                    >
                      <i class="ph ph-heart" aria-hidden="true"></i>
                    </button>
                  </div>
                  <div class="story-meta" aria-label="Masal bilgileri">
                    {d.ageGroups[0] && <span><i class="ph ph-child" aria-hidden="true"></i>{ageLabel(d.ageGroups[0])}</span>}
                    <span><i class="ph ph-clock" aria-hidden="true"></i>{d.readingTime} dk</span>
                    <time datetime={d.publishedAt}>{formatPublishedDate(d.publishedAt)}</time>
                  </div>
                </div>
              </article>
            );
          })}
        </div>

        <div class="carousel-footer">
          <div class="carousel-track" aria-hidden="true"><span data-carousel-progress></span></div>
          <p data-filter-status aria-live="polite">En yeni {latestStories.length} masal gösteriliyor.</p>
        </div>

        <div class="no-filter-results" data-no-filter-results hidden>
          <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
          <p>Bu seçimde yeni bir masal bulunamadı.</p>
          <button type="button" data-reset-filters>Tümünü göster</button>
        </div>
      </section>

      <AdSlot slot={homeFeedAdSlot} placement="home-after-latest" />

      <section
        class="continue-section"
        aria-labelledby="continue-title"
        data-smart-story-section
        data-mode="calm"
      >
        <div class="section-heading">
          <div>
            <p class="section-kicker" data-smart-story-kicker>
              <i class="ph ph-leaf" aria-hidden="true"></i>
              <span data-smart-story-kicker-label>Bu akşam için</span>
            </p>
            <h2 id="continue-title" data-smart-story-title>Bu akşamın sakin seçkisi</h2>
          </div>
          <a class="section-link" href="/masallar/kategori/uyku/" data-smart-story-link>
            <span data-smart-story-link-label>Tüm uyku masalları</span>
            <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <div class="evening-list" data-continue-grid>
          {eveningStories.map((story, index) => (
            <a
              class="evening-card"
              href={`/masallar/${story.id}/`}
              data-continue-story={story.id}
              data-fallback-index={index}
            >
              <img
                src={story.data.coverImage}
                alt={story.data.altText ?? `${story.data.title} masal kapağı`}
                width="220"
                height="160"
                loading="lazy"
              />
              <div class="evening-copy">
                <span>{moodForStory(story) === 'sakin' ? 'Sakin seçim' : 'MasalNova seçkisi'}</span>
                <h3>{story.data.title}</h3>
                <p>{story.data.ageGroups[0] ? ageLabel(story.data.ageGroups[0]) : 'Her yaş'} · {story.data.readingTime} dk</p>
                <div class="progress-track" aria-hidden="true"><span data-story-progress></span></div>
                <small data-progress-label>Masalı oku</small>
              </div>
              <span class="read-action">Masalı oku <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
            </a>
          ))}

          {continueStories.map((story, index) => (
            <a
              class="evening-card"
              href={`/masallar/${story.id}/`}
              data-continue-story={story.id}
              data-fallback-index={index + 3}
              data-recent-candidate
              hidden
            >
              <img
                src={story.data.coverImage}
                alt={story.data.altText ?? `${story.data.title} masal kapağı`}
                width="220"
                height="160"
                loading="lazy"
              />
              <div class="evening-copy">
                <span>Senin masalın</span>
                <h3>{story.data.title}</h3>
                <p>{story.data.ageGroups[0] ? ageLabel(story.data.ageGroups[0]) : 'Her yaş'} · {story.data.readingTime} dk</p>
                <div class="progress-track" aria-hidden="true"><span data-story-progress></span></div>
                <small data-progress-label>Okumaya devam et</small>
              </div>
              <span class="read-action">Devam et <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
            </a>
          ))}
        </div>
      </section>

      <section class="category-section" aria-labelledby="category-title">
        <div class="section-heading">
          <div>
            <p class="section-kicker"><i class="ph ph-compass" aria-hidden="true"></i> Keşfet</p>
            <h2 id="category-title">Birlikte seçin</h2>
          </div>
          <a class="section-link" href="/masallar/">
            Tüm kategoriler <i class="ph ph-arrow-right" aria-hidden="true"></i>
          </a>
        </div>

        <div class="category-grid">
          {categoryLinks.map((category) => (
            <a href={category.href} class="category-card">
              <span class="category-icon"><i class={`ph ph-${category.icon}`} aria-hidden="true"></i></span>
              <div>
                <h3>{category.label}</h3>
                <p>{category.description}</p>
              </div>
              <span class="category-count">{category.count} masal <i class="ph ph-arrow-right" aria-hidden="true"></i></span>
            </a>
          ))}
        </div>
      </section>

      <AdSlot slot={homeContentAdSlot} placement="home-before-guide" />

      <section class="home-guide" aria-labelledby="guide-title">
        <div class="guide-copy">
          <p class="section-kicker"><i class="ph ph-book-open-text" aria-hidden="true"></i> Ebeveynler için</p>
          <h2 id="guide-title">Doğru masalı kolayca bulun</h2>
          <p>
            MasalNova; özgün Türkçe uyku masallarını, eğitici çocuk hikâyelerini ve uzun masalları sakin bir okuma deneyiminde buluşturur. Kartlardaki yaş ve süre bilgileri, o akşam için uygun hikâyeyi hızlıca seçmenize yardımcı olur.
          </p>
        </div>

        <div class="faq-list">
          {faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>{faq.question}<i class="ph ph-plus" aria-hidden="true"></i></summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>

      <section class="settings-section" id="ayarlar" aria-labelledby="settings-title">
        <div>
          <p class="section-kicker"><i class="ph ph-shield-check" aria-hidden="true"></i> Gizlilik</p>
          <h2 id="settings-title">Basit, özel ve hesapsız.</h2>
          <p>Favoriler ve okuma ilerlemesi yalnızca bu cihazda tutulur.</p>
        </div>
        <div class="settings-actions">
          <button type="button" data-open-cookie-settings>
            <i class="ph ph-cookie" aria-hidden="true"></i> Çerez tercihleri
          </button>
          <button type="button" data-clear-app-state>
            <i class="ph ph-trash" aria-hidden="true"></i> Yerel verileri temizle
          </button>
          <p data-settings-status role="status" aria-live="polite"></p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  import {
    APP_STATE_CHANGE_EVENT,
    APP_STATE_VERSION,
    loadState,
    saveState,
    setPreferences,
    toggleFavorite,
    type AppState,
  } from '../lib/app-state';

  const carousel = document.querySelector<HTMLElement>('[data-latest-carousel]');
  const carouselCards = [...document.querySelectorAll<HTMLElement>('[data-latest-card]')];
  const autoplayButton = document.querySelector<HTMLButtonElement>('[data-carousel-autoplay]');
  const autoplayLabel = document.querySelector<HTMLElement>('[data-autoplay-label]');
  const progressBar = document.querySelector<HTMLElement>('[data-carousel-progress]');
  const filterStatus = document.querySelector<HTMLElement>('[data-filter-status]');
  const noResults = document.querySelector<HTMLElement>('[data-no-filter-results]');
  const preferenceInputs = [...document.querySelectorAll<HTMLSelectElement>('[data-story-preference]')];

  let autoplayTimer: number | undefined;
  let manuallyPaused = false;

  const visibleCards = () => carouselCards.filter((card) => !card.hidden);
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function cardScrollLeft(card: HTMLElement) {
    if (!carousel) return 0;
    return Math.max(0, card.offsetLeft - carousel.offsetLeft);
  }

  function activeCardIndex(cards = visibleCards()) {
    if (!carousel || !cards.length) return 0;
    const current = carousel.scrollLeft + 12;
    let nearest = 0;
    let distance = Number.POSITIVE_INFINITY;
    cards.forEach((card, index) => {
      const nextDistance = Math.abs(cardScrollLeft(card) - current);
      if (nextDistance < distance) {
        distance = nextDistance;
        nearest = index;
      }
    });
    return nearest;
  }

  function updateCarouselProgress() {
    const cards = visibleCards();
    const index = activeCardIndex(cards);
    const percentage = cards.length ? ((index + 1) / cards.length) * 100 : 0;
    progressBar?.style.setProperty('width', `${percentage}%`);
  }

  function moveCarousel(direction: 1 | -1) {
    if (!carousel) return;
    const cards = visibleCards();
    if (!cards.length) return;
    const current = activeCardIndex(cards);
    const next = (current + direction + cards.length) % cards.length;
    carousel.scrollTo({
      left: cardScrollLeft(cards[next]),
      behavior: reducedMotion.matches ? 'auto' : 'smooth',
    });
    window.setTimeout(updateCarouselProgress, reducedMotion.matches ? 0 : 380);
  }

  function setAutoplayUi() {
    if (!autoplayButton || !autoplayLabel) return;
    const paused = manuallyPaused || reducedMotion.matches;
    autoplayButton.setAttribute('aria-pressed', String(paused));
    autoplayButton.setAttribute('aria-label', paused ? 'Otomatik geçişi başlat' : 'Otomatik geçişi duraklat');
    autoplayButton.classList.toggle('is-paused', paused);
    autoplayLabel.textContent = reducedMotion.matches ? 'Hareket kapalı' : paused ? 'Duraklatıldı' : 'Otomatik';
    const icon = autoplayButton.querySelector('i');
    if (icon) icon.className = paused ? 'ph ph-play' : 'ph ph-pause';
  }

  function stopAutoplay() {
    window.clearInterval(autoplayTimer);
    autoplayTimer = undefined;
  }

  function startAutoplay() {
    stopAutoplay();
    if (manuallyPaused || reducedMotion.matches || visibleCards().length < 2) {
      setAutoplayUi();
      return;
    }
    autoplayTimer = window.setInterval(() => moveCarousel(1), 4600);
    setAutoplayUi();
  }

  document.querySelector('[data-carousel-next]')?.addEventListener('click', () => {
    moveCarousel(1);
    startAutoplay();
  });
  document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => {
    moveCarousel(-1);
    startAutoplay();
  });

  carousel?.addEventListener('keydown', (event) => {
    if (event.key === 'ArrowRight') {
      event.preventDefault();
      moveCarousel(1);
    }
    if (event.key === 'ArrowLeft') {
      event.preventDefault();
      moveCarousel(-1);
    }
  });
  carousel?.addEventListener('scroll', updateCarouselProgress, { passive: true });
  carousel?.addEventListener('mouseenter', stopAutoplay);
  carousel?.addEventListener('mouseleave', startAutoplay);
  carousel?.addEventListener('focusin', stopAutoplay);
  carousel?.addEventListener('focusout', startAutoplay);
  carousel?.addEventListener('pointerdown', stopAutoplay, { passive: true });
  carousel?.addEventListener('pointerup', () => window.setTimeout(startAutoplay, 1200), { passive: true });

  autoplayButton?.addEventListener('click', () => {
    manuallyPaused = !manuallyPaused;
    manuallyPaused ? stopAutoplay() : startAutoplay();
    setAutoplayUi();
  });

  reducedMotion.addEventListener('change', startAutoplay);

  function valuesForPreferences() {
    return Object.fromEntries(preferenceInputs.map((input) => [input.dataset.storyPreference, input.value]));
  }

  function applyFilters() {
    const values = valuesForPreferences();
    let matches = 0;
    carouselCards.forEach((card) => {
      const ageMatches = !values.age || (card.dataset.age ?? '').split(' ').includes(values.age);
      const durationMatches = !values.duration || card.dataset.duration === values.duration;
      const moodMatches = !values.mood || card.dataset.mood === values.mood;
      const match = ageMatches && durationMatches && moodMatches;
      card.hidden = !match;
      if (match) matches += 1;
    });
    if (carousel) carousel.scrollLeft = 0;
    if (noResults) noResults.hidden = matches > 0;
    if (filterStatus) filterStatus.textContent = matches
      ? `Seçimine uygun ${matches} yeni masal gösteriliyor.`
      : 'Seçimine uygun yeni masal bulunamadı.';
    updateCarouselProgress();
    startAutoplay();
  }

  function saveCurrentPreferences() {
    const values = valuesForPreferences();
    setPreferences({
      age: values.age || null,
      duration: values.duration || null,
      mood: values.mood || null,
    });
  }

  preferenceInputs.forEach((input) => {
    input.addEventListener('change', () => {
      saveCurrentPreferences();
      applyFilters();
    });
  });

  document.querySelector('[data-reset-filters]')?.addEventListener('click', () => {
    preferenceInputs.forEach((input) => { input.value = ''; });
    saveCurrentPreferences();
    applyFilters();
  });

  function applyPreferencesFromState(state: AppState) {
    preferenceInputs.forEach((input) => {
      const key = input.dataset.storyPreference as 'age' | 'duration' | 'mood';
      input.value = state.preferences[key] ?? '';
    });
  }

  function renderLocalState(state: AppState) {
    document.querySelectorAll<HTMLButtonElement>('[data-favorite-story]').forEach((button) => {
      const storyId = button.dataset.favoriteStory ?? '';
      const storyTitle = button.dataset.favoriteTitle ?? 'Masal';
      const favorite = state.favorites.includes(storyId);
      button.setAttribute('aria-pressed', String(favorite));
      button.setAttribute('aria-label', favorite
        ? `${storyTitle} masalını favorilerden çıkar`
        : `${storyTitle} masalını favorilere ekle`);
      button.classList.toggle('is-favorite', favorite);
      const icon = button.querySelector('i');
      if (icon) icon.className = favorite ? 'ph-fill ph-heart' : 'ph ph-heart';
    });

    const continueCards = [...document.querySelectorAll<HTMLElement>('[data-continue-story]')];
    const candidates = continueCards.filter((card) => card.hasAttribute('data-recent-candidate'));
    const availableIds = new Set(candidates.map((card) => card.dataset.continueStory ?? ''));
    const recentIds = state.recentStoryIds.filter((id) => availableIds.has(id)).slice(0, 3);
    const hasRecentStories = recentIds.length > 0;

    const smartSection = document.querySelector<HTMLElement>('[data-smart-story-section]');
    const smartIcon = document.querySelector<HTMLElement>('[data-smart-story-kicker] i');
    const smartLabel = document.querySelector<HTMLElement>('[data-smart-story-kicker-label]');
    const smartTitle = document.querySelector<HTMLElement>('[data-smart-story-title]');
    const smartLink = document.querySelector<HTMLAnchorElement>('[data-smart-story-link]');
    const smartLinkLabel = document.querySelector<HTMLElement>('[data-smart-story-link-label]');

    if (smartSection) smartSection.dataset.mode = hasRecentStories ? 'recent' : 'calm';
    if (smartIcon) smartIcon.className = hasRecentStories ? 'ph ph-bookmark-simple' : 'ph ph-leaf';
    if (smartLabel) smartLabel.textContent = hasRecentStories ? 'Senin alanın' : 'Bu akşam için';
    if (smartTitle) smartTitle.textContent = hasRecentStories ? 'Kaldığın yerden devam et' : 'Bu akşamın sakin seçkisi';
    if (smartLink) smartLink.href = hasRecentStories ? '/kitapligim/' : '/masallar/kategori/uyku/';
    if (smartLinkLabel) smartLinkLabel.textContent = hasRecentStories ? 'Kitaplığı aç' : 'Tüm uyku masalları';

    continueCards.forEach((card) => {
      const id = card.dataset.continueStory ?? '';
      const isCandidate = card.hasAttribute('data-recent-candidate');
      const visible = hasRecentStories ? isCandidate && recentIds.includes(id) : !isCandidate;
      card.hidden = !visible;
      card.style.order = String(hasRecentStories ? recentIds.indexOf(id) : Number(card.dataset.fallbackIndex ?? 0));
      const progress = state.progress[id] ?? 0;
      card.querySelector<HTMLElement>('[data-story-progress]')?.style.setProperty('width', `${progress}%`);
      const label = card.querySelector<HTMLElement>('[data-progress-label]');
      if (label) label.textContent = hasRecentStories
        ? (progress > 0 ? `%${progress} tamamlandı` : 'Okumaya devam et')
        : 'Masalı oku';
    });
  }

  document.querySelectorAll<HTMLButtonElement>('[data-favorite-story]').forEach((button) => {
    button.addEventListener('click', () => {
      const storyId = button.dataset.favoriteStory;
      if (storyId) renderLocalState(toggleFavorite(storyId));
    });
  });

  document.querySelector('[data-clear-app-state]')?.addEventListener('click', () => {
    const cleared = saveState({
      version: APP_STATE_VERSION,
      favorites: [],
      recentStoryIds: [],
      progress: {},
      preferences: { age: null, duration: null, mood: null },
    });
    preferenceInputs.forEach((input) => { input.value = ''; });
    renderLocalState(cleared);
    applyFilters();
    const status = document.querySelector<HTMLElement>('[data-settings-status]');
    if (status) status.textContent = 'Favoriler ve okuma ilerlemesi bu cihazdan temizlendi.';
  });

  document.querySelector('[data-open-cookie-settings]')?.addEventListener('click', () => {
    document.querySelector<HTMLButtonElement>('#stcm-icon')?.click();
  });

  window.addEventListener(APP_STATE_CHANGE_EVENT, (event) => {
    const detail = (event as CustomEvent<{ state: AppState }>).detail;
    if (detail?.state) renderLocalState(detail.state);
  });

  const dateTarget = document.querySelector<HTMLElement>('[data-today-date]');
  if (dateTarget) {
    dateTarget.textContent = new Intl.DateTimeFormat('tr-TR', {
      day: 'numeric',
      month: 'long',
      timeZone: 'Europe/Istanbul',
    }).format(new Date());
  }

  const initialState = loadState();
  applyPreferencesFromState(initialState);
  renderLocalState(initialState);
  applyFilters();
  updateCarouselProgress();
  startAutoplay();
</script>

