---
import ColoringFocusLayout from '../../../layouts/ColoringFocusLayout.astro';
import AdSlot from '../../../components/AdSlot.astro';
import DigitalColoringCanvas from '../../../components/DigitalColoringCanvas.astro';
import { coloringPages } from '../../../data/coloring-pages.mjs';

export function getStaticPaths() {
  return coloringPages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const detailPath = `/boyama/${page.slug}/`;
const focusAdSlot = import.meta.env.PUBLIC_ADSENSE_BOYAMA_FOCUS_TOP_SLOT;
const adsReady = import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true'
  && import.meta.env.PUBLIC_GOOGLE_CERTIFIED_CMP === 'true'
  && Boolean(focusAdSlot);
const showFocusAd = adsReady;
---

<ColoringFocusLayout
  title={`${page.title} – Dijital Boyama | MasalNova`}
  description={`${page.title} boyama sayfasını tarayıcıda ücretsiz boya. Çocuklar için sade ve kolay kullanım.`}
  canonicalPath={detailPath}
  image={page.previewImage}
  imageAlt={page.imageAlt}
  allowAds={true}
>
  <div class:list={['focus-shell', { 'has-top-ad': showFocusAd }]}>
    <header class="focus-header">
      <div class="focus-left">
        <a class="back-button" href={detailPath} aria-label={`${page.title} sayfasına dön`}>
          <i class="ph ph-arrow-left" aria-hidden="true"></i>
          <span>Geri</span>
        </a>
        <a class="focus-brand" href="/" aria-label="MasalNova ana sayfa">
          <img src="/logo.webp" alt="MasalNova" width="78" height="20" />
        </a>
      </div>
      <div class="focus-title">
        <span>Boyama zamanı</span>
        <strong>{page.title}</strong>
      </div>
      <div class="safe-badge" aria-label="Çocuk modu">
        <i class="ph ph-shield-check" aria-hidden="true"></i>
        <span>Çocuk modu</span>
      </div>
    </header>

    {
      showFocusAd && (
        <AdSlot
          slot={focusAdSlot}
          placement="boyama-focus-top"
          variant="focus-top"
        />
      )
    }

    <div class="focus-workspace">
      <DigitalColoringCanvas
        title={page.title}
        imageSrc={`/boyama/canvas/${page.slug}.png`}
        downloadName={page.slug}
        imageAlt={page.imageAlt}
        mode="focus"
      />
    </div>
  </div>
</ColoringFocusLayout>

<style>
  .focus-shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  .focus-shell.has-top-ad { grid-template-rows: auto auto minmax(0, 1fr); }

  .focus-header {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    min-height: 62px;
    padding: max(8px, env(safe-area-inset-top)) 12px 8px;
    border-bottom: 1px solid #dce5f7;
    background: rgba(255,255,255,.97);
    box-shadow: 0 5px 18px rgba(8,30,80,.08);
  }

  .back-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 54px;
    min-height: 44px;
    padding: 8px 10px;
    border: 1px solid #d8e2f5;
    border-radius: 14px;
    background: #f3f6fc;
    color: #173b8d;
    font-size: .73rem;
    font-weight: 900;
  }

  .back-button i { font-size: 1.15rem; }

  .focus-left {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .focus-brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 7px 6px;
    border-radius: 12px;
  }

  .focus-brand img { display: block; width: 78px; height: auto; }

  .focus-title {
    display: grid;
    min-width: 0;
    line-height: 1.12;
    text-align: center;
  }

  .focus-title span {
    color: #5270ae;
    font-size: .58rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .focus-title strong {
    overflow: hidden;
    color: #102a66;
    font-size: clamp(.82rem, 3.7vw, 1.05rem);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .safe-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-width: 44px;
    min-height: 44px;
    padding: 7px 9px;
    border-radius: 14px;
    background: #e3f9ef;
    color: #147451;
    font-size: .66rem;
    font-weight: 900;
    justify-self: end;
  }

  .safe-badge i { font-size: 1.1rem; }
  .focus-workspace { min-height: 0; overflow: hidden; }

  @media (max-width: 390px) {
    .back-button span,
    .safe-badge span { display: none; }
    .back-button,
    .safe-badge { min-width: 44px; padding-inline: 8px; }
    .focus-brand { padding-inline: 4px; }
    .focus-brand img { width: 62px; }
  }

  @media (max-width: 340px) {
    .focus-left { gap: 5px; }
    .focus-brand img { width: 50px; }
  }

  @media (min-width: 860px) {
    .focus-header { min-height: 70px; padding-inline: 22px; }
    .focus-title strong { font-size: 1.08rem; }
  }
</style>
