---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import ColoringPageCard from '../../components/ColoringPageCard.astro';
import { coloringPages } from '../../data/coloring-pages.mjs';

const boyamaIndexAdSlot = import.meta.env.PUBLIC_ADSENSE_BOYAMA_INDEX_SLOT;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://masalnova.com/boyama/#collection',
    name: 'Ücretsiz Keloğlan Boyama Sayfaları',
    description: 'Çocuklar için ücretsiz, yazdırılabilir Keloğlan boyama sayfaları.',
    url: 'https://masalnova.com/boyama/',
    inLanguage: 'tr-TR',
    isAccessibleForFree: true,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: coloringPages.length,
      itemListElement: coloringPages.map((page, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: page.title,
        url: `https://masalnova.com/boyama/${page.slug}/`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
      { '@type': 'ListItem', position: 2, name: 'Boyama Sayfaları', item: 'https://masalnova.com/boyama/' },
    ],
  },
];
---

<BaseLayout
  title="Ücretsiz Keloğlan Boyama Sayfaları | MasalNova"
  description={`${coloringPages.length} ücretsiz Keloğlan boyama sayfasını keşfet, A4 olarak indir veya hemen yazdır. 4–7 yaş çocuklar için sade ve eğlenceli çizimler.`}
  path="/boyama/"
  image={coloringPages[0]?.previewImage}
  imageAlt={coloringPages[0]?.imageAlt}
  activeNav="boyama"
  jsonLd={jsonLd}
>
  <section class="coloring-hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow"><i class="ph ph-paint-brush-broad" aria-hidden="true"></i> Yeni · Ücretsiz</span>
        <h1>Keloğlan’la boya, hayal et</h1>
        <p>MasalNova’ya özel {coloringPages.length} Keloğlan boyama sayfasını ücretsiz indir veya A4 olarak yazdır. Büyük alanlar ve temiz çizgiler, küçük eller için hazırlandı.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="#boyamalar"><i class="ph ph-images" aria-hidden="true"></i> Boyamaları gör</a>
          <a class="btn btn-ghost" href="/masallar/kategori/keloglan/"><i class="ph ph-book-open-text" aria-hidden="true"></i> Keloğlan masalları</a>
        </div>
      </div>
      <aside class="print-note">
        <i class="ph ph-printer" aria-hidden="true"></i>
        <div>
          <strong>Yazdırmaya hazır</strong>
          <p>Her sayfa A4 ölçüsünde, siyah-beyaz ve yazıcı dostu olarak hazırlanmıştır.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="coloring-section" id="boyamalar" aria-labelledby="coloring-title">
    <div class="container">
      <div class="section-title">
        <div>
          <span>İlk koleksiyon</span>
          <h2 id="coloring-title">{coloringPages.length} Keloğlan boyama sayfası</h2>
        </div>
        <p>{coloringPages.length} sayfa · Ücretsiz · A4 baskı</p>
      </div>
      <div class="coloring-grid">
        {coloringPages.map((page) => <ColoringPageCard page={page} />)}
      </div>
      <div class="family-note">
        <i class="ph ph-heart" aria-hidden="true"></i>
        <p>İpucu: Bir boyama sayfası seçin, önce ilgili Keloğlan masalını okuyun, sonra çocuğunuzdan sahneyi kendi hayalindeki renklerle tamamlamasını isteyin.</p>
      </div>
      <div class="ad-area">
        <AdSlot slot={boyamaIndexAdSlot} placement="boyama-index-after-content" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .coloring-hero { padding: clamp(44px, 7vw, 78px) 0 35px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(280px, .65fr); gap: 34px; align-items: end; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px;
    border: 1px solid rgba(255,255,255,.3); border-radius: 999px;
    background: rgba(255,255,255,.13); color: #fff; font-size: .8rem; font-weight: 900;
  }
  h1 { max-width: 820px; margin-top: 16px; color: #fff; font-size: clamp(2.45rem, 7vw, 5.25rem); letter-spacing: -.055em; }
  .hero-grid > div > p { max-width: 700px; margin-top: 16px; color: rgba(255,255,255,.86); font-size: clamp(1rem, 2vw, 1.22rem); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 25px; }
  .print-note, .family-note {
    display: flex; gap: 14px; padding: 19px; border: 1px solid rgba(255,255,255,.24);
    border-radius: 22px; background: rgba(4,31,106,.43); color: #fff; backdrop-filter: blur(12px);
  }
  .print-note > i, .family-note > i { flex: 0 0 auto; color: #ffd44d; font-size: 1.75rem; }
  .print-note strong { font-size: .97rem; }
  .print-note p { margin-top: 4px; color: rgba(255,255,255,.76); font-size: .84rem; line-height: 1.48; }
  .coloring-section { padding: 24px 0 60px; scroll-margin-top: 90px; }
  .section-title { display: flex; align-items: end; justify-content: space-between; gap: 22px; margin-bottom: 20px; color: #fff; }
  .section-title span { color: #ffd44d; font-size: .76rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .section-title h2 { margin-top: 3px; font-size: clamp(1.7rem, 4vw, 2.45rem); }
  .section-title > p { color: rgba(255,255,255,.74); font-size: .88rem; font-weight: 800; }
  .coloring-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .family-note { align-items: flex-start; margin-top: 25px; background: rgba(255,255,255,.1); font-size: .88rem; }
  .family-note p { color: rgba(255,255,255,.82); }
  .ad-area { max-width: 860px; margin: 0 auto; }
  @media (min-width: 721px) {
    .coloring-hero,
    .coloring-section { background: #fbf8f1; color: #102a66; }
    .coloring-hero { padding: 38px 0 22px; }
    .coloring-section { padding: 18px 0 68px; }
    .coloring-hero .container,
    .coloring-section .container { max-width: 1260px; }
    .eyebrow { border-color: #e5d9b5; background: #fff7dc; color: #8b6307; }
    h1 { margin-top: 10px; color: #0b2b75; font-size: clamp(2.2rem, 4.2vw, 3.6rem); }
    .hero-grid > div > p { margin-top: 11px; color: #667188; font-size: 1rem; }
    .hero-actions .btn-ghost { border-color: #d8d2c5; background: #fff; color: #1749ae; }
    .print-note,
    .family-note {
      border-color: #ded9ce;
      background: #fff;
      color: #173574;
      box-shadow: 0 12px 30px rgba(23,43,92,.08);
      backdrop-filter: none;
    }
    .print-note > i,
    .family-note > i { color: #1749ae; }
    .print-note p,
    .family-note p { color: #69748a; }
    .section-title { color: #0b2b75; }
    .section-title span { color: #a87906; }
    .section-title > p { color: #6c7690; }
    .coloring-grid { gap: 16px; }
  }
  @media (max-width: 920px) {
    .hero-grid { grid-template-columns: 1fr; }
    .print-note { max-width: 620px; }
    .coloring-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .coloring-hero { padding-top: 34px; }
    .hero-actions .btn { width: 100%; }
    .section-title { align-items: flex-start; flex-direction: column; gap: 7px; }
    .coloring-grid { grid-template-columns: 1fr; }
  }
</style>
