  /* Cinematic presentation layer */
  :root {
    --midnight: #061632;
    --deep-blue: #0a2b5d;
    --royal-blue: #154f9f;
    --film-gold: #f6c953;
    --film-gold-soft: #ffe9a3;
    --paper: #fff7df;
    --glass: rgba(5, 23, 54, .78);
    --glass-strong: rgba(4, 19, 46, .92);
    --hairline: rgba(255, 237, 174, .32);
    --soft-white: rgba(255, 255, 255, .74);
  }

  html, body { background: var(--midnight); }
  body { font-feature-settings: 'kern' 1, 'tnum' 1; }
  :focus-visible { outline: 2px solid var(--film-gold-soft); outline-offset: 4px; }

  .game {
    background: #173f71;
    color: #fff;
  }
  .game::before,
  .game::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .game::before {
    z-index: 3;
    background:
      linear-gradient(180deg, rgba(2, 10, 27, .78) 0, rgba(2, 10, 27, .13) 11%, transparent 23%, transparent 76%, rgba(2, 10, 27, .18) 90%, rgba(2, 10, 27, .78) 100%),
      radial-gradient(ellipse at 50% 47%, transparent 46%, rgba(1, 8, 24, .28) 77%, rgba(1, 8, 24, .62) 112%);
    box-shadow: inset 0 0 140px rgba(2, 9, 25, .25);
  }
  .game::after {
    z-index: 4;
    opacity: .045;
    background-image:
      repeating-radial-gradient(circle at 18% 32%, rgba(255,255,255,.48) 0 .55px, transparent .6px 3px),
      repeating-linear-gradient(92deg, transparent 0 3px, rgba(255,255,255,.15) 4px, transparent 5px 8px);
    background-size: 7px 7px, 11px 9px;
    mix-blend-mode: soft-light;
    animation: film-grain .55s steps(2, end) infinite;
  }
  .game[data-game-state='menu']::before {
    background:
      linear-gradient(180deg, rgba(2, 10, 27, .86) 0, rgba(2, 10, 27, .08) 12%, transparent 78%, rgba(2, 10, 27, .82) 100%),
      radial-gradient(ellipse at 68% 48%, transparent 28%, rgba(1, 8, 24, .22) 70%, rgba(1, 8, 24, .58) 110%);
  }
  .world-wash {
    background:
      linear-gradient(180deg, rgba(255, 243, 201, .08), transparent 34%),
      linear-gradient(0deg, rgba(3, 15, 39, .2), transparent 34%);
  }
  .world-wash::after { box-shadow: inset 0 0 180px rgba(2, 12, 34, .2); }
  .speed-lines { opacity: 0; mix-blend-mode: screen; }
  .game.is-boosting .speed-lines { opacity: .34; }

  .hud {
    grid-template-columns: minmax(132px, 184px) minmax(330px, 610px) minmax(186px, auto);
    gap: 16px;
    padding: max(22px, env(safe-area-inset-top)) max(24px, env(safe-area-inset-right)) 0 max(24px, env(safe-area-inset-left));
  }
  .hud-card,
  .journey-card,
  .icon-button,
  .hearts {
    border: 1px solid rgba(255, 242, 196, .31);
    background: linear-gradient(145deg, rgba(7, 31, 69, .88), rgba(4, 21, 51, .74));
    box-shadow: 0 14px 40px rgba(0, 10, 32, .25), inset 0 1px rgba(255, 255, 255, .09);
    backdrop-filter: blur(16px) saturate(1.18);
  }
  .score-card {
    min-height: 72px;
    padding: 11px 17px 10px 20px;
    border-radius: 4px 16px 16px 4px;
    border-left: 3px solid var(--film-gold);
  }
  .hud-kicker {
    color: var(--film-gold-soft);
    font-size: .55rem;
    letter-spacing: .19em;
  }
  .score-card strong {
    margin-top: 2px;
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    letter-spacing: -.035em;
  }
  .combo {
    right: 8px;
    bottom: -11px;
    border: 1px solid rgba(255, 245, 198, .58);
    background: var(--film-gold);
    box-shadow: 0 7px 18px rgba(1, 11, 31, .32);
    transform: none;
    letter-spacing: .05em;
  }
  .mission-callout {
    position: absolute;
    top: max(104px, calc(env(safe-area-inset-top) + 88px));
    left: max(24px, env(safe-area-inset-left));
    display: grid;
    width: min(220px, 22vw);
    gap: 2px;
    padding: 11px 14px 11px 17px;
    border-left: 2px solid rgba(246, 201, 83, .78);
    background: linear-gradient(90deg, rgba(3, 17, 42, .7), transparent);
    color: #fff;
    text-shadow: 0 2px 14px rgba(0, 8, 28, .65);
  }
  .mission-callout span,
  .mission-callout small {
    font-size: .5rem;
    font-weight: 900;
    letter-spacing: .17em;
  }
  .mission-callout span { color: var(--film-gold); }
  .mission-callout strong { font-size: .76rem; line-height: 1.18; }
  .mission-callout small { color: rgba(255,255,255,.5); letter-spacing: .08em; }

  .journey-card {
    max-width: 610px;
    padding: 10px 16px 9px;
    border-radius: 15px 15px 5px 5px;
    border-top: 2px solid rgba(246, 201, 83, .74);
  }
  .journey-copy { align-items: end; margin-bottom: 7px; }
  .journey-copy > div { display: grid; gap: 1px; min-width: 0; }
  .journey-copy > div > span {
    color: rgba(255,255,255,.48);
    font-size: .46rem;
    font-weight: 900;
    letter-spacing: .18em;
  }
  .journey-copy > div > strong {
    overflow: hidden;
    color: var(--paper);
