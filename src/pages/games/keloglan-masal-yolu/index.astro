---
import '@fontsource/nunito/500.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '@fontsource/nunito/900.css';
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#112d62" />
    <meta name="color-scheme" content="only light" />
    <meta name="robots" content="noindex, follow" />
    <title>Keloğlan & Karakaçan: Masal Yolu 3D | MasalNova</title>
  </head>
  <body>
    <main class="game" data-game-state="loading" data-game-root>
      <canvas
        class="game-canvas"
        data-game-canvas
        tabindex="0"
        aria-label="Keloğlan ve eşeği Karakaçan ile üç boyutlu Masal Yolu oyunu"
      ></canvas>

      <div class="world-wash" aria-hidden="true"></div>
      <div class="speed-lines" data-speed-lines aria-hidden="true"></div>

      <section class="hud" data-hud hidden aria-label="Oyun bilgileri">
        <div class="hud-card score-card">
          <span class="hud-kicker">YOLCULUK PUANI</span>
          <strong data-score>0</strong>
          <span class="combo" data-combo hidden>Seri ×2</span>
        </div>

        <aside class="mission-callout" aria-label="Ana görev">
          <span>ANA GÖREV</span>
          <strong>Üç masal mührünü uyandır</strong>
          <small>Yıldız Çayırı’na ulaş</small>
        </aside>

        <div class="journey-card">
          <div class="journey-copy">
            <div>
              <span>ŞİMDİKİ BÖLÜM</span>
              <strong data-biome-name>Gündoğumu Köyü</strong>
            </div>
            <div class="distance-copy">
              <span>YOLCULUK</span>
              <strong data-distance>0 m</strong>
            </div>
          </div>
          <div class="journey-track" aria-hidden="true">
            <i data-journey-progress></i>
            <span class="gate gate-one"></span>
            <span class="gate gate-two"></span>
            <span class="gate gate-three"></span>
          </div>
          <div class="relics" aria-label="Bulunan masal mühürleri">
            <span data-relic="0" title="Köy mührü"><i>I</i><small>KÖY</small></span>
            <span data-relic="1" title="Orman mührü"><i>II</i><small>ORMAN</small></span>
            <span data-relic="2" title="Vadi mührü"><i>III</i><small>VADİ</small></span>
          </div>
        </div>

        <div class="hud-actions">
          <div class="hearts" data-hearts aria-label="Üç can">♥ ♥ ♥</div>
          <button class="icon-button" type="button" data-sound-button aria-label="Sesi kapat" aria-pressed="false">♪</button>
          <button class="icon-button" type="button" data-pause-button aria-label="Oyunu duraklat">Ⅱ</button>
        </div>
      </section>

      <section class="power-meter" data-power-meter hidden aria-label="Masal ışığı gücü">
        <div class="power-orb">
          <svg viewBox="0 0 52 52" aria-hidden="true">
            <circle class="power-back" cx="26" cy="26" r="22"></circle>
            <circle class="power-fill" data-power-ring cx="26" cy="26" r="22"></circle>
          </svg>
          <span data-power-icon>✦</span>
        </div>
        <div>
          <strong data-power-title>MASAL IŞIĞI</strong>
          <small data-power-copy>Yıldızları topla</small>
        </div>
      </section>

      <div class="toast" data-toast hidden role="status" aria-live="polite"></div>
      <div class="tutorial" data-tutorial hidden aria-live="polite">
        <span data-tutorial-icon>↔</span>
        <strong data-tutorial-copy>Sağa ve sola yönel</strong>
      </div>

      <div class="touch-controls" data-touch-controls hidden aria-label="Dokunmatik oyun kontrolleri">
        <div class="touch-steer">
          <button type="button" data-control="left" aria-label="Sola git"><span aria-hidden="true">‹</span><small>SOL</small></button>
          <button type="button" data-control="right" aria-label="Sağa git"><span aria-hidden="true">›</span><small>SAĞ</small></button>
        </div>
        <div class="touch-actions">
          <button class="jump-button" type="button" data-control="jump" aria-label="Zıpla">
            <span>↑</span><small>ZIPLA</small>
          </button>
          <button class="boost-button" type="button" data-control="boost" aria-label="Masal ışığını kullan" disabled>
            <span>✦</span><small>IŞIK</small>
          </button>
        </div>
      </div>

      <section class="screen loading-screen" data-loading-screen aria-label="Oyun yükleniyor" aria-live="polite">
        <div class="loading-mark">
          <img src="/logo.webp" alt="MasalNova" width="600" height="153" />
        </div>
        <p class="loading-kicker">MASALNOVA ORIGINALS SUNAR</p>
        <strong>Masal yolu uyanıyor…</strong>
        <div class="loading-track"><i data-loading-progress></i></div>
        <small class="loading-note">Köyün ilk ışıkları hazırlanıyor</small>
      </section>

      <section class="screen menu-screen" data-menu-screen hidden aria-labelledby="game-title">
        <div class="scene-caption" aria-hidden="true">
          <span>BÖLÜM 01</span>
          <strong>MASAL YOLU</strong>
        </div>
        <div class="menu-panel">
          <div class="brand-pill">MASALNOVA <span>ORIGINALS</span></div>
          <p class="chapter-label">SİNEMATİK 3D MASAL MACERASI</p>
          <h1 id="game-title"><span>Keloğlan <i>&</i> Karakaçan</span><strong>Masal Yolu</strong></h1>
          <p class="story-copy">
            Üç masal mührü rüzgâra karıştı. Karakaçan’la değişen diyarlardan geç,
            ışıkları topla ve yıldız çayırını yeniden parlat.
          </p>

          <div class="menu-mission">
            <span>BU BÖLÜMDE</span>
            <strong>Dört diyarı aş. Üç mührü eve getir.</strong>
          </div>

          <div class="feature-row" aria-label="Oyun özellikleri">
            <span><b>4</b> dinamik diyar</span>
            <span><b>3D</b> gerçek zamanlı</span>
            <span><b>HER</b> yolculukta yeni engeller</span>
          </div>

          <div class="controls-card" aria-label="Klavye kontrolleri">
            <span class="controls-label">KLAVYE</span>
            <div><kbd>A</kbd><kbd>D</kbd><span>veya</span><kbd>←</kbd><kbd>→</kbd><small>Yönel</small></div>
            <div><kbd>Boşluk</kbd><small>Zıpla</small></div>
            <div><kbd>⇧</kbd><small>Işık galobu</small></div>
          </div>

          <button class="primary-button" type="button" data-start-button>
            <span><small>MACERAYI BAŞLAT</small>Masal yoluna çık</span><b aria-hidden="true">→</b>
          </button>

          <div class="menu-options">
            <button type="button" data-menu-sound aria-pressed="true"><span data-menu-sound-icon>♪</span><span data-menu-sound-label>Ses açık</span></button>
            <button type="button" data-calm-mode aria-pressed="false"><span data-calm-icon>◌</span><span data-calm-label>Sakin kamera</span></button>
          </div>
          <p class="best-copy" data-best-score>En iyi yolculuk · 0 puan</p>
          <p class="menu-footnote">TEK OYUNCULU · REKLAMSIZ · İLERLEME BU CİHAZDA SAKLANIR</p>
        </div>
      </section>

      <section class="screen pause-screen" data-pause-screen hidden role="dialog" aria-modal="true" aria-labelledby="pause-title">
        <div class="small-panel">
          <div class="panel-rule" aria-hidden="true"><span></span><b>ARA</b><span></span></div>
          <p class="chapter-label">KARAKAÇAN SOLUKLANIYOR</p>
          <h2 id="pause-title">Yolculuk bekliyor.</h2>
          <p>Masal burada dondu. Hazır olduğunda aynı adımdan devam edebilirsin.</p>
          <span class="pause-note">İLERLEMEN KORUNUYOR</span>
          <button class="primary-button" type="button" data-resume-button><span><small>MASALA DÖN</small>Devam et</span><b aria-hidden="true">→</b></button>
          <button class="text-button" type="button" data-menu-button>Başa dön</button>
        </div>
      </section>

      <section class="screen result-screen" data-result-screen hidden role="dialog" aria-modal="true" aria-labelledby="result-title">
        <div class="small-panel result-panel">
          <div class="result-rays" aria-hidden="true"></div>
          <span class="panel-icon" data-result-icon aria-hidden="true">✦</span>
          <p class="chapter-label" data-result-kicker>YILDIZ ÇAYIRI PARLADI</p>
          <h2 id="result-title" data-result-title>Masal tamamlandı!</h2>
          <p data-result-message>Keloğlan ve Karakaçan üç mührü de yerine ulaştırdı.</p>
          <div class="result-stats">
            <div><strong data-result-score>0</strong><span>MASAL PUANI</span></div>
            <div><strong data-result-distance>0 m</strong><span>YOLCULUK</span></div>
          </div>
          <div class="result-stars" data-result-stars aria-label="Üç yıldız">★ ★ ★</div>
          <p class="result-caption">HER YOLCULUK YENİ BİR MASAL YAZAR</p>
          <button class="primary-button" type="button" data-restart-button><span><small>YENİ BİR YOLCULUK</small>Yeniden yola çık</span><b aria-hidden="true">↻</b></button>
          <button class="text-button" type="button" data-result-menu-button>Ana menü</button>
        </div>
      </section>

      <section class="screen fallback-screen" data-fallback-screen hidden aria-labelledby="fallback-title">
        <div class="fallback-card">
          <img src="/games/keloglan-masal-yolu/cover.webp" alt="Keloğlan ve Karakaçan masal yolunda" />
          <div>
            <p class="chapter-label">BU CİHAZDA 3D AÇILAMADI</p>
            <h2 id="fallback-title">Başka bir masal seni bekliyor</h2>
            <p>Tarayıcında WebGL kapalı olabilir. Keloğlan’ın 2D yıldız macerasını oynayabilirsin.</p>
            <a class="primary-button" href="/games/keloglan-yildiz-pesinde/index.html"><span>2D oyunu aç</span><b>→</b></a>
          </div>
        </div>
      </section>

      <p class="rotate-hint" data-rotate-hint hidden>Yatay görünümde masal yolunu daha geniş görebilirsin.</p>
      <div class="sr-only" data-live-region aria-live="polite"></div>
    </main>

    <script>
      import '../../../scripts/keloglan-masal-yolu';
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: light;
    font-family: 'Nunito', 'Avenir Next', system-ui, sans-serif;
    --navy: #0c2554;
    --blue: #174dad;
    --gold: #ffd34f;
    --cream: #fff8e8;
    --ink: #102b5d;
  }

  * { box-sizing: border-box; }
  html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #0b2145; }
  body { overscroll-behavior: none; -webkit-tap-highlight-color: transparent; }
  button, a { font: inherit; }
  button { border: 0; cursor: pointer; }
  button:disabled { cursor: default; }
  [hidden] { display: none !important; }
  :focus-visible { outline: 3px solid #fff; outline-offset: 3px; }

  .game { position: relative; width: 100%; height: 100%; min-height: 100dvh; overflow: hidden; isolation: isolate; background: #7cc8e6; user-select: none; touch-action: none; }
  .game-canvas { position: absolute; inset: 0; z-index: 0; display: block; width: 100%; height: 100%; outline: none; }
  .world-wash { position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(180deg, rgba(255,255,255,.05), transparent 38%, rgba(4,20,52,.18)); }
  .world-wash::after { content: ''; position: absolute; inset: 0; box-shadow: inset 0 0 110px rgba(4,18,52,.2); }
  .speed-lines { position: absolute; inset: 0; z-index: 2; opacity: 0; pointer-events: none; background: repeating-conic-gradient(from 90deg at 50% 62%, rgba(255,255,255,.22) 0 .18deg, transparent .18deg 7deg); mask-image: radial-gradient(circle at 50% 58%, transparent 0 18%, #000 60%); transition: opacity .25s ease; }
  .game.is-boosting .speed-lines { opacity: .55; animation: speed-pulse .4s linear infinite; }

  .hud { position: absolute; inset: 0 0 auto; z-index: 8; display: grid; grid-template-columns: minmax(116px, 180px) minmax(280px, 540px) minmax(180px, auto); align-items: start; gap: 14px; padding: max(14px, env(safe-area-inset-top)) max(16px, env(safe-area-inset-right)) 0 max(16px, env(safe-area-inset-left)); pointer-events: none; }
  .hud-card, .journey-card, .icon-button, .hearts { border: 1px solid rgba(255,255,255,.65); background: rgba(10,35,80,.78); color: #fff; box-shadow: 0 10px 28px rgba(0,17,55,.23); backdrop-filter: blur(12px); }
  .score-card { position: relative; display: grid; min-height: 62px; align-content: center; padding: 9px 15px; border-radius: 17px; }
  .hud-kicker { color: #ffe99b; font-size: .58rem; font-weight: 900; letter-spacing: .12em; }
  .score-card strong { font-size: clamp(1.4rem, 3vw, 2rem); line-height: 1; font-variant-numeric: tabular-nums; }
  .combo { position: absolute; right: -8px; bottom: -12px; padding: 4px 8px; border-radius: 999px; background: #ffcb3e; color: #5b3700; font-size: .65rem; font-weight: 900; transform: rotate(-3deg); }

  .journey-card { justify-self: center; width: 100%; max-width: 540px; padding: 9px 14px 8px; border-radius: 18px; }
  .journey-copy { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 5px; font-size: .72rem; font-weight: 900; }
  .journey-copy span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #ffe895; }
  .journey-copy strong { flex: 0 0 auto; font-variant-numeric: tabular-nums; }
  .journey-track { position: relative; overflow: visible; height: 6px; border-radius: 999px; background: rgba(255,255,255,.2); }
  .journey-track i { display: block; width: 0; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #ffce39, #fff4a8); box-shadow: 0 0 11px #ffd95c; transition: width .25s linear; }
  .journey-track .gate { position: absolute; top: 50%; width: 8px; height: 8px; border: 2px solid #ffe899; border-radius: 50%; background: #15376c; transform: translate(-50%, -50%); }
  .gate-one { left: 24%; } .gate-two { left: 51%; } .gate-three { left: 78%; }
  .relics { display: flex; justify-content: center; gap: 18px; margin-top: 5px; color: rgba(255,255,255,.28); font-size: .62rem; }
  .relics span { transition: color .25s ease, transform .25s ease, text-shadow .25s ease; }
  .relics span.is-found { color: #ffe067; text-shadow: 0 0 10px #ffd94a; transform: scale(1.2) rotate(45deg); }

  .hud-actions { display: flex; justify-content: flex-end; gap: 8px; pointer-events: auto; }
  .hearts { display: flex; min-height: 46px; align-items: center; padding: 0 13px; border-radius: 15px; color: #ff7d70; font-size: 1.05rem; letter-spacing: .1em; text-shadow: 0 2px 8px rgba(130,0,0,.35); }
  .icon-button { display: grid; width: 46px; height: 46px; place-items: center; border-radius: 15px; font-size: 1.1rem; }
  .icon-button:hover { background: rgba(22,65,134,.92); }

  .power-meter { position: absolute; z-index: 8; bottom: max(20px, env(safe-area-inset-bottom)); left: max(18px, env(safe-area-inset-left)); display: flex; align-items: center; gap: 9px; padding: 7px 13px 7px 7px; border: 1px solid rgba(255,255,255,.64); border-radius: 999px; background: rgba(10,35,80,.77); color: #fff; box-shadow: 0 10px 28px rgba(0,17,55,.23); backdrop-filter: blur(12px); }
  .power-orb { position: relative; width: 43px; height: 43px; }
  .power-orb svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .power-orb circle { fill: none; stroke-width: 5; }
  .power-back { stroke: rgba(255,255,255,.16); }
  .power-fill { stroke: #ffd23d; stroke-linecap: round; stroke-dasharray: 138.23; stroke-dashoffset: 138.23; filter: drop-shadow(0 0 4px #ffdd5d); transition: stroke-dashoffset .2s ease; }
  .power-orb > span { position: absolute; inset: 0; display: grid; place-items: center; color: #ffe36a; font-size: 1rem; }
  .power-meter > div:last-child { display: grid; }
  .power-meter strong { color: #ffe899; font-size: .62rem; letter-spacing: .08em; }
  .power-meter small { color: rgba(255,255,255,.78); font-size: .64rem; font-weight: 700; }
  .power-meter.is-ready { animation: ready-glow 1.15s ease-in-out infinite; }

  .toast { position: absolute; z-index: 11; top: 110px; left: 50%; padding: 8px 15px; border: 1px solid rgba(255,255,255,.7); border-radius: 999px; background: rgba(13,45,101,.9); color: #fff7cf; box-shadow: 0 12px 28px rgba(0,18,56,.24); font-size: .78rem; font-weight: 900; transform: translateX(-50%); animation: toast-in .3s ease both; }
  .tutorial { position: absolute; z-index: 10; top: 50%; left: 50%; display: flex; align-items: center; gap: 10px; padding: 10px 15px; border: 1px solid rgba(255,255,255,.72); border-radius: 16px; background: rgba(7,30,72,.78); color: #fff; box-shadow: 0 15px 40px rgba(0,14,50,.25); transform: translate(-50%, -50%); backdrop-filter: blur(10px); }
  .tutorial > span { display: grid; width: 37px; height: 37px; place-items: center; border-radius: 11px; background: #ffd346; color: #553400; font-size: 1.25rem; }
  .tutorial strong { font-size: .78rem; }

  .touch-controls { position: absolute; inset: auto 0 0; z-index: 9; display: flex; align-items: end; justify-content: space-between; padding: 0 max(16px, env(safe-area-inset-right)) max(17px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left)); pointer-events: none; }
  .touch-steer, .touch-actions { display: flex; gap: 9px; }
  .touch-controls button { display: grid; width: 62px; height: 62px; place-items: center; border: 1px solid rgba(255,255,255,.66); border-radius: 20px; background: rgba(9,35,81,.72); color: #fff; box-shadow: 0 10px 25px rgba(0,16,50,.24); font-size: 2rem; pointer-events: auto; backdrop-filter: blur(9px); touch-action: manipulation; }
  .touch-controls button:active { transform: scale(.94); background: rgba(23,76,160,.88); }
  .touch-controls .jump-button, .touch-controls .boost-button { align-content: center; gap: 0; }
  .touch-controls .jump-button { background: rgba(255,210,65,.88); color: #573600; }
  .touch-controls .boost-button { background: rgba(52,42,121,.78); color: #fff0a1; }
  .touch-controls .boost-button:disabled { opacity: .42; }
  .touch-controls .jump-button span, .touch-controls .boost-button span { font-size: 1.25rem; line-height: 1; }
  .touch-controls small { font-size: .52rem; font-weight: 900; letter-spacing: .05em; }

  .screen { position: absolute; inset: 0; z-index: 20; display: grid; overflow: auto; place-items: center; padding: max(22px, env(safe-area-inset-top)) max(18px, env(safe-area-inset-right)) max(22px, env(safe-area-inset-bottom)) max(18px, env(safe-area-inset-left)); background: linear-gradient(135deg, rgba(5,27,67,.92), rgba(11,47,91,.54)); color: #fff; }
  .loading-screen { z-index: 30; align-content: center; gap: 12px; background: radial-gradient(circle at 50% 45%, #225ca8, #0a2858 70%); }
  .loading-mark { display: grid; width: 76px; height: 76px; place-items: center; border: 1px solid rgba(255,238,157,.55); border-radius: 24px; background: rgba(255,255,255,.08); color: #ffdc55; font-size: 2rem; animation: loading-float 1.5s ease-in-out infinite; }
  .loading-screen strong { font-size: .85rem; letter-spacing: .04em; }
  .loading-track { overflow: hidden; width: min(240px, 70vw); height: 5px; border-radius: 99px; background: rgba(255,255,255,.16); }
  .loading-track i { display: block; width: 8%; height: 100%; border-radius: inherit; background: #ffd54c; transition: width .25s ease; }

  .menu-screen { justify-items: start; background: linear-gradient(90deg, rgba(4,25,63,.95) 0%, rgba(5,31,75,.78) 43%, rgba(5,31,75,.08) 78%), linear-gradient(0deg, rgba(5,22,53,.22), transparent); }
  .menu-panel { width: min(590px, 100%); margin-left: clamp(0px, 5vw, 74px); padding: 28px clamp(18px, 4vw, 40px); border: 1px solid rgba(255,237,165,.36); border-radius: 28px; background: rgba(7,30,70,.58); box-shadow: 0 28px 80px rgba(0,12,45,.27); backdrop-filter: blur(8px); }
  .brand-pill { display: inline-flex; align-items: center; gap: 7px; padding: 6px 10px; border: 1px solid rgba(255,226,113,.65); border-radius: 999px; color: #ffe47c; font-size: .62rem; font-weight: 900; letter-spacing: .09em; }
  .brand-pill span { font-size: .85rem; }
  .chapter-label { margin: 16px 0 0; color: #ffd965; font-size: .65rem; font-weight: 900; letter-spacing: .14em; }
  h1 { margin: 4px 0 0; font-size: clamp(2.45rem, 6.4vw, 5.15rem); line-height: .86; letter-spacing: -.06em; text-shadow: 0 7px 25px rgba(0,16,50,.34); }
  h1 span { display: block; margin-bottom: 10px; color: #fff4c6; font-size: .34em; line-height: 1; letter-spacing: -.025em; }
  .story-copy { max-width: 520px; margin: 18px 0 0; color: rgba(255,255,255,.82); font-size: clamp(.86rem, 1.5vw, 1rem); line-height: 1.55; }
  .feature-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .feature-row span { padding: 6px 9px; border: 1px solid rgba(255,255,255,.2); border-radius: 10px; background: rgba(255,255,255,.07); color: rgba(255,255,255,.8); font-size: .62rem; font-weight: 800; }
  .feature-row b { color: #ffdc60; }
  .controls-card { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  .controls-card > div { display: flex; align-items: center; gap: 4px; padding: 6px 8px; border-radius: 10px; background: rgba(2,17,48,.45); }
  .controls-card kbd { min-width: 24px; padding: 3px 6px; border: 1px solid rgba(255,255,255,.38); border-bottom-width: 3px; border-radius: 6px; background: rgba(255,255,255,.13); color: #fff; font: 800 .58rem 'Nunito', sans-serif; text-align: center; }
  .controls-card span { color: rgba(255,255,255,.45); font-size: .5rem; }
  .controls-card small { margin-left: 4px; color: rgba(255,255,255,.72); font-size: .57rem; font-weight: 800; }
