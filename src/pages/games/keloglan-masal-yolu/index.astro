    background:
      radial-gradient(circle at 54% 43%, rgba(25, 79, 145, .26), rgba(4, 22, 53, .9) 58%, #03142b 100%),
      linear-gradient(180deg, rgba(2, 12, 32, .28), rgba(2, 12, 32, .74)),
      url('/games/keloglan-masal-yolu/cover.webp') center / cover no-repeat;
  }
  .loading-mark {
    width: min(190px, 48vw);
    height: 64px;
    padding: 12px 18px;
    border: 1px solid rgba(255, 228, 127, .52);
    border-radius: 18px;
    background: radial-gradient(circle, rgba(255, 217, 91, .14), rgba(255,255,255,.025));
    box-shadow: 0 0 45px rgba(255, 205, 68, .12), inset 0 0 22px rgba(255,255,255,.05);
  }
  .loading-mark img { display: block; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 5px 16px rgba(0, 9, 31, .32)); }
  .loading-kicker { margin: 13px 0 0; color: var(--film-gold); font-size: .53rem; font-weight: 900; letter-spacing: .22em; }
  .loading-screen > strong { font-size: clamp(.95rem, 2vw, 1.1rem); letter-spacing: .02em; }
  .loading-track { width: min(280px, 72vw); height: 3px; background: rgba(255,255,255,.12); }
  .loading-track i { background: linear-gradient(90deg, #bd8d26, #ffe999); box-shadow: 0 0 13px rgba(255, 218, 89, .5); }
  .loading-note { color: rgba(255,255,255,.42); font-size: .58rem; font-weight: 800; letter-spacing: .08em; }

  .menu-screen {
    justify-items: start;
    background:
      linear-gradient(90deg, rgba(2, 14, 36, .97) 0%, rgba(3, 20, 48, .88) 33%, rgba(3, 20, 48, .38) 61%, rgba(3, 20, 48, .05) 82%),
      linear-gradient(0deg, rgba(2, 12, 31, .5), transparent 43%);
  }
  .menu-screen::before {
    background:
      linear-gradient(90deg, rgba(1, 8, 22, .45), transparent 48%),
      radial-gradient(ellipse at 72% 48%, transparent 24%, rgba(1, 8, 24, .18) 72%, rgba(1, 8, 24, .62) 120%);
  }
  .scene-caption {
    position: absolute;
    z-index: 1;
    right: max(28px, env(safe-area-inset-right));
    bottom: max(34px, env(safe-area-inset-bottom));
    display: grid;
    justify-items: end;
    padding-right: 12px;
    border-right: 2px solid rgba(246, 201, 83, .8);
    text-shadow: 0 3px 18px rgba(0, 8, 24, .8);
  }
  .scene-caption span { color: var(--film-gold); font-size: .5rem; font-weight: 900; letter-spacing: .2em; }
  .scene-caption strong { color: rgba(255,255,255,.75); font-size: .68rem; letter-spacing: .14em; }
  .menu-panel {
    width: min(660px, 100%);
    max-height: calc(100dvh - max(54px, env(safe-area-inset-top)) - max(54px, env(safe-area-inset-bottom)));
    margin-left: clamp(0px, 4.5vw, 70px);
    overflow-y: auto;
