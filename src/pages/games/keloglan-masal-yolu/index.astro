    line-height: 1.1;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .journey-copy .distance-copy { flex: 0 0 auto; justify-items: end; }
  .journey-copy .distance-copy strong { color: var(--film-gold-soft); font-variant-numeric: tabular-nums; }
  .journey-track { height: 4px; background: rgba(255,255,255,.14); }
  .journey-track i { background: linear-gradient(90deg, #c89527, #ffe990); box-shadow: 0 0 16px rgba(255, 217, 92, .72); }
  .journey-track .gate {
    width: 9px;
    height: 9px;
    border: 1px solid rgba(255, 234, 154, .72);
    background: #0b2a5b;
    box-shadow: 0 0 0 3px rgba(5, 23, 55, .64);
  }
  .relics { justify-content: flex-start; gap: 16px; margin-top: 7px; }
  .relics > span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: rgba(255,255,255,.3);
    transition: color .25s ease, transform .25s ease, text-shadow .25s ease;
  }
  .relics > span i {
    display: grid;
    width: 15px;
    height: 15px;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    font: 900 .39rem 'Nunito', sans-serif;
  }
  .relics > span small { font-size: .43rem; font-weight: 900; letter-spacing: .12em; }
  .relics > span.is-found {
    color: var(--film-gold-soft);
    text-shadow: 0 0 12px rgba(255, 219, 92, .72);
    transform: translateY(-1px);
  }

  .hud-actions { gap: 9px; }
  .hearts {
    min-height: 48px;
    border-radius: 14px 4px 4px 14px;
    color: #ff8b78;
    font-size: 1rem;
    text-shadow: 0 0 14px rgba(255, 83, 70, .3);
  }
  .icon-button {
    width: 48px;
    height: 48px;
    border-radius: 4px;
    color: var(--paper);
    font-weight: 900;
    transition: transform .16s ease, background .16s ease, border-color .16s ease;
  }
  .icon-button:hover { border-color: rgba(255, 229, 137, .7); background: rgba(16, 58, 118, .94); transform: translateY(-1px); }

  .power-meter {
    bottom: max(28px, env(safe-area-inset-bottom));
    left: max(24px, env(safe-area-inset-left));
    gap: 10px;
    padding: 7px 15px 7px 7px;
    border: 1px solid var(--hairline);
    border-radius: 6px 18px 18px 6px;
    background: linear-gradient(145deg, rgba(7, 31, 69, .9), rgba(4, 21, 51, .78));
    box-shadow: 0 14px 35px rgba(0, 10, 32, .28);
    backdrop-filter: blur(16px) saturate(1.15);
  }
  .power-orb > span { color: var(--film-gold-soft); font-size: .78rem; font-weight: 900; }
  .power-meter strong { color: var(--film-gold-soft); font-size: .56rem; letter-spacing: .14em; }
  .power-meter small { color: rgba(255,255,255,.6); }

  .toast {
    top: 116px;
    min-width: min(320px, 82vw);
    padding: 10px 18px;
    border: 0;
    border-top: 1px solid rgba(255, 230, 142, .72);
    border-bottom: 1px solid rgba(255, 230, 142, .35);
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, rgba(4, 23, 57, .94) 18%, rgba(4, 23, 57, .94) 82%, transparent);
    color: var(--paper);
    box-shadow: none;
    letter-spacing: .04em;
    text-align: center;
  }
  .tutorial {
    gap: 12px;
    padding: 12px 17px 12px 12px;
    border: 1px solid var(--hairline);
    border-radius: 5px 16px 16px 5px;
    border-left: 3px solid var(--film-gold);
    background: rgba(4, 21, 53, .88);
    backdrop-filter: blur(14px);
  }
  .tutorial > span { border-radius: 3px; background: var(--film-gold); }
  .tutorial strong { letter-spacing: .02em; }

  .touch-controls {
    padding: 0 max(22px, env(safe-area-inset-right)) max(22px, env(safe-area-inset-bottom)) max(22px, env(safe-area-inset-left));
  }
  .touch-steer, .touch-actions { align-items: end; gap: 11px; }
  .touch-controls button {
    width: 64px;
    height: 64px;
    align-content: center;
    gap: 0;
    border: 1px solid rgba(255, 244, 203, .42);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 30%, rgba(26, 69, 130, .88), rgba(4, 24, 59, .78));
    color: #fff;
    box-shadow: 0 12px 32px rgba(0, 10, 34, .28), inset 0 1px rgba(255,255,255,.1);
    backdrop-filter: blur(12px);
  }
  .touch-controls button > span { font-size: 1.45rem; line-height: .9; }
  .touch-controls small { margin-top: 3px; color: rgba(255,255,255,.72); font-size: .46rem; letter-spacing: .12em; }
  .touch-controls .jump-button {
    width: 72px;
    height: 72px;
    border-color: rgba(255, 242, 187, .78);
    background: radial-gradient(circle at 50% 28%, #ffe582, #edb82d);
    color: #4f3100;
    box-shadow: 0 14px 34px rgba(84, 49, 0, .28), inset 0 1px rgba(255,255,255,.45);
  }
  .touch-controls .jump-button small { color: rgba(70, 42, 0, .72); }
  .touch-controls .boost-button { background: radial-gradient(circle at 50% 28%, rgba(91, 78, 174, .9), rgba(28, 24, 87, .82)); }
  .touch-controls .boost-button:not(:disabled) { border-color: var(--film-gold-soft); box-shadow: 0 0 24px rgba(255, 215, 80, .3); }
  .touch-controls button:active { transform: scale(.92); }

  .screen {
    isolation: isolate;
    background: rgba(3, 17, 43, .66);
  }
  .screen::before,
  .screen::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .screen::before {
    z-index: 0;
    background: radial-gradient(ellipse at 52% 45%, transparent 34%, rgba(1, 8, 24, .35) 78%, rgba(1, 8, 24, .7) 120%);
  }
  .screen::after {
    z-index: 2;
    opacity: .55;
    background:
      linear-gradient(180deg, rgba(1, 7, 20, .95) 0 10px, transparent 10px calc(100% - 10px), rgba(1, 7, 20, .95) calc(100% - 10px)),
      repeating-radial-gradient(circle at 23% 43%, rgba(255,255,255,.05) 0 .5px, transparent .7px 4px);
    background-size: 100% 100%, 8px 8px;
    mix-blend-mode: soft-light;
  }
  .menu-panel,
  .small-panel,
  .fallback-card,
  .loading-mark,
  .loading-screen > p,
  .loading-screen > strong,
  .loading-screen > small,
  .loading-track { position: relative; z-index: 1; }

  .loading-screen {
