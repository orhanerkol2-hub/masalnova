---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryCard from '../../components/StoryCard.astro';
import { getAllParentGuides, getParentGuides, parentGuidePath } from '../../data/guides';
import { getStoryAuthor, storyReviewers } from '../../data/authors';
import { getStories, storyById } from '../../data/stories';
import { compactDescription, formatTurkishDate } from '../../lib/seo';

export async function getStaticPaths() {
  const guides = await getAllParentGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props;
const d = guide.data;
const { Content } = await render(guide);
const author = d.author === 'masalnova-redaksiyonu' ? undefined : getStoryAuthor(d.author);
const isApproved = d.editorialStatus === 'approved' && Boolean(d.reviewedBy);
const allStories = await getStories();
const relatedStories = d.relatedStoryIds.map((id) => storyById(allStories, id)).filter(Boolean).slice(0, 4);
const otherGuides = (await getParentGuides()).filter((candidate) => candidate.id !== guide.id).slice(0, 3);
const path = parentGuidePath(guide);
const pageUrl = `https://masalnova.com${path}`;
const description = compactDescription(d.shortDescription);
const publishedLabel = formatTurkishDate(d.publishedAt);
const modifiedLabel = d.modifiedAt ? formatTurkishDate(d.modifiedAt) : undefined;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${pageUrl}#article`,
    headline: d.title,
    description,
    url: pageUrl,
    inLanguage: 'tr-TR',
    isAccessibleForFree: true,
    datePublished: d.publishedAt,
    dateModified: d.modifiedAt ?? d.publishedAt,
    author: author
      ? { '@type': 'Person', '@id': `https://masalnova.com${author.profilePath}#person`, name: author.name, url: `https://masalnova.com${author.profilePath}` }
      : { '@type': 'Organization', '@id': 'https://masalnova.com/#organization', name: 'MasalNova Çocuk' },
    editor: isApproved ? storyReviewers.map((reviewer) => ({ '@type': 'Person', '@id': `https://masalnova.com${reviewer.profilePath}#person`, name: reviewer.name })) : undefined,
    publisher: { '@id': 'https://masalnova.com/#organization' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
      { '@type': 'ListItem', position: 2, name: 'Ebeveyn Rehberi', item: 'https://masalnova.com/ebeveyn-rehberi/' },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
];
---

<BaseLayout
  title={d.seoTitle ?? `${d.title} | MasalNova Ebeveyn Rehberi`}
  description={description}
  path={path}
  ogType="article"
  publishedTime={isApproved ? d.publishedAt : undefined}
  modifiedTime={isApproved ? d.modifiedAt : undefined}
  jsonLd={isApproved ? jsonLd : undefined}
  activeNav="guides"
  readerPage
  allowAds={false}
  robots={isApproved ? undefined : 'noindex, follow'}
>
  <article class="parent-guide-page">
    <div class="container parent-guide-shell">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Ana Sayfa</a><span>›</span><a href="/ebeveyn-rehberi/">Ebeveyn Rehberi</a><span>›</span><span>{d.title}</span></nav>
      <header class="guide-header">
        <p class="eyebrow">MasalNova · Ebeveyn Rehberi</p>
        <h1>{d.title}</h1>
        <p class="dek">{d.shortDescription}</p>
        <div class="guide-meta">
          <span>Hazırlayan: {author ? <a href={author.profilePath}>{author.name}</a> : isApproved ? 'MasalNova redaksiyonu' : 'MasalNova redaksiyon taslağı'}</span><span aria-hidden="true">·</span><span>{d.readingTime} dk okuma</span><span aria-hidden="true">·</span><time datetime={d.modifiedAt ?? d.publishedAt}>{isApproved ? 'İnceleme' : 'Taslak tarihi'}: {modifiedLabel ?? publishedLabel}</time>
        </div>
        {isApproved
          ? <p class="editorial-note">Editoryal inceleme: <a href="/yazarlar/aylin-karabektas/">Aylin Karabektaş</a> ve <a href="/yazarlar/muhammet-karayigit/">Muhammet Karayiğit</a></p>
          : <p class="editorial-note" data-nosnippet><strong>Editoryal önizleme:</strong> Bu taslak, gerçek bir yazar atamasını ve fiilî editoryal incelemeyi bekliyor. O zamana kadar noindex ve reklamsız kalır.</p>}
      </header>

      <div class="guide-layout">
        <section class="guide-body"><Content /></section>
        <aside class="source-panel" aria-labelledby="sources-title">
          <p class="eyebrow">Şeffaflık</p><h2 id="sources-title">Kullanılan kaynaklar</h2>
          <ol>{d.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} <i class="ph ph-arrow-square-out" aria-hidden="true"></i></a></li>)}</ol>
          <p>Kaynak bağlantıları genel çerçeveyi destekler. Yaş etiketi ve etkinlik önerileri her çocuğun bireysel ihtiyaçlarının yerine geçmez.</p>
        </aside>
      </div>

      {relatedStories.length > 0 && <section class="related-stories"><p class="eyebrow">Rehberi uygulayın</p><h2>Bu konuyla birlikte okunabilecek masallar</h2><div class="grid grid-3">{relatedStories.map((story) => <StoryCard story={story!} />)}</div></section>}

      <section class="more-guides"><p class="eyebrow">Okumaya devam edin</p><h2>Diğer ebeveyn rehberleri</h2><div>{otherGuides.map((item) => <a href={parentGuidePath(item)}><span>{item.data.readingTime} dk</span><strong>{item.data.title}</strong><i class="ph ph-arrow-right" aria-hidden="true"></i></a>)}</div></section>
    </div>
  </article>
</BaseLayout>

<style>
  .parent-guide-page { padding:26px 0 64px; background:#fbf8f1; color:#172d5f; }
  .parent-guide-shell { max-width:1080px; }
  .crumbs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px; color:#737c8e; font-size:.84rem; }
  .crumbs a { color:#184aa9; font-weight:850; }
  .guide-header { padding:clamp(28px,6vw,58px); border:1px solid #e0dacd; border-radius:30px; background:linear-gradient(145deg,#fff,#fffaf0); box-shadow:0 22px 60px rgba(23,43,92,.08); }
  .eyebrow { margin:0 0 8px; color:#1752c5; font-size:.75rem; font-weight:950; letter-spacing:.09em; text-transform:uppercase; }
  .guide-header h1 { max-width:18ch; margin:0; color:#0d2f72; font-size:clamp(2.4rem,6vw,4.8rem); line-height:1.02; letter-spacing:-.055em; }
  .dek { max-width:67ch; margin-top:19px; color:#5d687e; font-size:1.12rem; line-height:1.72; }
  .guide-meta { display:flex; flex-wrap:wrap; gap:8px; margin-top:22px; color:#687288; font-size:.82rem; font-weight:750; }
  .guide-meta a,.editorial-note a { color:#1649ac; font-weight:900; }
  .editorial-note { margin-top:9px; color:#747d90; font-size:.8rem; }
  .guide-layout { display:grid; grid-template-columns:minmax(0,1fr) 285px; gap:34px; align-items:start; margin-top:34px; }
  .guide-body { padding:clamp(24px,5vw,48px); border:1px solid #e1dccf; border-radius:26px; background:#fff; box-shadow:0 14px 40px rgba(23,43,92,.05); }
  .guide-body :global(h2) { margin:2.1em 0 .55em; color:#123676; font-size:clamp(1.55rem,3vw,2.05rem); line-height:1.2; }
  .guide-body :global(h2:first-child) { margin-top:0; }
  .guide-body :global(h3) { margin:1.7em 0 .45em; color:#224a91; font-size:1.2rem; }
  .guide-body :global(p),.guide-body :global(li) { color:#414d65; font-size:1.01rem; line-height:1.82; }
  .guide-body :global(p) { margin:.85em 0; }
  .guide-body :global(ul),.guide-body :global(ol) { display:grid; gap:8px; margin:1em 0; padding-left:1.4em; }
  .guide-body :global(a) { color:#0d55bc; font-weight:800; text-decoration:underline; text-underline-offset:3px; }
  .guide-body :global(blockquote) { margin:1.5em 0; padding:16px 20px; border-left:4px solid #e3ae36; border-radius:0 14px 14px 0; background:#fff8e7; color:#554b35; }
  .source-panel { position:sticky; top:24px; padding:22px; border:1px solid #d8e2f4; border-radius:20px; background:#f4f7fd; }
  .source-panel h2 { margin:0; color:#143b82; font-size:1.2rem; }
  .source-panel ol { display:grid; gap:11px; margin:15px 0; padding-left:20px; }
  .source-panel a { color:#174aa9; font-size:.84rem; font-weight:800; line-height:1.45; }
  .source-panel > p:last-child { color:#69758b; font-size:.76rem; line-height:1.55; }
  .related-stories,.more-guides { margin-top:42px; }
  .related-stories h2,.more-guides h2 { margin:0 0 18px; color:#143777; font-size:clamp(1.7rem,3vw,2.4rem); }
  .more-guides > div { display:grid; gap:10px; }
  .more-guides a { display:grid; grid-template-columns:60px minmax(0,1fr) auto; gap:14px; align-items:center; padding:17px 19px; border:1px solid #e0dacd; border-radius:16px; background:#fff; color:#163a7b; }
  .more-guides a span { color:#7a8394; font-size:.76rem; font-weight:850; }
  @media (max-width:820px) { .guide-layout { grid-template-columns:1fr; } .source-panel { position:static; } }
  @media (max-width:540px) { .parent-guide-page { padding:18px 0 42px; } .guide-header,.guide-body { padding:24px 19px; border-radius:21px; } }
</style>
