---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllParentGuides, getParentGuides, parentGuidePath } from '../../data/guides';
import { getStoryAuthor } from '../../data/authors';

const approvedGuides = await getParentGuides();
const allGuides = await getAllParentGuides();
const guides = approvedGuides.length ? approvedGuides : allGuides;
const isEditoriallyReady = approvedGuides.length >= 8;
const path = '/ebeveyn-rehberi/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': `https://masalnova.com${path}#collection`,
    name: 'Ebeveyn Rehberi',
    description: 'Masal seçimi, birlikte okuma, konuşma soruları ve ekransız etkinlikler için uygulamalı MasalNova ebeveyn rehberleri.',
    url: `https://masalnova.com${path}`,
    inLanguage: 'tr-TR',
    isPartOf: { '@id': 'https://masalnova.com/#website' },
    mainEntity: {
      '@type': 'ItemList',
    numberOfItems: approvedGuides.length,
      itemListElement: approvedGuides.map((guide, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: guide.data.title,
        url: `https://masalnova.com${parentGuidePath(guide)}`,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
      { '@type': 'ListItem', position: 2, name: 'Ebeveyn Rehberi', item: `https://masalnova.com${path}` },
    ],
  },
];
---

<BaseLayout
  title="Ebeveyn Rehberi – Masal Seçimi ve Birlikte Okuma | MasalNova"
  description="Çocuğunuza uygun masalı seçmek, birlikte okumak ve hikâyeyi konuşmak için kaynaklı, uygulanabilir Türkçe ebeveyn rehberleri."
  path={path}
  jsonLd={isEditoriallyReady ? jsonLd : undefined}
  activeNav="guides"
  allowAds={false}
  robots={isEditoriallyReady ? undefined : 'noindex, follow'}
>
  <section class="guide-index">
    <div class="container guide-index__shell">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Ana Sayfa</a><span>›</span><span>Ebeveyn Rehberi</span></nav>
      <header class="guide-hero">
        <div>
          <p class="eyebrow"><i class="ph ph-users-three" aria-hidden="true"></i> MasalNova Ebeveyn Rehberi</p>
          <h1>Masalı seçmekten birlikte konuşmaya</h1>
          <p>Yaşa uygun seçim, sakin okuma rutini, hikâyeye özel sorular ve ekransız etkinlikler için uygulanabilir rehberler. Her yazı kullanılan kaynakları, yazarını ve son inceleme tarihini açıkça gösterir.</p>
        </div>
        <aside aria-label="Rehber ilkeleri">
          <strong>Bu bölümde ne bulacaksınız?</strong>
          <ul>
            <li>MasalNova hikâyelerinden somut örnekler</li>
            <li>Evde hemen uygulanabilen küçük adımlar</li>
            <li>Uzmanlık gerektiren bilgiler için görünür kaynaklar</li>
          </ul>
        </aside>
      </header>

      {!isEditoriallyReady && (
        <aside class="review-banner" data-nosnippet>
          <strong>Editoryal önizleme</strong>
          <p>Yeni rehberlerin içerik taslakları hazırlandı; ancak henüz adı belirtilen gerçek bir yazar tarafından üstlenilmedi ve sorumlu editörlerce onaylanmadı. Bu bölüm o zamana kadar arama dizinine ve reklamlara kapalı kalır.</p>
        </aside>
      )}

      <section class="guide-list" aria-labelledby="guide-list-title">
        <div class="section-heading">
          <div><p class="eyebrow">Okuma ve etkinlik kütüphanesi</p><h2 id="guide-list-title">{guides.length} ayrıntılı rehber</h2></div>
        </div>
        <div class="guide-grid">
          {guides.map((guide, index) => {
            const author = guide.data.author === 'masalnova-redaksiyonu'
              ? undefined
              : getStoryAuthor(guide.data.author);
            return (
              <article class:list={['guide-card', { 'guide-card--featured': index === 0 }]}>
                <p class="guide-card__number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</p>
                <div>
                  <p class="guide-card__meta">{guide.data.readingTime} dk okuma · {author?.name ?? 'MasalNova redaksiyon taslağı'}{guide.data.editorialStatus !== 'approved' ? ' · İncelemede' : ''}</p>
                  <h2><a href={parentGuidePath(guide)}>{guide.data.title}</a></h2>
                  <p>{guide.data.shortDescription}</p>
                  <a class="guide-card__link" href={parentGuidePath(guide)}>Rehberi oku <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .guide-index { padding: 30px 0 64px; background: #fbf8f1; color: #132b61; }
  .guide-index__shell { max-width: 1180px; }
  .crumbs { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:20px; color:#70798b; font-size:.86rem; }
  .crumbs a { color:#1649ac; font-weight:850; }
  .guide-hero { display:grid; grid-template-columns:minmax(0,1.55fr) minmax(280px,.65fr); gap:30px; align-items:stretch; padding:clamp(28px,6vw,62px); border:1px solid #ded8ca; border-radius:30px; background:linear-gradient(135deg,#fff 0%,#fffaf0 58%,#edf4ff 100%); box-shadow:0 24px 65px rgba(23,43,92,.09); }
  .eyebrow { display:flex; gap:7px; align-items:center; margin:0 0 8px; color:#1752c5; font-size:.76rem; font-weight:950; letter-spacing:.09em; text-transform:uppercase; }
  .guide-hero h1 { max-width:13ch; margin:0; color:#0b2b75; font-size:clamp(2.5rem,6vw,5rem); line-height:.98; letter-spacing:-.06em; }
  .guide-hero > div > p:last-child { max-width:65ch; margin-top:20px; color:#5e687e; font-size:1.06rem; line-height:1.75; }
  .guide-hero aside { align-self:end; padding:24px; border:1px solid #dbe4f6; border-radius:22px; background:rgba(255,255,255,.82); }
  .guide-hero aside strong { color:#173d8d; }
  .guide-hero aside ul { display:grid; gap:10px; margin:14px 0 0; padding-left:20px; color:#5e687e; line-height:1.55; }
  .guide-list { margin-top:42px; }
  .review-banner { margin-top:20px; padding:18px 20px; border:1px solid #e7c86e; border-radius:16px; background:#fff8df; color:#5d4b1d; }
  .review-banner p { margin-top:5px; line-height:1.6; }
  .section-heading h2 { margin:0; font-size:clamp(2rem,4vw,3rem); }
  .guide-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18px; margin-top:22px; }
  .guide-card { display:grid; grid-template-columns:auto minmax(0,1fr); gap:18px; padding:28px; border:1px solid #e1dccf; border-radius:22px; background:#fff; box-shadow:0 12px 34px rgba(23,43,92,.06); }
  .guide-card--featured { border-color:#c7d8fa; background:linear-gradient(145deg,#fff,#f2f6ff); }
  .guide-card__number { color:#b5bfd3; font-size:.8rem; font-weight:950; letter-spacing:.08em; }
  .guide-card__meta { margin:0 0 7px; color:#7a8293; font-size:.78rem; font-weight:800; }
  .guide-card h2 { margin:0; color:#123676; font-size:1.35rem; line-height:1.2; }
  .guide-card h2 a::after { content:""; position:absolute; inset:0; }
  .guide-card { position:relative; }
  .guide-card > div > p:not(.guide-card__meta) { margin-top:11px; color:#667086; line-height:1.65; }
  .guide-card__link { display:inline-flex; gap:7px; align-items:center; margin-top:16px; color:#1749ae; font-weight:900; }
  @media (max-width:800px) { .guide-hero,.guide-grid { grid-template-columns:1fr; } .guide-hero h1 { max-width:15ch; } }
  @media (max-width:540px) { .guide-index { padding:20px 0 40px; } .guide-hero { padding:25px 20px; border-radius:22px; } .guide-card { padding:22px 18px; } }
</style>
