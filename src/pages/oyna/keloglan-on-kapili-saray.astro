---
import BaseLayout from '../../layouts/BaseLayout.astro';

const game = {
  title: 'Keloğlan ve On Kapılı Saray',
  shortDescription: 'Keloğlan’la gizemli sarayın on kapısını aç, birbirinden farklı bulmacaları çöz ve taht odasında onu bekleyen sırrı keşfet.',
  image: '/games/keloglan-on-kapili-saray/assets/palace-story.webp',
  imageAlt: 'Keloğlan, ay ışığında bulutların üzerindeki on kapılı gizemli saraya çıkan bulmaca yolunda',
};

const gameUrl = 'https://masalnova.com/oyna/keloglan-on-kapili-saray/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: game.title,
    description: game.shortDescription,
    url: gameUrl,
    image: `https://masalnova.com${game.image}`,
    inLanguage: 'tr-TR',
    applicationCategory: 'Game',
    genre: ['Story puzzle', "Children's game"],
    gamePlatform: ['Web browser', 'Mobile web'],
    playMode: 'SinglePlayer',
    typicalAgeRange: '6-10',
    numberOfPlayers: 1,
    publisher: { '@type': 'Organization', name: 'MasalNova' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
      { '@type': 'ListItem', position: 2, name: 'Oyunlar', item: 'https://masalnova.com/oyunlar/' },
      { '@type': 'ListItem', position: 3, name: game.title, item: gameUrl },
    ],
  },
];
---

<BaseLayout
  title={`${game.title} Oyna | MasalNova`}
  description={`${game.shortDescription} MasalNova’ya özel, reklamsız ve ücretsiz Türkçe HTML5 oyununu oyna.`}
  path="/oyna/keloglan-on-kapili-saray/"
  image={game.image}
  imageAlt={game.imageAlt}
  activeNav="oyunlar"
  allowAds={false}
  jsonLd={jsonLd}
>
  <section class="game-page">
    <div class="container">
      <nav class="breadcrumbs" aria-label="İçerik yolu">
        <a href="/">Ana Sayfa</a><span aria-hidden="true">›</span>
        <a href="/oyunlar/">Oyunlar</a><span aria-hidden="true">›</span>
        <span>Keloğlan ve On Kapılı Saray</span>
      </nav>

      <div class="game-heading">
        <div>
          <div class="meta-row">
            <span class="exclusive-pill"><i class="ph ph-seal-check" aria-hidden="true"></i> MasalNova’ya özel</span>
            <span>Hikâyeli Bulmaca</span>
            <span>10 bölüm</span>
            <span>Öneri: 6+</span>
          </div>
          <h1>Keloğlan ve On Kapılı Saray</h1>
          <p>{game.shortDescription}</p>
        </div>
        <div class="heading-actions">
          <a class="fullscreen-link" href="/games/keloglan-on-kapili-saray/index.html" data-fullscreen-trigger>
            <i class="ph ph-arrows-out" aria-hidden="true"></i> Tam ekran oyna
          </a>
          <a class="back-link" href="/oyunlar/"><i class="ph ph-grid-four" aria-hidden="true"></i> Tüm oyunlar</a>
        </div>
      </div>

      <section class="player-shell" aria-label="Keloğlan ve On Kapılı Saray oyun alanı" data-player-shell>
        <iframe
          src="/games/keloglan-on-kapili-saray/index.html"
          title="Keloğlan ve On Kapılı Saray — MasalNova oyun alanı"
          allow="fullscreen"
          allowfullscreen
          loading="eager"
          data-game-frame
        ></iframe>
      </section>

      <p class="local-note">
        <i class="ph ph-shield-check" aria-hidden="true"></i>
        Bu oyun MasalNova tarafından sunulur; reklam ve dış bağlantı içermez. İlerlemen yalnızca bu cihazda saklanır.
      </p>

      <div class="game-info-grid">
        <article class="info-card">
          <span class="info-icon"><i class="ph ph-puzzle-piece" aria-hidden="true"></i></span>
          <div>
            <h2>Nasıl oynanır?</h2>
            <p>Her kapıda verilen masal ipucunu oku; sembollere dokun, desenleri hatırla, kilim labirentini geç ve sarayın dokuz mührünü topla.</p>
          </div>
        </article>
        <article class="info-card">
          <span class="info-icon"><i class="ph ph-book-open-text" aria-hidden="true"></i></span>
          <div>
            <h2>Sarayın sırrı</h2>
            <p>Onuncu kapının ardında Keloğlan’ı bekleyen şey bir hazine mi, bir dev mi, yoksa bambaşka bir sürpriz mi? Son bulmaca çözülmeden bilinmez.</p>
          </div>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .game-page { padding: 28px 0 58px; }
  .game-page .container { max-width: 1260px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: rgba(255,255,255,.72); font-size: .78rem; font-weight: 800; }
  .breadcrumbs a:hover { color: #fff; text-decoration: underline; }
  .game-heading { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin: 22px 0 18px; color: #fff; }
  .meta-row { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 10px; }
  .meta-row span { display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px; border: 1px solid rgba(255,255,255,.28); border-radius: 999px; background: rgba(255,255,255,.12); font-size: .73rem; font-weight: 900; }
  .meta-row .exclusive-pill { border-color: #ffe18b; background: #ffd25b; color: #5f3700; }
  h1 { font-size: clamp(2rem, 5vw, 3.65rem); letter-spacing: -.04em; }
  .game-heading p { max-width: 760px; margin-top: 9px; color: rgba(255,255,255,.82); }
  .heading-actions { display: flex; flex: 0 0 auto; gap: 9px; }
  .fullscreen-link, .back-link { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; background: rgba(255,255,255,.12); font-size: .8rem; font-weight: 900; }
  .fullscreen-link { border-color: #ffd45b; background: #ffd45b; color: #593600; }
  .fullscreen-link:hover, .back-link:hover { transform: translateY(-2px); }
  .player-shell { position: relative; overflow: hidden; border: 1px solid rgba(255,255,255,.24); border-radius: 26px; background: #071a39; box-shadow: 0 28px 68px rgba(0,15,66,.38); }
  .player-shell iframe { display: block; width: 100%; height: min(760px, calc(100dvh - 104px)); min-height: 620px; border: 0; background: #071a39; }
  .player-shell:fullscreen { width: 100vw; height: 100dvh; border: 0; border-radius: 0; background: #071a39; box-shadow: none; }
  .player-shell:fullscreen iframe { width: 100%; height: 100%; min-height: 100%; }
  :global(html.game-fullscreen-active), :global(body.game-fullscreen-active) { height: 100%; overflow: hidden !important; overscroll-behavior: none; }
  .local-note { display: flex; align-items: flex-start; gap: 9px; margin: 14px 4px 0; color: rgba(255,255,255,.74); font-size: .78rem; }
  .local-note i { flex: 0 0 auto; margin-top: 2px; color: #ffd957; font-size: 1rem; }
  .game-info-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }
  .info-card { display: flex; gap: 15px; padding: 22px; border: 1px solid rgba(255,255,255,.18); border-radius: 20px; background: rgba(255,255,255,.11); color: #fff; }
  .info-icon { display: grid; flex: 0 0 auto; width: 42px; height: 42px; place-items: center; border-radius: 13px; background: #ffd14b; color: #173169; font-size: 1.3rem; }
  .info-card h2 { font-size: 1.08rem; }
  .info-card p { margin-top: 6px; color: rgba(255,255,255,.75); font-size: .88rem; }

  @media (min-width: 721px) {
    .game-page { background: #fbf8f1; color: #102a66; }
    .breadcrumbs { color: #71809a; }
    .breadcrumbs a:hover { color: #1749ae; }
    .game-heading { color: #0b2b75; }
    .game-heading p { color: #68758d; }
    .meta-row span { border-color: #d9dfec; background: #fff; color: #3c5686; }
    .meta-row .exclusive-pill { border-color: #e8bd3f; background: #ffe189; color: #694000; }
    .back-link { border-color: #d6deee; background: #fff; color: #1749ae; }
    .player-shell { border-color: #d6d0c3; box-shadow: 0 24px 56px rgba(26,38,76,.16); }
    .local-note { color: #68758d; }
    .local-note i { color: #148a52; }
    .info-card { border-color: #ded9ce; background: #fff; color: #173574; box-shadow: 0 12px 30px rgba(23,43,92,.07); }
    .info-card p { color: #69748a; }
  }
  @media (max-width: 820px) {
    .game-heading { align-items: flex-start; flex-direction: column; }
    .heading-actions { width: 100%; }
    .fullscreen-link { justify-content: center; flex: 1; min-height: 44px; }
    .back-link { display: none; }
    .player-shell iframe { height: min(720px, calc(100dvh - 156px)); min-height: 570px; }
    .game-info-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .game-page { padding-top: 22px; }
    .game-heading { gap: 18px; margin-top: 18px; }
    .player-shell { margin-inline: -12px; border-radius: 20px; }
    .player-shell iframe { height: min(720px, calc(100dvh - 154px)); min-height: 560px; }
  }
</style>

<script>
  const playerShell = document.querySelector<HTMLElement>('[data-player-shell]');
  const gameFrame = document.querySelector<HTMLIFrameElement>('[data-game-frame]');
  const fullscreenTriggers = document.querySelectorAll<HTMLAnchorElement>('[data-fullscreen-trigger]');

  if (playerShell && gameFrame && fullscreenTriggers.length > 0) {
    const setFullscreenState = () => {
      const isFullscreen = document.fullscreenElement === playerShell;
      document.documentElement.classList.toggle('game-fullscreen-active', isFullscreen);
      document.body.classList.toggle('game-fullscreen-active', isFullscreen);
      if (isFullscreen) gameFrame.focus({ preventScroll: true });
    };
    const openGame = async (event: MouseEvent) => {
      event.preventDefault();
      try {
        await playerShell.requestFullscreen();
        setFullscreenState();
      } catch {
        window.location.assign((event.currentTarget as HTMLAnchorElement).href);
      }
    };
    fullscreenTriggers.forEach((trigger) => trigger.addEventListener('click', openGame));
    document.addEventListener('fullscreenchange', setFullscreenState);
  }
</script>
