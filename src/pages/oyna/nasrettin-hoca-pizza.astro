---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameEditorial from '../../components/GameEditorial.astro';

const game = {
  title: "Nasrettin Hoca'nın Pizzahanesi",
  shortDescription: 'Nasrettin Hoca’nın masalsı köy fırınında siparişleri hazırla, doğru malzemeleri seç, zaman bonusu kazan ve kusursuz pizza kombonu büyüt.',
  image: '/games/nasrettin-hoca-pizza/assets/nasrettin-hoca-pizza-cover.webp',
  imageAlt: 'Nasrettin Hoca, Karakaçan’la birlikte büyük bir pizzayı neşeyle sunuyor',
};
const gameUrl = 'https://masalnova.com/oyna/nasrettin-hoca-pizza/';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: game.title,
    description: game.shortDescription,
    url: gameUrl,
    image: `https://masalnova.com${game.image}`,
    inLanguage: 'tr-TR',
    applicationCategory: 'Game',
    genre: ['Cooking game', 'Time management', "Children's game"],
    gamePlatform: ['Web browser', 'Mobile web'],
    playMode: 'SinglePlayer',
    typicalAgeRange: '6-10',
    numberOfPlayers: 1,
    publisher: { '@type': 'Organization', name: 'MasalNova' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
      { '@type': 'ListItem', position: 2, name: 'Oyunlar', item: 'https://masalnova.com/oyunlar/' },
      { '@type': 'ListItem', position: 3, name: game.title, item: gameUrl },
    ],
  },
];
---

<BaseLayout
  title={`${game.title} Oyna | MasalNova`}
  description={`${game.shortDescription} MasalNova’ya özel, reklamsız ve ücretsiz Türkçe pizza yapma oyununu oyna.`}
  path="/oyna/nasrettin-hoca-pizza/"
  image={game.image}
  imageAlt={game.imageAlt}
  activeNav="oyunlar"
  allowAds={false}
  jsonLd={jsonLd}
>
  <section class="game-page">
    <div class="container">
      <nav class="breadcrumbs" aria-label="İçerik yolu">
        <a href="/">Ana Sayfa</a><span aria-hidden="true">›</span>
        <a href="/oyunlar/">Oyunlar</a><span aria-hidden="true">›</span>
        <span>{game.title}</span>
      </nav>

      <div class="game-heading">
        <div>
          <div class="meta-row">
            <span class="exclusive-pill"><i class="ph ph-seal-check" aria-hidden="true"></i> MasalNova’ya özel</span>
            <span>Pizza yapma</span>
            <span>Puan &amp; kombo</span>
            <span>Öneri: 6+</span>
          </div>
          <h1>{game.title}</h1>
          <p>{game.shortDescription}</p>
        </div>
        <div class="heading-actions">
          <a class="fullscreen-link" href="/games/nasrettin-hoca-pizza/index.html" data-fullscreen-trigger>
            <i class="ph ph-arrows-out" aria-hidden="true"></i> Tam ekran oyna
          </a>
          <a class="back-link" href="/oyunlar/"><i class="ph ph-grid-four" aria-hidden="true"></i> Tüm oyunlar</a>
        </div>
      </div>

      <section class="player-shell" aria-label="Nasrettin Hoca'nın Pizzahanesi oyun alanı" data-player-shell>
        <iframe
          src="/games/nasrettin-hoca-pizza/index.html"
          title="Nasrettin Hoca'nın Pizzahanesi — MasalNova oyun alanı"
          allow="fullscreen"
          allowfullscreen
          loading="eager"
          data-game-frame
        ></iframe>
        <a class="inline-game-launch" href="/games/nasrettin-hoca-pizza/index.html" data-fullscreen-trigger>
          <i class="ph ph-arrows-out" aria-hidden="true"></i>
          <span>
            <strong>Tam ekranda oyna</strong>
            <small>Bu önizlemenin üzerinde de sayfayı kaydırabilirsin.</small>
          </span>
        </a>
      </section>

      <p class="local-note">
        <i class="ph ph-shield-check" aria-hidden="true"></i>
        Bu oyun MasalNova tarafından sunulur; reklam ve dış bağlantı içermez. En iyi puanın yalnızca bu cihazda saklanır.
      </p>

      <div class="game-info-grid">
        <article class="info-card">
          <span class="info-icon"><i class="ph ph-pizza" aria-hidden="true"></i></span>
          <div>
            <h2>Nasıl oynanır?</h2>
            <p>Müşteri fişindeki malzemeleri incele. Malzemelere dokun veya onları pizza hamuruna sürükle; sipariş tamamlanınca pizzayı fırına ver.</p>
          </div>
        </article>
        <article class="info-card">
          <span class="info-icon"><i class="ph ph-lightning" aria-hidden="true"></i></span>
          <div>
            <h2>Puanını katla</h2>
            <p>Doğru pizza ve hızlı servis daha çok puan kazandırır. Arka arkaya kusursuz siparişler hazırlarsan kombo çarpanın büyür.</p>
          </div>
        </article>
        <article class="info-card">
          <span class="info-icon"><i class="ph ph-keyboard" aria-hidden="true"></i></span>
          <div>
            <h2>Klavye kısayolları</h2>
            <p>1–8 ile malzeme seç, R ile pizzayı temizle ve Enter veya boşluk tuşuyla siparişi fırına gönder.</p>
          </div>
        </article>
      </div>
      <GameEditorial slug="nasrettin-hoca-pizza" title="Nasrettin Hoca Pizza" minimumWords={200} />
    </div>
  </section>
</BaseLayout>

<style>
  .game-page {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100dvh;
    padding: 28px 0 60px;
    background: #103d43;
  }
  .game-page::before {
    position: absolute;
    z-index: -2;
    inset: 0 0 auto;
    height: min(720px, 72vw);
    background:
      linear-gradient(180deg, rgba(5,35,38,.28), #103d43 86%),
      linear-gradient(90deg, rgba(6,29,31,.6), transparent 52%, rgba(6,29,31,.28)),
      url('/games/nasrettin-hoca-pizza/assets/nasrettin-hoca-pizza-kitchen.webp') center / cover no-repeat;
    content: '';
    filter: saturate(.9);
    opacity: .52;
  }
  .game-page::after { position: absolute; z-index: -1; inset: 0; background-image: radial-gradient(rgba(255,255,255,.11) .55px, transparent .55px); background-size: 4px 4px; content: ''; opacity: .08; pointer-events: none; }
  .game-page .container { position: relative; max-width: 1280px; }
  .breadcrumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; color: rgba(255,255,255,.72); font-size: .78rem; font-weight: 800; }
  .breadcrumbs a:hover { color: #fff; text-decoration: underline; }
  .game-heading { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin: 22px 0 18px; color: #fff; }
  .meta-row { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 10px; }
  .meta-row span { display: inline-flex; align-items: center; gap: 5px; padding: 5px 10px; border: 1px solid rgba(255,255,255,.28); border-radius: 999px; background: rgba(5,47,51,.58); font-size: .73rem; font-weight: 900; backdrop-filter: blur(8px); }
  .meta-row .exclusive-pill { border-color: #ffe18b; background: #ffd25b; color: #5f3700; }
  h1 { font-size: clamp(2rem, 5vw, 3.7rem); letter-spacing: -.045em; }
  .game-heading p { max-width: 780px; margin-top: 9px; color: rgba(255,255,255,.82); }
  .heading-actions { display: flex; flex: 0 0 auto; gap: 9px; }
  .fullscreen-link, .back-link { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid rgba(255,255,255,.3); border-radius: 999px; background: rgba(5,47,51,.58); color: #fff; font-size: .8rem; font-weight: 900; backdrop-filter: blur(8px); }
  .fullscreen-link { border-color: #ffd45b; background: #ffd45b; color: #593600; }
  .fullscreen-link:hover, .back-link:hover { transform: translateY(-2px); }
  .player-shell { position: relative; overflow: hidden; border: 1px solid rgba(255,218,113,.44); border-radius: 26px; background: #0b3035; box-shadow: 0 34px 90px rgba(2,19,21,.52), 0 0 0 7px rgba(255,255,255,.025); }
  .player-shell::before { position: absolute; z-index: 3; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(255,255,255,.1); content: ''; pointer-events: none; }
  .player-shell iframe { display: block; width: 100%; height: min(780px, calc(100dvh - 108px)); min-height: 640px; border: 0; background: #0b3035; pointer-events: none; }
  .inline-game-launch { position: absolute; z-index: 5; right: 18px; bottom: 18px; display: flex; max-width: min(360px, calc(100% - 36px)); align-items: center; gap: 11px; padding: 11px 15px; border: 2px solid #fff1b5; border-radius: 17px; background: rgba(7,58,63,.94); color: #fff; box-shadow: 0 14px 34px rgba(2,22,24,.42); touch-action: pan-y; }
  .inline-game-launch i { flex: 0 0 auto; color: #ffd45b; font-size: 1.45rem; }
  .inline-game-launch span { display: grid; gap: 2px; }
  .inline-game-launch strong { font-size: .88rem; }
  .inline-game-launch small { color: rgba(255,255,255,.76); font-size: .68rem; line-height: 1.3; }
  .inline-game-launch:hover { transform: translateY(-2px); }
  .player-shell:fullscreen { width: 100vw; height: 100dvh; border: 0; border-radius: 0; box-shadow: none; }
  .player-shell:fullscreen iframe { width: 100%; height: 100%; min-height: 100%; pointer-events: auto; }
  .player-shell:fullscreen .inline-game-launch { display: none; }
  :global(html.game-fullscreen-active), :global(body.game-fullscreen-active) { height: 100%; overflow: hidden !important; overscroll-behavior: none; }
  .local-note { display: flex; align-items: flex-start; gap: 9px; margin: 15px 4px 0; color: rgba(255,255,255,.72); font-size: .78rem; }
  .local-note i { flex: 0 0 auto; margin-top: 2px; color: #75e2a4; font-size: 1rem; }
  .game-info-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 18px; }
  .info-card { display: flex; gap: 15px; padding: 22px; border: 1px solid rgba(255,255,255,.14); border-radius: 20px; background: linear-gradient(145deg, rgba(20,83,88,.74), rgba(7,51,56,.72)); color: #fff; box-shadow: 0 18px 44px rgba(2,20,22,.2); backdrop-filter: blur(12px); }
  .info-icon { display: grid; flex: 0 0 auto; width: 42px; height: 42px; place-items: center; border-radius: 13px; background: #ffd14b; color: #704000; font-size: 1.3rem; }
  .info-card h2 { font-size: 1.08rem; }
  .info-card p { margin-top: 6px; color: rgba(255,255,255,.76); font-size: .88rem; }
  @media (max-width: 980px) { .game-info-grid { grid-template-columns: 1fr; } }
  @media (max-width: 820px) {
    .game-heading { align-items: flex-start; flex-direction: column; }
    .heading-actions { width: 100%; }
    .fullscreen-link { justify-content: center; flex: 1; min-height: 44px; }
    .back-link { display: none; }
    .player-shell iframe { height: min(730px, calc(100dvh - 155px)); min-height: 600px; pointer-events: none; }
    .player-shell:fullscreen iframe { pointer-events: auto; }
  }
  @media (max-width: 480px) {
    .game-page { padding-top: 22px; }
    .game-heading { gap: 18px; margin-top: 18px; }
    .player-shell { margin-inline: -12px; border-radius: 20px; }
    .player-shell iframe { min-height: 590px; }
    .inline-game-launch { right: 12px; bottom: 12px; left: 12px; max-width: none; justify-content: center; }
  }
</style>

<script>
  const playerShell = document.querySelector<HTMLElement>('[data-player-shell]');
  const gameFrame = document.querySelector<HTMLIFrameElement>('[data-game-frame]');
  const fullscreenTriggers = document.querySelectorAll<HTMLAnchorElement>('[data-fullscreen-trigger]');
  if (playerShell && gameFrame && fullscreenTriggers.length > 0) {
    const setFullscreenState = () => {
      const isFullscreen = document.fullscreenElement === playerShell;
      document.documentElement.classList.toggle('game-fullscreen-active', isFullscreen);
      document.body.classList.toggle('game-fullscreen-active', isFullscreen);
      if (isFullscreen) gameFrame.focus({ preventScroll: true });
    };
    const openGame = async (event: MouseEvent) => {
      event.preventDefault();
      try { await playerShell.requestFullscreen(); setFullscreenState(); }
      catch { window.location.assign((event.currentTarget as HTMLAnchorElement).href); }
    };
    fullscreenTriggers.forEach((trigger) => trigger.addEventListener('click', openGame));
    document.addEventListener('fullscreenchange', setFullscreenState);
  }
</script>
