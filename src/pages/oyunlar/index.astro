---
import BaseLayout from '../../layouts/BaseLayout.astro';

const exclusiveGames = [
  {
    title: 'Dino Ateşi: Üç Dünya',
    url: 'https://masalnova.com/oyna/dino-buz-cicekleri/',
  },
  {
    title: "Nasrettin Hoca'nın Pizzahanesi",
    url: 'https://masalnova.com/oyna/nasrettin-hoca-pizza/',
  },
  {
    title: 'Ay Işığı Bahçesi',
    url: 'https://masalnova.com/oyna/ay-isigi-bahcesi/',
  },
  {
    title: 'Bulut Fırını',
    url: 'https://masalnova.com/oyna/bulut-firini/',
  },
  {
    title: 'Kristal Saray',
    url: 'https://masalnova.com/oyna/kristal-saray/',
  },
  {
    title: 'Keloğlan & Karakaçan: Masal Yolu 3D',
    url: 'https://masalnova.com/oyna/keloglan-masal-yolu/',
  },
  {
    title: 'Keloğlan’ın Masal Hafızası',
    url: 'https://masalnova.com/oyna/keloglan-masal-hafizasi/',
  },
  {
    title: 'Keloğlan ve On Kapılı Saray',
    url: 'https://masalnova.com/oyna/keloglan-on-kapili-saray/',
  },
  {
    title: 'Horozumu Kaçırdılar: Çatı Kaçışı',
    url: 'https://masalnova.com/oyna/horozumu-kacirdilar/',
  },
  {
    title: 'Keloğlan: Uçan Tohumlar',
    url: 'https://masalnova.com/oyna/keloglan-ucan-tohumlar/',
  },
  {
    title: 'Keloğlan: Yıldız Peşinde',
    url: 'https://masalnova.com/oyna/keloglan-yildiz-pesinde/',
  },
];
const collectionGames = exclusiveGames;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://masalnova.com/oyunlar/#collection',
    name: 'Ücretsiz ve Eğitici Çocuk Oyunları',
    description: 'Çocuklar için Türkçe açıklamalı hafıza, dikkat, mantık, boyama ve beceri oyunları.',
    url: 'https://masalnova.com/oyunlar/',
    inLanguage: 'tr-TR',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: collectionGames.length,
      itemListElement: collectionGames.map((game, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: game.title,
        url: game.url,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
      { '@type': 'ListItem', position: 2, name: 'Oyunlar', item: 'https://masalnova.com/oyunlar/' },
    ],
  },
];
---
<BaseLayout
  title="Çocuk Oyunları: Ücretsiz ve Eğitici Oyunlar | MasalNova"
  description="Çocuklar için ücretsiz hafıza, dikkat, mantık, boyama ve beceri oyunlarını Türkçe açıklamalarla keşfet."
  path="/oyunlar/"
  image="/games/masal-ipleri/assets/moon-garden-cover.webp"
  imageAlt="MasalNova ücretsiz çocuk oyunları seçkisi"
  activeNav="oyunlar"
  allowAds={false}
  jsonLd={jsonLd}
>
  <section class="games-hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow"><i class="ph ph-sparkle" aria-hidden="true"></i> MasalNova Oyun Dünyası</span>
        <h1>Ücretsiz Çocuk Oyunları</h1>
        <p>3 yaş ve üzeri çocuklar için seçilmiş; hafıza, dikkat, yaratıcılık ve problem çözme becerilerini çalıştıran kısa oyunlar.</p>
      </div>
      <aside class="family-note">
        <i class="ph ph-shield-check" aria-hidden="true"></i>
        <div>
          <strong>Kontrollü oyun deneyimi</strong>
          <p>MasalNova oyunları doğrudan, aynı alan adı üzerinden ve oyun içi reklam olmadan açılır.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="games-section">
    <div class="container">
      <div class="exclusive-heading">
        <div>
          <span><i class="ph ph-seal-check" aria-hidden="true"></i> MasalNova’ya özel oyunlar</span>
          <h2>Tüm oyunlarımız tek bir yerde</h2>
        </div>
        <div class="portfolio-summary" aria-label={`${collectionGames.length} oyunluk MasalNova koleksiyonu`}>
          <strong><i class="ph ph-squares-four" aria-hidden="true"></i> {collectionGames.length} oyunun tamamı</strong>
          <small>MasalNova yapımı · Oyun içi reklam yok</small>
        </div>
      </div>

      <div class="originals-grid">
        <a class="exclusive-game dino-game" href="/oyna/dino-buz-cicekleri/" aria-label="Dino Ateşi Üç Dünya oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/dino-uc-dunya-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ · 3 DÜNYA</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 6–7 yaş</span></span>
            <h3>Dino Ateşi: Üç Dünya</h3>
            <p>Üç ayrı dünyada nişan al, kristal sırasını hatırla ve ateşi tam zamanında kullan.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-fire" aria-hidden="true"></i> Büyülü ateş</li>
              <li><i class="ph ph-brain" aria-hidden="true"></i> Hafıza &amp; timing</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Maceraya başla <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game pizza-game" href="/oyna/nasrettin-hoca-pizza/" aria-label="Nasrettin Hoca'nın Pizzahanesi oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/nasrettin-hoca-pizzahanesi-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ · PİZZA USTASI</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 6+ yaş</span></span>
            <h3>Nasrettin Hoca'nın Pizzahanesi</h3>
            <p>Siparişleri aklında tut, pizzaları hızla hazırla ve kusursuz servislerle kombo çarpanını büyüt.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-pizza" aria-hidden="true"></i> Pizza yapma</li>
              <li><i class="ph ph-timer" aria-hidden="true"></i> Zaman yarışı</li>
              <li><i class="ph ph-trophy" aria-hidden="true"></i> Puan &amp; kombo</li>
            </ul>
            <span class="exclusive-cta">Fırını aç <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game" href="/oyna/ay-isigi-bahcesi/" aria-label="Ay Işığı Bahçesi oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/ay-isigi-bahcesi-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ · 3 BÖLÜM</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 5+ yaş</span></span>
            <h3>Ay Işığı Bahçesi</h3>
            <p>İpleri kes, yıldızları topla ve ay damlasını Mimo’nun uyuyan ay çiçeğine ulaştır.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-scissors" aria-hidden="true"></i> Fizik bulmacası</li>
              <li><i class="ph ph-moon-stars" aria-hidden="true"></i> 3 bölüm</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Bahçeye gir <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game" href="/oyna/bulut-firini/" aria-label="Bulut Fırını oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/bulut-firini-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ · 3 BÖLÜM</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 5+ yaş</span></span>
            <h3>Bulut Fırını</h3>
            <p>İpleri doğru sırayla kes ve Pofur’un yıldız çöreğini bulutların üzerindeki sepete indir.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-scissors" aria-hidden="true"></i> Fizik bulmacası</li>
              <li><i class="ph ph-cloud-sun" aria-hidden="true"></i> 3 bölüm</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Fırını aç <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game" href="/oyna/kristal-saray/" aria-label="Kristal Saray oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/kristal-saray-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ · 3 BÖLÜM</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 5+ yaş</span></span>
            <h3>Kristal Saray</h3>
            <p>Büyülü asmaları kes, kristal yıldızları topla ve Mirza’nın su incisini çeşmeye ulaştır.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-scissors" aria-hidden="true"></i> Fizik bulmacası</li>
              <li><i class="ph ph-diamond" aria-hidden="true"></i> 3 bölüm</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Saraya gir <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game road-game" href="/oyna/keloglan-masal-yolu/" aria-label="Keloğlan ve Karakaçan Masal Yolu 3D oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/keloglan-masal-yolu-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ · 3D MACERA</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 6+ yaş</span></span>
            <h3>Keloğlan & Karakaçan: Masal Yolu 3D</h3>
            <p>Keloğlan ve Karakaçan’la değişen masal diyarlarından geç, üç mührü bul ve yıldız çayırını yeniden parlat.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-cube" aria-hidden="true"></i> 3D dünya</li>
              <li><i class="ph ph-mountains" aria-hidden="true"></i> Dinamik ortam</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Masal yoluna çık <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game memory-game" href="/oyna/keloglan-masal-hafizasi/" aria-label="Keloğlan’ın Masal Hafızası oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/keloglan-masal-hafizasi-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ · 6 BÖLÜM</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 4+ yaş</span></span>
            <h3>Keloğlan’ın Masal Hafızası</h3>
            <p>Masal kahramanlarını eşleştir, altı kapıyı aç ve altın sayfadaki sürprizi keşfet.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-brain" aria-hidden="true"></i> Hafıza</li>
              <li><i class="ph ph-cards" aria-hidden="true"></i> 6 bölüm</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Eşleri bul <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game palace-game" href="/oyna/keloglan-on-kapili-saray/" aria-label="Keloğlan ve On Kapılı Saray oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/keloglan-on-kapili-saray-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ · 10 BÖLÜM</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 6+ yaş</span></span>
            <h3>Keloğlan ve On Kapılı Saray</h3>
            <p>On gizemli kapıyı aç, her odadaki farklı bulmacayı çöz ve taht salonunda Keloğlan’ı bekleyen sırrı keşfet.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-puzzle-piece" aria-hidden="true"></i> 10 bulmaca</li>
              <li><i class="ph ph-book-open-text" aria-hidden="true"></i> Gizemli hikâye</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Saraya gir <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game chase-game" href="/oyna/horozumu-kacirdilar/" aria-label="Horozumu Kaçırdılar Çatı Kaçışı oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/horozumu-kacirdilar-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 6+ yaş</span></span>
            <h3>Horozumu Kaçırdılar</h3>
            <p>Havalı horozla çatılarda koş, mısırları topla ve peşindeki kararlı nineden kaç.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-arrows-out-line-vertical" aria-hidden="true"></i> Çift zıplama</li>
              <li><i class="ph ph-lightning" aria-hidden="true"></i> Turbo</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Kaçış başlasın <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game seed-game keloglan-seed-game" href="/oyna/keloglan-ucan-tohumlar/" aria-label="Keloğlan Uçan Tohumlar oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/keloglan-ucan-tohumlar-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 5+ yaş</span></span>
            <h3>Keloğlan: Uçan Tohumlar</h3>
            <p>Keloğlan’la tohum toplarını sapanla saksılara ulaştır, doğru açıyı bul ve üç Anadolu bahçesini çiçeklendir.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-smiley" aria-hidden="true"></i> Keloğlan</li>
              <li><i class="ph ph-flower-lotus" aria-hidden="true"></i> 3 bahçe</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Macera başlasın <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game" href="/oyna/keloglan-yildiz-pesinde/" aria-label="Keloğlan Yıldız Peşinde oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/masalnova-covers/keloglan-yildiz-pesinde-arcade-v2.webp" alt="" width="1448" height="1086" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-play-cue"><i class="ph ph-play-fill"></i> OYNA</span>
            <span class="exclusive-ribbon">YENİ</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals <span class="exclusive-age">· 6+ yaş</span></span>
            <h3>Keloğlan: Yıldız Peşinde</h3>
            <p>Keloğlan’la Anadolu köyünde koş, altın yıldızları topla ve geleneksel testilere çarpmadan en yüksek puana ulaş.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-hand-tap" aria-hidden="true"></i> 3 kez zıpla</li>
              <li><i class="ph ph-heart" aria-hidden="true"></i> 3 can</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Hemen oyna <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
  .games-hero { padding: 28px 0 18px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(280px, .5fr); gap: 24px; align-items: center; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px;
    border: 1px solid rgba(255,255,255,.3); border-radius: 999px;
    background: rgba(255,255,255,.13); color: #fff; font-size: .8rem; font-weight: 900;
  }
  h1 { max-width: 780px; margin-top: 10px; color: #fff; font-size: clamp(2.15rem, 5vw, 3.55rem); letter-spacing: -.05em; }
  .hero-grid > div > p { max-width: 720px; margin-top: 8px; color: rgba(255,255,255,.86); font-size: .95rem; }
  .family-note {
    display: flex; gap: 11px; padding: 14px 15px; border: 1px solid rgba(255,255,255,.24);
    border-radius: 17px; background: rgba(4,31,106,.43); color: #fff; backdrop-filter: blur(12px);
  }
  .family-note > i { flex: 0 0 auto; color: #ffd44d; font-size: 1.35rem; }
  .family-note strong { font-size: .82rem; }
  .family-note p { margin-top: 2px; color: rgba(255,255,255,.74); font-size: .72rem; line-height: 1.4; }
  .games-section { padding: 14px 0 58px; }
  .exclusive-heading { display: flex; align-items: end; justify-content: space-between; gap: 22px; margin-bottom: 18px; color: #fff; }
  .exclusive-heading span { display: inline-flex; align-items: center; gap: 6px; color: #ffd44d; font-size: .76rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
