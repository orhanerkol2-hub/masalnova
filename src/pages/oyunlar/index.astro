---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameCard from '../../components/GameCard.astro';
import { games } from '../../data/games.mjs';

const exclusiveGames = [
  {
    title: 'Keloğlan ve On Kapılı Saray',
    url: 'https://masalnova.com/oyna/keloglan-on-kapili-saray/',
  },
  {
    title: 'Horozumu Kaçırdılar: Çatı Kaçışı',
    url: 'https://masalnova.com/oyna/horozumu-kacirdilar/',
  },
  {
    title: 'Keloğlan: Uçan Tohumlar',
    url: 'https://masalnova.com/oyna/keloglan-ucan-tohumlar/',
  },
  {
    title: 'Keloğlan: Yıldız Peşinde',
    url: 'https://masalnova.com/oyna/keloglan-yildiz-pesinde/',
  },
];
const collectionGames = [...exclusiveGames, ...games.map((game) => ({ title: game.title, url: `https://masalnova.com/oyna/${game.slug}/` }))];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    '@id': 'https://masalnova.com/oyunlar/#collection',
    name: '3–8 Yaş Çocuklar İçin Ücretsiz Oyunlar',
    description: 'Türkçe açıklamalı, 3–8 yaş için seçilmiş hafıza, dikkat, mantık, boyama ve beceri oyunları.',
    url: 'https://masalnova.com/oyunlar/',
    inLanguage: 'tr-TR',
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: collectionGames.length,
      itemListElement: collectionGames.map((game, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: game.title,
        url: game.url,
      })),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
      { '@type': 'ListItem', position: 2, name: 'Oyunlar', item: 'https://masalnova.com/oyunlar/' },
    ],
  },
];
---
<BaseLayout
  title="3–8 Yaş Çocuklar İçin Ücretsiz Oyunlar | MasalNova"
  description="3–8 yaş için seçilen hafıza, dikkat, mantık, boyama ve beceri oyunlarını Türkçe açıklamalarla keşfet."
  path="/oyunlar/"
  activeNav="oyunlar"
  allowAds={false}
  jsonLd={jsonLd}
>
  <section class="games-hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow"><i class="ph ph-sparkle" aria-hidden="true"></i> MasalNova Oyun Dünyası</span>
        <h1>Oyna, düşün, keşfet</h1>
        <p>3–8 yaş arası çocuklar için seçilmiş; hafıza, dikkat, yaratıcılık ve problem çözme becerilerini çalıştıran kısa oyunlar.</p>
      </div>
      <aside class="family-note">
        <i class="ph ph-shield-check" aria-hidden="true"></i>
        <div>
          <strong>Kontrollü oyun deneyimi</strong>
          <p>MasalNova oyunları doğrudan ve reklamsız açılır. GamePix oyunları yalnızca açık onaydan sonra yüklenir.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="games-section">
    <div class="container">
      <div class="exclusive-heading">
        <div>
          <span><i class="ph ph-seal-check" aria-hidden="true"></i> MasalNova’ya özel oyunlar</span>
          <h2>Bizim masallarımız, bizim oyunlarımız</h2>
        </div>
        <p>GamePix bağlantısı yok · Oyun içi reklam yok</p>
      </div>

      <div class="originals-grid">
        <a class="exclusive-game palace-game" href="/oyna/keloglan-on-kapili-saray/" aria-label="Keloğlan ve On Kapılı Saray oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/keloglan-on-kapili-saray/assets/palace-story.webp" alt="" width="1600" height="900" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-ribbon">YENİ · 10 BÖLÜM</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals</span>
            <h3>Keloğlan ve On Kapılı Saray</h3>
            <p>On gizemli kapıyı aç, her odadaki farklı bulmacayı çöz ve taht salonunda Keloğlan’ı bekleyen sırrı keşfet.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-puzzle-piece" aria-hidden="true"></i> 10 bulmaca</li>
              <li><i class="ph ph-book-open-text" aria-hidden="true"></i> Gizemli hikâye</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Saraya gir <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game chase-game" href="/oyna/horozumu-kacirdilar/" aria-label="Horozumu Kaçırdılar Çatı Kaçışı oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/horozumu-kacirdilar/assets/village-rooftops.png" alt="" width="1536" height="1024" />
            <div class="exclusive-shade"></div>
            <img class="chase-grandma" src="/games/horozumu-kacirdilar/assets/grandma-runner.png" alt="" width="705" height="823" />
            <img class="chase-rooster" src="/games/horozumu-kacirdilar/assets/rooster-runner.png" alt="" width="717" height="844" />
            <span class="exclusive-ribbon">YENİ</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals</span>
            <h3>Horozumu Kaçırdılar</h3>
            <p>Havalı horozla çatılarda koş, mısırları topla ve peşindeki kararlı nineden kaç.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-arrows-out-line-vertical" aria-hidden="true"></i> Çift zıplama</li>
              <li><i class="ph ph-lightning" aria-hidden="true"></i> Turbo</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Kaçış başlasın <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game seed-game keloglan-seed-game" href="/oyna/keloglan-ucan-tohumlar/" aria-label="Keloğlan Uçan Tohumlar oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/keloglan-ucan-tohumlar/cover.jpg" alt="" width="1600" height="900" />
            <div class="exclusive-shade"></div>
            <span class="exclusive-ribbon">YENİ</span>
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals</span>
            <h3>Keloğlan: Uçan Tohumlar</h3>
            <p>Keloğlan’la tohum toplarını sapanla saksılara ulaştır, doğru açıyı bul ve üç Anadolu bahçesini çiçeklendir.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-smiley" aria-hidden="true"></i> Keloğlan</li>
              <li><i class="ph ph-flower-lotus" aria-hidden="true"></i> 3 bahçe</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Macera başlasın <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>

        <a class="exclusive-game" href="/oyna/keloglan-yildiz-pesinde/" aria-label="Keloğlan Yıldız Peşinde oyununu oyna">
          <div class="exclusive-visual" aria-hidden="true">
            <img class="exclusive-background" src="/games/keloglan-yildiz-pesinde/assets/anatolian-village-background.png" alt="" width="1600" height="900" />
            <div class="exclusive-shade"></div>
            <img class="exclusive-hero" src="/games/keloglan-yildiz-pesinde/assets/keloglan-runner.png" alt="" width="720" height="900" />
            <img class="exclusive-star star-one" src="/games/keloglan-yildiz-pesinde/assets/anatolian-star.png" alt="" width="512" height="512" />
            <img class="exclusive-star star-two" src="/games/keloglan-yildiz-pesinde/assets/anatolian-star.png" alt="" width="512" height="512" />
          </div>
          <div class="exclusive-copy">
            <span class="exclusive-label"><i class="ph ph-crown-simple" aria-hidden="true"></i> MasalNova Originals</span>
            <h3>Keloğlan: Yıldız Peşinde</h3>
            <p>Keloğlan’la Anadolu köyünde koş, altın yıldızları topla ve geleneksel testilere çarpmadan en yüksek puana ulaş.</p>
            <ul aria-label="Oyun özellikleri">
              <li><i class="ph ph-hand-tap" aria-hidden="true"></i> 3 kez zıpla</li>
              <li><i class="ph ph-heart" aria-hidden="true"></i> 3 can</li>
              <li><i class="ph ph-device-mobile" aria-hidden="true"></i> Mobil uyumlu</li>
            </ul>
            <span class="exclusive-cta">Hemen oyna <i class="ph ph-play-circle" aria-hidden="true"></i></span>
          </div>
        </a>
      </div>

      <div class="collection-divider"><span>GamePix seçkisi</span></div>

      <div class="section-title">
        <div>
          <span>3–8 yaş partner koleksiyonu</span>
          <h2>GamePix üzerinden seçilen oyunlar</h2>
        </div>
        <p>{games.length} oyun · Ücretsiz · Telefon, tablet ve bilgisayarda</p>
      </div>
      <div class="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>
      <div class="partner-note">
        <i class="ph ph-info" aria-hidden="true"></i>
        <p>Oyunlar GamePix iş ortaklığı üzerinden sunulur. Her oyun sayfasında sağlayıcı ve reklam bilgileri başlamadan önce gösterilir.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .games-hero { padding: clamp(44px, 7vw, 76px) 0 34px; }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(280px, .6fr); gap: 34px; align-items: end; }
  .eyebrow {
    display: inline-flex; align-items: center; gap: 8px; padding: 7px 12px;
    border: 1px solid rgba(255,255,255,.3); border-radius: 999px;
    background: rgba(255,255,255,.13); color: #fff; font-size: .8rem; font-weight: 900;
  }
  h1 { max-width: 780px; margin-top: 16px; color: #fff; font-size: clamp(2.35rem, 7vw, 5.1rem); letter-spacing: -.055em; }
  .hero-grid > div > p { max-width: 660px; margin-top: 16px; color: rgba(255,255,255,.86); font-size: clamp(1rem, 2vw, 1.22rem); }
  .family-note {
    display: flex; gap: 14px; padding: 19px; border: 1px solid rgba(255,255,255,.24);
    border-radius: 22px; background: rgba(4,31,106,.43); color: #fff; backdrop-filter: blur(12px);
  }
  .family-note > i { flex: 0 0 auto; color: #ffd44d; font-size: 1.75rem; }
  .family-note strong { font-size: .96rem; }
  .family-note p { margin-top: 4px; color: rgba(255,255,255,.74); font-size: .82rem; line-height: 1.45; }
  .games-section { padding: 24px 0 58px; }
  .exclusive-heading { display: flex; align-items: end; justify-content: space-between; gap: 22px; margin-bottom: 18px; color: #fff; }
  .exclusive-heading span { display: inline-flex; align-items: center; gap: 6px; color: #ffd44d; font-size: .76rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .exclusive-heading h2 { margin-top: 3px; font-size: clamp(1.7rem, 4vw, 2.45rem); }
  .exclusive-heading > p { color: rgba(255,255,255,.74); font-size: .86rem; font-weight: 800; }
  .originals-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .exclusive-game { display: grid; grid-template-rows: auto 1fr; overflow: hidden; border: 1px solid rgba(255,225,120,.72); border-radius: 28px; background: #fff9e8; color: #102a66; box-shadow: 0 28px 64px rgba(2,24,82,.32); transition: transform .2s ease, box-shadow .2s ease; }
  .exclusive-game:hover { transform: translateY(-4px); box-shadow: 0 34px 74px rgba(2,24,82,.39); }
  .exclusive-visual { position: relative; min-height: 0; aspect-ratio: 16 / 9; overflow: hidden; background: #91c9d7; }
  .exclusive-background { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 45% center; transition: transform .5s ease; }
  .exclusive-game:hover .exclusive-background { transform: scale(1.025); }
  .exclusive-shade { position: absolute; inset: 0; background: linear-gradient(90deg, transparent 48%, rgba(9,39,74,.38)), linear-gradient(0deg, rgba(6,33,67,.3), transparent 48%); }
  .exclusive-hero { position: absolute; left: 2%; bottom: -8%; width: min(42%, 310px); height: 100%; object-fit: contain; object-position: center bottom; filter: drop-shadow(0 18px 22px rgba(24,35,43,.34)); transition: transform .28s ease; }
  .exclusive-game:hover .exclusive-hero { transform: translateY(-5px) rotate(-1deg); }
  .seed-game .exclusive-background { object-position: center; }
  .seed-game .exclusive-shade { background: linear-gradient(0deg, rgba(6,33,67,.22), transparent 45%); }
  .palace-game .exclusive-background { object-position: center; }
  .palace-game .exclusive-shade { background: linear-gradient(0deg, rgba(3,15,43,.42), transparent 58%); }
  .chase-game .exclusive-background { object-position: center 70%; }
  .chase-game .exclusive-shade { background: linear-gradient(0deg, rgba(9,33,64,.35), transparent 55%); }
  .chase-rooster, .chase-grandma { position: absolute; height: auto; object-fit: contain; filter: drop-shadow(0 12px 13px rgba(19,34,47,.34)); transition: transform .28s ease; }
  .chase-rooster { right: -2%; bottom: -9%; width: 45%; }
  .chase-grandma { left: -4%; bottom: -6%; width: 42%; }
  .chase-game:hover .chase-rooster { transform: translate(4px, -5px) rotate(-2deg); }
  .chase-game:hover .chase-grandma { transform: translate(5px, -3px) rotate(1deg); }
  .exclusive-star { position: absolute; width: clamp(50px, 7vw, 86px); height: auto; filter: drop-shadow(0 8px 9px rgba(104,63,0,.28)); animation: star-float 2.6s ease-in-out infinite; }
  .star-one { top: 13%; left: 43%; }
  .star-two { top: 44%; left: 69%; width: clamp(42px, 6vw, 70px); animation-delay: -.9s; }
  .exclusive-ribbon { position: absolute; top: 16px; right: 16px; padding: 7px 12px; border: 1px solid rgba(255,255,255,.56); border-radius: 999px; background: #c9473c; color: #fff; font-size: .72rem; font-weight: 900; letter-spacing: .08em; box-shadow: 0 8px 20px rgba(73,25,20,.22); }
  .exclusive-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(24px, 4vw, 42px); background: radial-gradient(circle at 100% 0, rgba(255,199,50,.22), transparent 40%), #fff9e8; }
  .exclusive-label { display: inline-flex; align-self: flex-start; align-items: center; gap: 7px; padding: 6px 10px; border-radius: 999px; background: #ffe69b; color: #774700; font-size: .73rem; font-weight: 900; }
  .exclusive-copy h3 { margin-top: 14px; color: #0b2b75; font-size: clamp(1.65rem, 3.2vw, 2.55rem); letter-spacing: -.035em; }
  .exclusive-copy > p { margin-top: 11px; color: #53617b; font-size: .95rem; line-height: 1.55; }
  .exclusive-copy ul { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; list-style: none; }
  .exclusive-copy li { display: inline-flex; align-items: center; gap: 5px; padding: 5px 9px; border-radius: 999px; background: #edf3ff; color: #1d51b8; font-size: .72rem; font-weight: 900; }
  .exclusive-cta { display: inline-flex; align-self: flex-start; align-items: center; gap: 9px; margin-top: 23px; padding: 12px 18px; border-radius: 999px; background: linear-gradient(90deg, #ffc62e, #ff9b1f); color: #562f00; font-weight: 900; box-shadow: 0 10px 24px rgba(255,156,31,.27); }
  .exclusive-cta i { font-size: 1.2rem; }
  .collection-divider { display: flex; align-items: center; gap: 14px; margin: 36px 0 24px; color: rgba(255,255,255,.68); font-size: .72rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .collection-divider::before, .collection-divider::after { content: ''; flex: 1; height: 1px; background: rgba(255,255,255,.22); }
  .section-title { display: flex; align-items: end; justify-content: space-between; gap: 22px; margin-bottom: 20px; color: #fff; }
  .section-title span { color: #ffd44d; font-size: .76rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .section-title h2 { margin-top: 3px; font-size: clamp(1.7rem, 4vw, 2.45rem); }
  .section-title > p { color: rgba(255,255,255,.74); font-size: .88rem; font-weight: 800; }
  .games-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; }
  .partner-note {
    display: flex; align-items: flex-start; gap: 11px; margin-top: 24px; padding: 15px 18px;
    border: 1px solid rgba(255,255,255,.2); border-radius: 16px; background: rgba(255,255,255,.1);
    color: rgba(255,255,255,.78); font-size: .83rem;
  }
  .partner-note i { margin-top: 2px; color: #ffd44d; font-size: 1.2rem; }
  @media (min-width: 721px) {
    .games-hero,
    .games-section { background: #fbf8f1; color: #102a66; }
    .games-hero { padding: 38px 0 22px; }
    .games-section { padding: 18px 0 68px; }
    .games-hero .container,
    .games-section .container { max-width: 1260px; }
    .eyebrow { border-color: #e5d9b5; background: #fff7dc; color: #8b6307; }
    h1 { margin-top: 10px; color: #0b2b75; font-size: clamp(2.2rem, 4.2vw, 3.6rem); }
    .hero-grid > div > p { margin-top: 11px; color: #667188; font-size: 1rem; }
    .family-note {
      border-color: #ded9ce;
      background: #fff;
      color: #173574;
      box-shadow: 0 12px 30px rgba(23,43,92,.08);
      backdrop-filter: none;
    }
    .family-note > i { color: #1749ae; }
    .family-note p { color: #69748a; }
    .exclusive-heading { color: #0b2b75; }
    .exclusive-heading span { color: #a87906; }
    .exclusive-heading > p { color: #6c7690; }
    .exclusive-game { border-color: #e4c45d; box-shadow: 0 22px 50px rgba(23,43,92,.13); }
    .exclusive-game:hover { box-shadow: 0 28px 62px rgba(23,43,92,.18); }
    .collection-divider { color: #788299; }
    .collection-divider::before, .collection-divider::after { background: #dcd7cc; }
    .section-title { color: #0b2b75; }
    .section-title span { color: #a87906; }
    .section-title > p { color: #6c7690; }
    .games-grid { gap: 16px; }
    .partner-note { border-color: #ded9ce; background: #fff; color: #68728a; }
    .partner-note i { color: #1749ae; }
  }
  @media (max-width: 920px) {
    .hero-grid { grid-template-columns: 1fr; }
    .family-note { max-width: 620px; }
    .originals-grid { grid-template-columns: 1fr; }
    .exclusive-visual { min-height: 0; }
    .exclusive-copy { padding: 28px; }
    .games-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .games-hero { padding-top: 34px; }
    .exclusive-heading { align-items: flex-start; flex-direction: column; gap: 7px; }
    .originals-grid { gap: 16px; }
    .exclusive-game { border-radius: 22px; }
    .exclusive-visual { min-height: 0; }
    .exclusive-hero { width: 46%; }
    .star-one { left: 49%; }
    .star-two { left: 72%; }
    .exclusive-copy { padding: 23px 20px 24px; }
    .exclusive-copy > p { font-size: .9rem; }
    .exclusive-cta { align-self: stretch; justify-content: center; min-height: 48px; }
    .collection-divider { margin-top: 30px; }
    .section-title { align-items: flex-start; flex-direction: column; gap: 7px; }
    .games-grid { grid-template-columns: 1fr; }
  }

  @keyframes star-float {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-8px) rotate(4deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .exclusive-star { animation: none; }
    .exclusive-game, .exclusive-background, .exclusive-hero { transition: none; }
  }
</style>
