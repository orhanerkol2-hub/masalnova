<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter-button]');
  const gameCards = document.querySelectorAll<HTMLElement>('[data-game-card]');
  const visibleCount = document.querySelector<HTMLElement>('[data-visible-count]');

  filterButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filterButton || 'all';
      let count = 0;

      filterButtons.forEach((item) => {
        const active = item === button;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });

      gameCards.forEach((card) => {
        const visible = filter === 'all' || card.dataset.filter === filter;
        card.hidden = !visible;
        if (visible) count += 1;
      });

      if (visibleCount) visibleCount.textContent = String(count);
    });
  });
</script>
