---
import CategoryListingPage from '../../components/CategoryListingPage.astro';
import { getIslamicStories } from '../../data/stories';
import { islamicStorySection } from '../../data/taxonomy';
import { CATEGORY_PAGE_SIZE, categorySeoCopy } from '../../data/category-pages';

const allStories = await getIslamicStories();
const pageCount = Math.max(1, Math.ceil(allStories.length / CATEGORY_PAGE_SIZE));
---

<CategoryListingPage
  category={islamicStorySection}
  copy={categorySeoCopy[islamicStorySection.key]}
  stories={allStories.slice(0, CATEGORY_PAGE_SIZE)}
  totalStories={allStories.length}
  page={1}
  pageCount={pageCount}
/>
