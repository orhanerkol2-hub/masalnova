---
import CategoryListingPage from '../../../../components/CategoryListingPage.astro';
import { getMasalStories } from '../../../../data/stories';
import { storyCategories } from '../../../../data/taxonomy';
import { CATEGORY_PAGE_SIZE, categorySeoCopy } from '../../../../data/category-pages';

export async function getStaticPaths() {
  return storyCategories.map((category) => ({ params: { category: category.key }, props: { category } }));
}

const { category } = Astro.props;
const allStories = await getMasalStories();
const matchingStories = allStories.filter((story) => story.data.categories.includes(category.key));
const pageCount = Math.max(1, Math.ceil(matchingStories.length / CATEGORY_PAGE_SIZE));
---
<CategoryListingPage category={category} copy={categorySeoCopy[category.key]} stories={matchingStories.slice(0, CATEGORY_PAGE_SIZE)} totalStories={matchingStories.length} page={1} pageCount={pageCount} />
