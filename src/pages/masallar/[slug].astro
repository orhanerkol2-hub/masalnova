---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CoverThumb from '../../components/CoverThumb.astro';
import VideoCard from '../../components/VideoCard.astro';
import StoryCard from '../../components/StoryCard.astro';
import ReadingToolbar from '../../components/ReadingToolbar.astro';
import { getAllStories, getStories, isIslamicStory, storyPath } from '../../data/stories';
import { videoById } from '../../data/videos';
import { getStoryAuthor, storyReviewers } from '../../data/authors';
import { ageLabel, storyCategoryLabel } from '../../data/taxonomy';
import { compactDescription, formatTurkishDate, storySeoTitle } from '../../lib/seo';
import { isStoryContentSubstantial, minimumStoryWordCount, storyWordCount } from '../../lib/story-quality.mjs';

export async function getStaticPaths() {
  const stories = await getAllStories();
  return stories
    .filter((story) => !isIslamicStory(story))
    .map((story) => ({ params: { slug: story.id }, props: { story } }));
}

const { story } = Astro.props;
const d = story.data;
const author = getStoryAuthor(d.author);
const isIslamic = isIslamicStory(story);
const wordCount = storyWordCount(story.body);
const minimumWordCount = minimumStoryWordCount(d);
const isPubliclyEligible = d.editorialStatus === 'approved'
  && isStoryContentSubstantial(story.body, d);
const { Content } = await render(story);

const allStories = await getStories();
const related = d.relatedVideoIds.map((id) => videoById(id)).filter(Boolean);
const overlapCount = (left: string[], right: string[]) => {
  const normalizedRight = new Set(right.map((value) => value.toLocaleLowerCase('tr')));
  return left.filter((value) => normalizedRight.has(value.toLocaleLowerCase('tr'))).length;
};
const relevanceScore = (candidate: (typeof allStories)[number]) =>
  overlapCount(candidate.data.characters, d.characters) * 12
  + overlapCount(candidate.data.themes, d.themes) * 8
  + overlapCount(candidate.data.ageGroups, d.ageGroups) * 5
  + overlapCount(candidate.data.categories, d.categories) * 3
  + (Math.abs(candidate.data.readingTime - d.readingTime) <= 1 ? 3 : 0)
  + (candidate.data.isPopular ? 1 : 0);
const moreStories = allStories
  .filter((candidate) => candidate.id !== story.id
    && relevanceScore(candidate) > 0
    && isIslamicStory(candidate) === isIslamic)
  .sort((a, b) => relevanceScore(b) - relevanceScore(a) || b.data.publishedAt.localeCompare(a.data.publishedAt))
  .slice(0, 4);
const primaryCategory = d.categories[0];
const primaryCategoryLabel = isIslamic
  ? 'İslami Hikâyeler'
  : primaryCategory ? storyCategoryLabel(primaryCategory) : 'Masallar';
const storyPagePath = storyPath(story);
const storyUrl = `https://masalnova.com${storyPagePath}`;
const storyImage = d.coverImage ? `https://masalnova.com${d.coverImage}` : 'https://masalnova.com/logo.png';
// Keep editorial dates as the exact calendar dates stored in frontmatter.
// Adding a synthetic midnight/timezone can shift the visible date in Google,
// and falling back to publishedAt would claim an update that never happened.
const publishedIso = d.publishedAt;
const modifiedIso = d.modifiedAt;
const publishedLabel = formatTurkishDate(d.publishedAt);
const modifiedLabel = d.modifiedAt ? formatTurkishDate(d.modifiedAt) : undefined;
const seoDescription = compactDescription(d.shortDescription);
const ageRange = d.audienceLabel ?? d.ageGroups.map(ageLabel).join(' ve ');
const seoTitle = d.seoTitle ?? (isIslamic
  ? `${d.title}${ageRange ? ` (${ageRange})` : ''} – Çocuklar İçin İslami Hikâye | MasalNova`
  : storySeoTitle(`${d.title}${ageRange ? ` (${ageRange})` : ''}`));
const primaryTheme = d.themes[0] ?? 'hikâyenin ana fikri';
const ageBounds = d.ageGroups.flatMap((group) => group.split('-').map(Number)).filter(Number.isFinite);
const suggestedMinAge = ageBounds.length ? Math.min(...ageBounds) : undefined;
const suggestedMaxAge = ageBounds.length ? Math.max(...ageBounds) : undefined;
const emotionalIntensity = d.categories.includes('uyku') || d.themes.some((theme) => /sakin|huzur|şefkat|sevgi/iu.test(theme))
  ? 'Sakin'
  : d.themes.some((theme) => /korku|cesaret|macera|kayıp/iu.test(theme)) ? 'Orta' : 'Yumuşak';
const storyType = isIslamic ? 'Kaynaklı İslami çocuk hikâyesi' : primaryCategory ? storyCategoryLabel(primaryCategory) : 'Çocuk masalı';
const sourceTypeLabel = d.sourceType === 'quran'
  ? "Kur'an-ı Kerim"
  : d.sourceType === 'hadith'
    ? 'Hadis rivayeti'
    : d.sourceType === 'sira' ? 'Siyer kaynağı' : 'Kaynak';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    '@id': `${storyUrl}#article`,
    url: storyUrl,
    headline: d.title,
    description: seoDescription,
    image: [storyImage],
    inLanguage: 'tr-TR',
    datePublished: publishedIso,
    dateModified: modifiedIso,
    isAccessibleForFree: true,
    articleSection: isIslamic ? ['İslami Hikâyeler'] : d.categories.map(storyCategoryLabel),
    genre: isIslamic ? ['İslami Hikâyeler'] : d.categories.map(storyCategoryLabel),
    keywords: (d.seoKeywords.length
      ? d.seoKeywords
      : [...d.themes, ...d.categories.map(storyCategoryLabel)]).join(', '),
    timeRequired: `PT${d.readingTime}M`,
    about: d.themes.map((theme) => ({ '@type': 'Thing', name: theme })),
    audience: suggestedMinAge !== undefined && suggestedMaxAge !== undefined ? {
      '@type': 'PeopleAudience',
      suggestedMinAge,
      suggestedMaxAge,
    } : undefined,
    author: {
      '@type': 'Person',
      '@id': `https://masalnova.com${author.profilePath}#person`,
      name: author.name,
      url: `https://masalnova.com${author.profilePath}`,
    },
    editor: storyReviewers.map((reviewer) => ({
      '@type': 'Person',
      '@id': `https://masalnova.com${reviewer.profilePath}#person`,
      name: reviewer.name,
      url: `https://masalnova.com${reviewer.profilePath}`,
    })),
    publisher: { '@id': 'https://masalnova.com/#organization' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': storyUrl },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: isIslamic
      ? [
          { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
          { '@type': 'ListItem', position: 2, name: 'İslami Hikâyeler', item: 'https://masalnova.com/islami-hikayeler/' },
          { '@type': 'ListItem', position: 3, name: d.title, item: storyUrl },
        ]
      : [
          { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
          { '@type': 'ListItem', position: 2, name: 'Masallar', item: 'https://masalnova.com/masallar/' },
          ...(primaryCategory ? [{ '@type': 'ListItem', position: 3, name: primaryCategoryLabel, item: `https://masalnova.com/masallar/kategori/${primaryCategory}/` }] : []),
          { '@type': 'ListItem', position: primaryCategory ? 4 : 3, name: d.title, item: storyUrl },
        ],
  },
];
---
<BaseLayout
  title={seoTitle}
  description={seoDescription}
  path={storyPagePath}
  image={d.coverImage}
  imageAlt={d.altText ?? `${d.title} resimli ${isIslamic ? 'hikâye' : 'masal'} kapağı`}
  ogType="article"
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  preloadImage={d.coverImage}
  jsonLd={isPubliclyEligible ? jsonLd : undefined}
  activeNav={isIslamic ? 'islami' : 'masallar'}
  readerPage
  allowAds={false}
  robots={isPubliclyEligible ? undefined : 'noindex, follow'}
>
  <ReadingToolbar
    backHref={isIslamic ? '/islami-hikayeler/' : '/masallar/'}
    backLabel={isIslamic ? 'İslami hikâyelere dön' : 'Masallara dön'}
    audioSrc={d.audioUrl}
    storyId={story.id}
  />

  <section class:list={['story-page', { 'story-page--islami': isIslamic }]}>
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Ana Sayfa</a> <span>›</span>
        {isIslamic
          ? <a href="/islami-hikayeler/">İslami Hikâyeler</a>
          : <><a href="/masallar/">Masallar</a>{primaryCategory && <><span>›</span><a href={`/masallar/kategori/${primaryCategory}/`}>{primaryCategoryLabel}</a></>}</>}
        <span>›</span> <span>{d.title}</span>
      </nav>

      <div class="reader-shell">
        <article class="reader" data-reader-article>
          <header class="reader__header">
            <span class="reader__eyebrow">{isIslamic ? 'MasalNova · Kaynaklı İslami hikâye' : 'MasalNova Reader'}</span>
            <h1 class="reader__title">{d.title}</h1>
            <p class="reader__description">{d.shortDescription}</p>
            {isIslamic && d.sourceCitation && (
              <aside class="reader-source" aria-label="Hikâyenin kaynağı">
                <i class={`ph ph-${d.sourceType === 'quran' ? 'book-open-text' : d.sourceType === 'hadith' ? 'quotes' : 'scroll'}`} aria-hidden="true"></i>
                <div>
                  <span>{sourceTypeLabel}</span>
                  <strong>{d.sourceCitation}</strong>
                  <small>Metin, çocukların yaşına göre sadeleştirilmiş kaynak anlatımıdır.</small>
                </div>
                {d.sourceUrl && <a href={d.sourceUrl} target="_blank" rel="noopener noreferrer">Kaynağı aç <span class="sr-only">(yeni sekmede açılır)</span> <i class="ph ph-arrow-square-out" aria-hidden="true"></i></a>}
              </aside>
            )}
            <div class="reader__meta">
              {d.audienceLabel
                ? <span>{d.audienceLabel}</span>
                : d.ageGroups.map((a) => <span>{ageLabel(a)}</span>)}
              <span aria-hidden="true">·</span>
              <span>{d.readingTime} dk okuma</span>
              {isIslamic
                ? <><span aria-hidden="true">·</span><a href="/islami-hikayeler/">İslami Hikâyeler</a></>
                : d.categories.map((c) => (
                    <>
                      <span aria-hidden="true">·</span>
                      <a href={`/masallar/kategori/${c}/`}>{storyCategoryLabel(c)}</a>
                    </>
                  ))}
            </div>
            <p class="reader__byline">
              <span>Yazan: <a href={author.profilePath}>{author.name}</a></span>
              <span aria-hidden="true">·</span>
              {d.editorialStatus === 'approved'
                ? <span>
                    Editoryal inceleme:
                    {' '}<a href="/yazarlar/aylin-karabektas/">Aylin Karabektaş</a>
                    {' '}ve{' '}<a href="/yazarlar/muhammet-karayigit/">Muhammet Karayiğit</a>
                  </span>
                : <span data-nosnippet>
                    Güncel metin yeniden editoryal inceleme bekliyor
                  </span>}
              <span aria-hidden="true">·</span>
              <span>Yayınlandı: <time datetime={publishedIso}>{publishedLabel}</time></span>
              {modifiedIso && modifiedLabel && (
                <>
                  <span aria-hidden="true">·</span>
                  <span>Güncellendi: <time datetime={modifiedIso}>{modifiedLabel}</time></span>
                </>
              )}
            </p>
            <figure class="reader__cover">
              <CoverThumb
                emoji={d.coverEmoji}
                color={d.coverColor}
                image={d.coverImage}
                alt={d.altText ?? d.title}
                ratio="16 / 9"
                big
                loading="eager"
                fetchpriority="high"
                sizes="(max-width: 860px) 100vw, 760px"
              />
            </figure>
          </header>

          <section class="reader__content">
            <Content />
          </section>
          {!isPubliclyEligible && (
            <aside class="archive-note" data-nosnippet>
              <strong>{d.editorialStatus === 'approved' ? 'Kısa arşiv anlatımı' : 'Güncel metin incelemede'}</strong>
              {d.editorialStatus === 'approved'
                ? <p>Bu {isIslamic ? 'hikâye' : 'masal'} ({wordCount}/{minimumWordCount} kelime) editoryal olarak yeniden geliştiriliyor. Bu süreçte arama dizinine ve reklamlara kapalıdır.</p>
                : <p>Bu {isIslamic ? 'hikâyenin' : 'masalın'} güncellenen metni Aylin Karabektaş ve Muhammet Karayiğit’in yeniden incelemesini bekliyor. Bu süreçte arama dizinine, önerilere ve reklamlara kapalıdır.</p>}
            </aside>
          )}
        </article>
      </div>

      <section class="story-guide" aria-labelledby="story-guide-title">
        <p class="story-guide__kicker">Ebeveynler için</p>
        <h2 id="story-guide-title">{isIslamic ? 'Bu hikâye ne anlatıyor?' : 'Bu masal ne anlatıyor?'}</h2>
        <p>
          Bu resimli {isIslamic ? 'hikâye' : 'masal'} MasalNova’da <strong>{ageRange || 'çocuklar'}</strong> için etiketlenmiştir ve birlikte okunduğunda yaklaşık <strong>{d.readingTime} dakika</strong> sürer. Hikâyede {d.themes.length ? d.themes.join(', ') : 'dostluk ve hayal gücü'} temaları öne çıkar.
        </p>
        <dl>
          <div><dt>Yaş</dt><dd>{ageRange || 'Her yaş'}</dd></div>
          <div><dt>Süre</dt><dd>{d.readingTime} dakika</dd></div>
          <div><dt>Konu</dt><dd>{d.themes.slice(0, 3).join(' · ') || primaryCategoryLabel}</dd></div>
          <div><dt>{isIslamic ? 'Hikâye türü' : 'Masal türü'}</dt><dd>{storyType}</dd></div>
          <div><dt>Duygusal yoğunluk</dt><dd>{emotionalIntensity}</dd></div>
        </dl>
        <div class="story-prompts">
          <h3>Okuma sonrası birlikte konuşun</h3>
          {isIslamic
            ? <ul>
                <li>Bu anlatıda Allah'ın hangi nimeti veya yardımı hatırlatılıyor?</li>
                <li>{primaryTheme} bu hikâyede nasıl gösteriliyor?</li>
                <li>Bugün bu güzel davranıştan hangisini uygulayabiliriz?</li>
              </ul>
            : <ul>
                <li>Kahramanın yerinde olsaydın hangi kararı verirdin?</li>
                <li>Bu masalda {primaryTheme} neden önemliydi?</li>
                <li>Hikâyenin en çok hangi bölümünü sevdin?</li>
              </ul>}
        </div>
        <a class="editorial-link" href="/yayin-ilkeleri/">MasalNova’nın yayın ve içerik ilkeleri <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
      </section>

      {d.themes.length > 0 && (
        <div class="themes">
          {d.themes.map((t) => <span class="tag tag-ghost">#{t}</span>)}
        </div>
      )}

      {related.length > 0 && (
        <section class="watch">
          <h2>İzlemek ister misiniz?</h2>
          <p>Bu {isIslamic ? 'hikâyeyi' : 'masalı'} sevdiyseniz, ilgili videoyu da izleyebilirsiniz.</p>
          <div class="grid grid-3">
            {related.map((v) => <VideoCard video={v!} />)}
          </div>
        </section>
      )}

      {moreStories.length > 0 && (
        <section class="more">
          <h2>Teması ve yaş düzeyi benzer {isIslamic ? 'İslami hikâyeler' : 'masallar'}</h2>
          <div class="grid grid-3">
            {moreStories.map((s) => <StoryCard story={s} />)}
          </div>
        </section>
      )}

      <div class="back"><a class="btn btn-ghost" href={isIslamic ? '/islami-hikayeler/' : '/masallar/'}>← {isIslamic ? 'Tüm İslami Hikâyeler' : 'Tüm Masalları Oku'}</a></div>
    </div>
  </section>
</BaseLayout>

<style>
  .story-page {
    padding: 22px 0 10px;
    background: var(--reader-background);
    color: var(--reader-text-color);
  }
  .story-page--islami {
    background:
      linear-gradient(color-mix(in srgb, var(--reader-background) 90%, transparent), color-mix(in srgb, var(--reader-background) 94%, transparent)),
      url('/islamic/islami-hikayeler-background.webp') center top / cover fixed no-repeat;
  }
  .crumbs {
    max-width: var(--reader-content-width);
    margin: 0 auto 18px;
    color: var(--reader-text-soft);
    font-weight: 700;
    font-size: .9rem;
  }
  .crumbs a { color: var(--reader-accent); }
  .crumbs a:hover { text-decoration: underline; }
  .crumbs span { opacity: .7; margin: 0 4px; }

  .reader-shell,
  .story-guide,
  .themes,
  .watch,
  .more,
  .back {
    max-width: var(--reader-content-width);
    margin-left: auto;
    margin-right: auto;
  }

  .reader {
    padding: clamp(22px, 5vw, 42px) clamp(18px, 5vw, 24px) 8px;
  }
  .story-page--islami .reader {
    border: 1px solid var(--reader-border);
    border-radius: 28px;
    background: color-mix(in srgb, var(--reader-surface) 96%, transparent);
    box-shadow: 0 24px 65px rgba(11,42,77,.1);
  }

  .reader__header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--reader-border);
  }

  .reader__eyebrow {
    display: inline-flex;
    margin-bottom: 0.85rem;
    color: var(--reader-accent);
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .reader__title {
    margin-bottom: 0.75rem;
    font-family: var(--reader-font-family);
    font-size: calc(var(--reader-font-size) * 1.75);
    line-height: 1.22;
    color: var(--reader-text-color);
  }

  .reader__description {
    margin-bottom: 1rem;
    color: var(--reader-text-soft);
    font-size: 1.06rem;
    line-height: 1.55;
  }

  .reader-source {
    display: grid;
    grid-template-columns: auto minmax(0,1fr) auto;
    gap: 12px;
    align-items: center;
    margin: 1rem 0;
    padding: 14px 15px;
    border: 1px solid color-mix(in srgb, var(--reader-accent) 24%, var(--reader-border));
    border-radius: 16px;
    background: color-mix(in srgb, var(--reader-accent) 7%, var(--reader-surface));
  }
  .reader-source > i { color: var(--reader-accent); font-size: 1.55rem; }
  .reader-source div { display: grid; gap: 1px; min-width: 0; }
  .reader-source span { color: var(--reader-accent); font-size: .67rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .reader-source strong { color: var(--reader-text-color); font-size: .84rem; line-height: 1.4; }
  .reader-source small { color: var(--reader-text-soft); font-size: .71rem; line-height: 1.4; }
  .reader-source a { display:inline-flex; gap:5px; align-items:center; color:var(--reader-accent); font-size:.72rem; font-weight:850; white-space:nowrap; }
  .reader-source a:hover { text-decoration: underline; }

  .reader__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
    color: var(--reader-text-soft);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .reader__byline {
    display: flex;
    flex-wrap: wrap;
    gap: .45rem;
    margin-top: .75rem;
    color: var(--reader-text-soft);
    font-size: .76rem;
    font-weight: 700;
  }
  .reader__byline a { color: var(--reader-accent); }
  .reader__byline a:hover { text-decoration: underline; }

  .reader__cover {
    margin: 1.5rem 0 0;
    overflow: hidden;
    border: 1px solid var(--reader-border);
    border-radius: 24px;
    background: var(--reader-surface);
    box-shadow: 0 20px 50px rgba(10, 24, 55, 0.14);
  }

  .reader__content {
    color: var(--reader-text-color);
    font-family: var(--reader-font-family);
    font-size: var(--reader-font-size);
    line-height: var(--reader-line-height);
  }

  .reader__content :global(p) {
    margin: 0 0 calc(var(--reader-line-height) * 0.65em);
  }

  .reader__content :global(h2) {
    margin: 2.25em 0 0.75em;
    color: var(--reader-text-color);
    font-family: var(--reader-font-family);
    font-size: calc(var(--reader-font-size) * 1.25);
    line-height: 1.35;
  }

  .reader__content :global(strong) {
    color: var(--reader-accent);
  }

  .archive-note {
    margin: 24px 0 8px;
    padding: 15px 17px;
    border: 1px solid var(--reader-border);
    border-radius: 14px;
    background: var(--reader-surface-raised);
    color: var(--reader-text-soft);
    font-size: .84rem;
    line-height: 1.55;
  }
  .archive-note strong { color: var(--reader-text-color); }
  .archive-note p { margin: 4px 0 0; }

  .story-guide {
    margin-top: 28px;
    padding: clamp(22px, 5vw, 34px);
    border: 1px solid var(--reader-border);
    border-radius: 24px;
    background: var(--reader-surface);
    box-shadow: 0 18px 45px rgba(10,24,55,.08);
  }
  .story-guide__kicker { color: var(--reader-accent); font-size: .72rem; font-weight: 900; letter-spacing: .1em; text-transform: uppercase; }
  .story-guide h2 { margin-top: 7px; color: var(--reader-text-color); font-size: 1.45rem; }
  .story-guide > p:not(.story-guide__kicker) { margin-top: 11px; color: var(--reader-text-soft); }
  .story-guide dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 9px; margin-top: 18px; }
  .story-guide dl > div { padding: 12px 13px; border: 1px solid var(--reader-border); border-radius: 13px; background: var(--reader-surface-raised); }
  .story-guide dt { color: var(--reader-text-soft); font-size: .68rem; font-weight: 900; letter-spacing: .07em; text-transform: uppercase; }
  .story-guide dd { margin-top: 3px; color: var(--reader-text-color); font-size: .84rem; font-weight: 850; }
  .story-prompts { margin-top: 21px; padding-top: 18px; border-top: 1px solid var(--reader-border); }
  .story-prompts h3 { color: var(--reader-text-color); font-size: 1rem; }
  .story-prompts ul { margin: 9px 0 0 1.2rem; color: var(--reader-text-soft); }
  .editorial-link { display: inline-flex; align-items: center; gap: 6px; margin-top: 18px; color: var(--reader-accent); font-size: .82rem; font-weight: 850; }
  .editorial-link:hover { text-decoration: underline; }

  .themes { display: flex; gap: 8px; flex-wrap: wrap; justify-content: center; margin-top: 20px; padding: 0 clamp(18px, 5vw, 24px); }
  .themes .tag { border-color: var(--reader-border); background: var(--reader-surface-raised); color: var(--reader-accent); }

  .watch, .more { margin-top: 40px; }
  .watch h2, .more h2 { color: var(--reader-text-color); font-size: 1.5rem; margin-bottom: 6px; }
  .watch p { color: var(--reader-text-soft); margin-bottom: 16px; }
  .more h2 { margin-bottom: 16px; }
  .back { text-align: center; margin: 34px 0 10px; }
  .back .btn-ghost { color: var(--reader-accent); border-color: var(--reader-border); }
  .back .btn-ghost:hover { background: var(--reader-surface-raised); }

  @media (max-width: 640px) {
