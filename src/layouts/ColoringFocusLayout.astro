---
import '../styles/global.css';
import AdSenseLoader from '../components/AdSenseLoader.astro';
import BaseHead from '../components/BaseHead.astro';
import Consent from '../components/Consent.astro';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  image: string;
  imageAlt: string;
  allowAds?: boolean;
}

const { title, description, canonicalPath, image, imageAlt, allowAds = false } = Astro.props;
---
<!doctype html>
<html lang="tr" class="coloring-focus-page">
  <head>
    <BaseHead
      title={title}
      description={description}
      path={canonicalPath}
      image={image}
      imageAlt={imageAlt}
      allowAds={allowAds}
      robots="noindex, follow"
    />
    <Consent />
    <AdSenseLoader allowAds={allowAds} />
  </head>
  <body class="coloring-focus-body">
    <main id="main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  html.coloring-focus-page,
  body.coloring-focus-body {
    width: 100%;
    height: 100%;
    overscroll-behavior: none;
  }

  body.coloring-focus-body {
    min-height: 100dvh;
    overflow: hidden;
    background: #eaf1ff;
  }

  body.coloring-focus-body > main {
    width: 100%;
    height: 100dvh;
    min-height: 0;
  }
</style>
