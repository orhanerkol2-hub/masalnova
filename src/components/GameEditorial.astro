---
import { gameEditorial } from '../data/game-editorial';

interface Props { slug: string; title: string; minimumWords?: number; }
const { slug, title, minimumWords = 0 } = Astro.props;
const content = gameEditorial[slug];
if (!content) throw new Error(`Game editorial content missing for ${slug}`);
const editorialWordCount = [
  content.overview,
  content.play,
  ...content.tips,
  content.parent,
  ...(content.learning ?? []).flatMap((item) => [item.title, item.body]),
  ...(content.faq ?? []).flatMap((item) => [item.question, item.answer]),
]
  .join(' ')
  .trim()
  .split(/\s+/u)
  .filter(Boolean)
  .length;
if (minimumWords > 0 && editorialWordCount < minimumWords) {
  throw new Error(`Game editorial content for ${slug} has ${editorialWordCount}/${minimumWords} words`);
}
---

<section
  class="game-editorial"
  aria-labelledby={`${slug}-guide`}
  data-game-editorial={slug}
  data-editorial-word-count={editorialWordCount}
  data-editorial-minimum={minimumWords || undefined}
>
  <header>
    <span class="eyebrow">Oyun rehberi</span>
    <h2 id={`${slug}-guide`}>{title} nasıl bir oyun?</h2>
  </header>
  <p>{content.overview}</p>
  <h3>Nasıl oynanır?</h3>
  <p>{content.play}</p>
  <h3>Daha iyi oynamak için ipuçları</h3>
  <ul>{content.tips.map((tip) => <li>{tip}</li>)}</ul>
  <aside aria-label="Ebeveynler için kısa bilgi">
    <h3>Ebeveynler için</h3>
    <p>{content.parent}</p>
  </aside>
  {content.learning && content.learning.length > 0 && (
    <section class="learning-section" aria-labelledby={`${slug}-learning`}>
      <h3 id={`${slug}-learning`}>Bu oyunda hangi beceriler kullanılır?</h3>
      <div class="learning-grid">
        {content.learning.map((item) => (
          <article>
            <h4>{item.title}</h4>
            <p>{item.body}</p>
          </article>
        ))}
      </div>
    </section>
  )}
  {content.faq && content.faq.length > 0 && (
    <section class="faq-section" aria-labelledby={`${slug}-faq`}>
      <h3 id={`${slug}-faq`}>Sık sorulan sorular</h3>
      <div class="faq-list">
        {content.faq.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  )}
</section>

<style>
  .game-editorial { max-width: 900px; margin: 28px auto 0; padding: clamp(22px,4vw,38px); border: 1px solid rgba(255,255,255,.16); border-radius: 24px; background: rgba(255,255,255,.1); color: #fff; }
  .game-editorial header { margin-bottom: 14px; }
  .eyebrow { color: #ffd85f; font-size: .75rem; font-weight: 900; letter-spacing: .08em; text-transform: uppercase; }
  .game-editorial h2 { margin-top: 4px; font-size: clamp(1.45rem,3vw,2rem); }
  .game-editorial h3 { margin-top: 20px; font-size: 1.05rem; }
  .game-editorial p, .game-editorial li { color: rgba(255,255,255,.78); line-height: 1.75; }
  .game-editorial ul { margin: 8px 0 0; padding-left: 1.25rem; }
  .game-editorial li + li { margin-top: 5px; }
  .game-editorial aside { margin-top: 22px; padding: 18px 20px; border-left: 4px solid #ffd85f; border-radius: 0 14px 14px 0; background: rgba(5,20,52,.28); }
  .game-editorial aside h3 { margin-top: 0; }
  .learning-section, .faq-section { margin-top: 28px; }
  .learning-section > h3, .faq-section > h3 { margin-top: 0; font-size: 1.2rem; }
  .learning-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 12px; margin-top: 12px; }
  .learning-grid article { padding: 17px; border: 1px solid rgba(255,255,255,.14); border-radius: 16px; background: rgba(5,20,52,.2); }
  .learning-grid h4 { color: #ffe080; font-size: .95rem; }
  .learning-grid p { margin-top: 6px; font-size: .88rem; }
  .faq-list { display: grid; gap: 9px; margin-top: 12px; }
  .faq-list details { overflow: hidden; border: 1px solid rgba(255,255,255,.14); border-radius: 14px; background: rgba(5,20,52,.2); }
  .faq-list summary { position: relative; padding: 15px 42px 15px 17px; cursor: pointer; font-weight: 900; list-style: none; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary::after { position: absolute; top: 50%; right: 17px; content: '+'; color: #ffd85f; font-size: 1.25rem; transform: translateY(-50%); }
  .faq-list details[open] summary::after { content: '−'; }
  .faq-list details p { margin: 0; padding: 0 17px 17px; }
  @media (min-width:721px) {
    .game-editorial { border-color:#ded9ce; background:#fff; color:#173574; box-shadow:0 12px 30px rgba(23,43,92,.07); }
    .game-editorial p, .game-editorial li { color:#5f6f89; }
    .game-editorial aside { background:#fff8dd; }
    .learning-grid article, .faq-list details { border-color:#e4e0d6; background:#faf8f3; }
    .learning-grid h4 { color:#173574; }
    .eyebrow { color:#987000; }
  }
  @media (max-width:720px) {
    .learning-grid { grid-template-columns:1fr; }
  }
</style>
