---
import '@fontsource/nunito/500.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '@fontsource/nunito/900.css';
import '@phosphor-icons/web/regular';
import '@phosphor-icons/web/fill';

type WorldId = 'moon' | 'cloud' | 'crystal';
interface Props { lockedWorld: WorldId }

const { lockedWorld } = Astro.props;
const gameTitles: Record<WorldId, string> = {
  moon: 'Ay Işığı Bahçesi',
  cloud: 'Bulut Fırını',
  crystal: 'Kristal Saray',
};
const gameTitle = gameTitles[lockedWorld];
---
<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#071b42" />
    <meta name="color-scheme" content="only light" />
    <meta name="robots" content="noindex, follow" />
    <title>{gameTitle} | MasalNova</title>
  </head>
  <body>
    <main class={`game theme-${lockedWorld}`} data-game-root data-game-state="loading" data-locked-world={lockedWorld}>
      <canvas
        class="game-canvas"
        data-game-canvas
        tabindex="0"
        aria-label="İpleri keserek sihirli nesneyi hedefe ulaştırdığın Masal İpleri fizik oyunu"
      ></canvas>

      <section class="hud" data-hud hidden aria-label="Oyun bilgileri">
        <div class="level-chip">
          <small data-world-kicker>AY IŞIĞI BAHÇESİ</small>
          <strong data-level-label>BÖLÜM 01</strong>
        </div>

        <div class="star-meter" data-star-meter aria-label="Toplanan yıldızlar">
          <i class="ph ph-star" data-hud-star="0"></i>
          <i class="ph ph-star" data-hud-star="1"></i>
          <i class="ph ph-star" data-hud-star="2"></i>
        </div>

        <div class="hud-actions">
          <button type="button" data-reset-button aria-label="Bölümü yeniden başlat"><i class="ph ph-arrow-counter-clockwise"></i></button>
          <button type="button" data-sound-button aria-label="Sesi kapat" aria-pressed="true"><i class="ph ph-speaker-high"></i></button>
          <button type="button" data-pause-button aria-label="Oyunu duraklat"><i class="ph ph-pause"></i></button>
        </div>
      </section>

      <aside class="hint" data-hint hidden aria-live="polite">
        <i class="ph ph-scissors"></i>
        <span data-hint-copy>İpi kes, ay damlasını çiçeğe ulaştır</span>
      </aside>

      <div class="cut-guide" data-cut-guide hidden aria-hidden="true">
        <i class="ph ph-hand-swipe-left"></i>
        <span>İpin üzerinden parmağını kaydır</span>
      </div>

      <div class="toast" data-toast hidden role="status" aria-live="polite"></div>

      <section class="screen loading-screen" data-loading-screen aria-label="Oyun yükleniyor" aria-live="polite">
        <img src="/logo.webp" alt="MasalNova" width="600" height="153" />
        <p>MASALNOVA ORIGINALS SUNAR</p>
        <strong>Üç diyarın sihri hazırlanıyor…</strong>
        <div class="loading-track"><i data-loading-progress></i></div>
        <small data-loading-copy>Mimo ay çiçeklerini uyandırıyor</small>
      </section>

      <section class="screen menu-screen" data-menu-screen hidden aria-labelledby="game-title">
        <div class="menu-copy">
          <div class="brand-pill">MASALNOVA <span>ORIGINALS</span></div>
          <p class="eyebrow">ÜÇ DİYAR · DOKUZ FİZİK BULMACASI</p>
          <h1 id="game-title">Masal <strong>İpleri</strong></h1>
          <p>İpleri doğru sırayla kes, üç yıldızı topla ve her diyarın sihirli emanetini masal dostuna ulaştır.</p>
        </div>

        <div class="world-grid" data-world-grid aria-label="Masal dünyasını seç">
          <button class="world-card is-selected" type="button" data-world-select="moon" aria-pressed="true">
            <img src="/games/masal-ipleri/assets/moon-garden.webp" alt="Ay ışığında çiçeklerle çevrili büyülü bahçe" width="1440" height="1024" />
            <span><small>DİYAR I</small><strong>Ay Işığı Bahçesi</strong><em>Mimo ve ay damlası</em></span>
            <b data-world-progress="moon">0/3</b>
          </button>
          <button class="world-card" type="button" data-world-select="cloud" aria-pressed="false">
            <img src="/games/masal-ipleri/assets/cloud-bakery.webp" alt="Güneşli bulutların üzerinde masalsı fırın" width="1440" height="1024" />
            <span><small>DİYAR II</small><strong>Bulut Fırını</strong><em>Pofur ve yıldız çöreği</em></span>
            <b data-world-progress="cloud">0/3</b>
          </button>
          <button class="world-card" type="button" data-world-select="crystal" aria-pressed="false">
            <img src="/games/masal-ipleri/assets/crystal-palace.webp" alt="Turkuaz şelaleli büyülü kristal saray" width="1440" height="1024" />
            <span><small>DİYAR III</small><strong>Kristal Saray</strong><em>Mirza ve su incisi</em></span>
            <b data-world-progress="crystal">0/3</b>
          </button>
        </div>

        <div class="menu-actions">
          <button class="primary-button" type="button" data-start-button>
            <span><small>SEÇİLİ DİYARA GİR</small><strong data-start-label>Ay Işığı Bahçesi</strong></span>
            <i class="ph ph-play"></i>
          </button>
          <p><i class="ph ph-scissors"></i> Fareyle veya parmağınla ipin üzerinden geç</p>
        </div>
      </section>

      <section class="screen overlay-screen" data-pause-screen hidden role="dialog" aria-modal="true" aria-labelledby="pause-title">
        <div class="dialog-panel">
          <span class="dialog-icon"><i class="ph ph-moon-stars"></i></span>
          <p class="eyebrow">MASAL BURADA BEKLİYOR</p>
          <h2 id="pause-title">Biraz soluklanalım.</h2>
          <p>İpler, yıldızlar ve sihirli emanet aynı yerde kalacak.</p>
          <button class="primary-button" type="button" data-resume-button><span><small>MASALA DÖN</small><strong>Devam et</strong></span><i class="ph ph-play"></i></button>
          <button class="text-button" type="button" data-pause-menu>Bölümü yeniden başlat</button>
        </div>
      </section>

      <section class="screen overlay-screen" data-result-screen hidden role="dialog" aria-modal="true" aria-labelledby="result-title">
        <div class="dialog-panel result-panel">
          <span class="dialog-icon" data-result-icon><i class="ph-fill ph-star"></i></span>
          <p class="eyebrow" data-result-kicker>AY ÇİÇEĞİ UYANDI</p>
          <h2 id="result-title" data-result-title>Masal tamamlandı!</h2>
          <p data-result-copy>Ay damlası yerine ulaştı.</p>
          <div class="result-stars" data-result-stars aria-label="Kazanılan yıldızlar"></div>
          <button class="primary-button" type="button" data-next-button><span><small>SONRAKİ BULMACA</small><strong>Devam et</strong></span><i class="ph ph-arrow-right"></i></button>
          <button class="text-button" type="button" data-result-menu>Oyunu baştan başlat</button>
        </div>
      </section>

      <p class="rotate-note" data-rotate-note hidden><i class="ph ph-device-rotate"></i> Daha geniş bir oyun alanı için cihazını yatay çevirebilirsin.</p>
    </main>

    <script>
      import '../scripts/masal-ipleri';
    </script>
  </body>
</html>

<style>
  :root { font-family: 'Nunito', system-ui, sans-serif; color: #fff; background: #041127; }
  * { box-sizing: border-box; }
  html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; }
  button { font: inherit; }
  button:focus-visible, canvas:focus-visible { outline: 3px solid #fff0a6; outline-offset: 3px; }
  [hidden] { display: none !important; }

  .game { --accent: #f8ce61; --accent-ink: #4d3300; --panel: rgba(5, 20, 50, .82); position: relative; isolation: isolate; width: 100vw; height: 100dvh; min-height: 500px; overflow: hidden; background: #071b42; }
  .theme-cloud { --accent: #f6c2ff; --accent-ink: #522664; --panel: rgba(66, 39, 104, .8); }
  .theme-crystal { --accent: #73f1e0; --accent-ink: #063f49; --panel: rgba(4, 47, 59, .82); }
  .game::after { position: absolute; z-index: 4; inset: 0; border: 1px solid rgba(255,255,255,.16); box-shadow: inset 0 0 80px rgba(0,0,0,.23); content: ''; pointer-events: none; }
  .game-canvas { position: absolute; inset: 0; display: block; width: 100%; height: 100%; touch-action: none; cursor: crosshair; }

  .hud { position: absolute; z-index: 10; inset: max(22px, env(safe-area-inset-top)) max(24px, env(safe-area-inset-right)) auto max(24px, env(safe-area-inset-left)); display: grid; grid-template-columns: 1fr auto 1fr; align-items: start; gap: 18px; pointer-events: none; }
  .level-chip, .hud-actions button, .star-meter { border: 1px solid rgba(255,231,154,.7); background: var(--panel); box-shadow: 0 12px 28px rgba(0,0,0,.26); backdrop-filter: blur(12px) saturate(1.14); }
  .level-chip { justify-self: start; min-width: 174px; padding: 9px 16px 10px; border-radius: 17px; }
  .level-chip small { display: block; color: var(--accent); font-size: .62rem; font-weight: 900; letter-spacing: .14em; }
  .level-chip strong { display: block; margin-top: 2px; font-size: 1.05rem; letter-spacing: .02em; }
  .star-meter { display: flex; gap: 9px; padding: 8px 15px; border-radius: 999px; color: rgba(255,255,255,.34); font-size: 2rem; }
  .star-meter i.is-collected { color: var(--accent); filter: drop-shadow(0 0 11px color-mix(in srgb, var(--accent), transparent 25%)); }
  .hud-actions { justify-self: end; display: flex; gap: 9px; pointer-events: auto; }
  .hud-actions button { display: grid; width: 49px; height: 49px; padding: 0; place-items: center; border-radius: 15px; color: #fff; font-size: 1.3rem; cursor: pointer; }
  .hud-actions button:hover { background: color-mix(in srgb, var(--accent), var(--panel) 78%); transform: translateY(-2px); }

  .hint { position: absolute; z-index: 9; left: max(24px, env(safe-area-inset-left)); bottom: max(22px, env(safe-area-inset-bottom)); display: flex; align-items: center; gap: 10px; max-width: min(520px, calc(100% - 48px)); padding: 11px 17px; border: 1px solid rgba(255,255,255,.5); border-radius: 18px; background: var(--panel); box-shadow: 0 13px 30px rgba(0,0,0,.23); font-size: .86rem; font-weight: 900; backdrop-filter: blur(12px); }
  .hint i { display: grid; width: 35px; height: 35px; place-items: center; border-radius: 11px; background: var(--accent); color: var(--accent-ink); font-size: 1.1rem; }
  .cut-guide { position: absolute; z-index: 9; left: 50%; bottom: 8%; display: flex; align-items: center; gap: 10px; padding: 10px 15px; border: 1px solid rgba(255,255,255,.45); border-radius: 999px; background: rgba(3,15,38,.78); font-size: .75rem; font-weight: 900; transform: translateX(-50%); pointer-events: none; backdrop-filter: blur(10px); animation: guide 1.8s ease-in-out infinite; }
  .cut-guide i { color: var(--accent); font-size: 1.3rem; }
  @keyframes guide { 50% { transform: translateX(calc(-50% + 12px)); } }
  .toast { position: absolute; z-index: 16; top: 96px; left: 50%; padding: 9px 16px; border-radius: 999px; background: rgba(3,18,44,.86); box-shadow: 0 12px 28px rgba(0,0,0,.26); font-size: .78rem; font-weight: 900; transform: translateX(-50%); backdrop-filter: blur(12px); }

  .screen { position: absolute; z-index: 20; inset: 0; }
  .loading-screen { display: grid; place-content: center; justify-items: center; gap: 12px; padding: 28px; background: radial-gradient(circle at 50% 35%, #153c78, #030a18 72%); text-align: center; }
  .loading-screen img { width: min(300px, 58vw); height: auto; }
  .loading-screen p, .eyebrow { margin: 8px 0 0; color: #f8d26d; font-size: .68rem; font-weight: 900; letter-spacing: .16em; }
  .loading-screen > strong { font-size: clamp(1.3rem, 4vw, 2.2rem); }
  .loading-screen > small { color: rgba(255,255,255,.68); font-weight: 800; }
  .loading-track { overflow: hidden; width: min(360px, 72vw); height: 5px; margin-top: 8px; border-radius: 999px; background: rgba(255,255,255,.16); }
  .loading-track i { display: block; width: 0; height: 100%; border-radius: inherit; background: #f8d26d; transition: width .2s ease; }

  .menu-screen { display: grid; grid-template-rows: auto 1fr auto; gap: 22px; overflow-y: auto; padding: clamp(26px, 4vw, 54px) clamp(24px, 5vw, 74px); background: linear-gradient(90deg, rgba(2,10,26,.92), rgba(2,10,26,.26) 48%, rgba(2,10,26,.66)), url('/games/masal-ipleri/assets/moon-garden.webp') center / cover no-repeat; }
  .menu-copy { max-width: 650px; }
  .brand-pill { display: inline-flex; align-items: center; gap: 8px; font-size: .72rem; font-weight: 900; letter-spacing: .12em; }
  .brand-pill span { padding-left: 9px; border-left: 1px solid rgba(255,255,255,.35); color: rgba(255,255,255,.6); }
  .menu-copy h1 { margin: 7px 0 8px; font-size: clamp(3rem, 7vw, 6.4rem); line-height: .86; letter-spacing: -.065em; text-shadow: 0 8px 28px rgba(0,0,0,.35); }
  .menu-copy h1 strong { display: block; color: var(--accent); }
  .menu-copy > p:last-child { max-width: 590px; margin: 18px 0 0; color: rgba(255,255,255,.8); font-size: clamp(.9rem, 1.5vw, 1.08rem); font-weight: 700; line-height: 1.55; }
  .world-grid { align-self: center; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; width: min(1060px, 100%); }
  .world-card { position: relative; overflow: hidden; min-height: 225px; padding: 0; border: 1px solid rgba(255,255,255,.28); border-radius: 21px; background: #0d2854; color: #fff; box-shadow: 0 18px 38px rgba(0,0,0,.22); text-align: left; cursor: pointer; transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
  .world-card::after { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(2,11,29,.96), rgba(2,11,29,.08) 65%); content: ''; }
  .world-card img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .world-card > span { position: absolute; z-index: 2; right: 18px; bottom: 17px; left: 18px; display: grid; }
  .world-card small { color: #f8d26d; font-size: .59rem; font-style: normal; font-weight: 900; letter-spacing: .14em; }
  .world-card strong { margin-top: 2px; font-size: 1.08rem; }
  .world-card em { margin-top: 1px; color: rgba(255,255,255,.67); font-size: .68rem; font-style: normal; font-weight: 800; }
  .world-card > b { position: absolute; z-index: 3; top: 13px; right: 13px; padding: 5px 9px; border-radius: 999px; background: rgba(3,14,36,.72); font-size: .66rem; backdrop-filter: blur(9px); }
  .world-card:hover, .world-card.is-selected { border-color: var(--accent); box-shadow: 0 22px 48px rgba(0,0,0,.34), 0 0 0 3px color-mix(in srgb, var(--accent), transparent 76%); transform: translateY(-5px); }
  .world-card:hover img, .world-card.is-selected img { transform: scale(1.04); }
  .menu-actions { display: flex; align-items: center; gap: 18px; }
  .menu-actions > p { margin: 0; color: rgba(255,255,255,.65); font-size: .74rem; font-weight: 800; }
  .menu-actions > p i { margin-right: 5px; color: var(--accent); }
  .primary-button { display: flex; align-items: center; justify-content: space-between; gap: 30px; min-width: 300px; padding: 12px 16px 12px 19px; border: 1px solid rgba(255,255,255,.82); border-radius: 15px; background: var(--accent); color: var(--accent-ink); box-shadow: 0 14px 30px rgba(0,0,0,.25); text-align: left; cursor: pointer; }
  .primary-button span { display: grid; }
  .primary-button small { font-size: .56rem; font-weight: 900; letter-spacing: .12em; opacity: .72; }
  .primary-button strong { font-size: .96rem; }
  .primary-button > i { font-size: 1.15rem; }
  .primary-button:hover { filter: brightness(1.05); transform: translateY(-2px); }

  .overlay-screen { display: grid; place-items: center; padding: 24px; background: rgba(2,9,24,.7); backdrop-filter: blur(12px); }
  .dialog-panel { width: min(430px, 100%); padding: 32px; border: 1px solid rgba(255,236,173,.58); border-radius: 24px; background: linear-gradient(145deg, rgba(13,38,78,.97), rgba(3,16,39,.98)); box-shadow: 0 30px 90px rgba(0,0,0,.48); text-align: center; }
  .dialog-icon { display: grid; width: 62px; height: 62px; margin: 0 auto 14px; place-items: center; border-radius: 20px; background: var(--accent); color: var(--accent-ink); font-size: 1.75rem; box-shadow: 0 10px 26px color-mix(in srgb, var(--accent), transparent 74%); }
  .dialog-panel h2 { margin: 7px 0 8px; font-size: 2rem; line-height: 1; }
  .dialog-panel > p:not(.eyebrow) { margin: 0 auto 20px; color: rgba(255,255,255,.7); line-height: 1.5; }
  .dialog-panel .primary-button { width: 100%; margin-top: 16px; }
  .text-button { margin-top: 13px; padding: 7px 12px; border: 0; background: transparent; color: rgba(255,255,255,.7); font-size: .78rem; font-weight: 900; text-decoration: underline; cursor: pointer; }
  .result-stars { display: flex; justify-content: center; gap: 10px; min-height: 50px; color: var(--accent); font-size: 2.6rem; }
  .result-stars i.is-empty { color: rgba(255,255,255,.2); }
  .rotate-note { position: absolute; z-index: 18; right: 13px; bottom: 12px; max-width: 240px; margin: 0; padding: 8px 11px; border-radius: 11px; background: rgba(3,16,39,.82); color: rgba(255,255,255,.76); font-size: .65rem; font-weight: 800; pointer-events: none; }

  @media (max-width: 760px) {
    .game { min-height: 420px; }
    .menu-screen { grid-template-rows: auto auto auto; gap: 18px; padding: max(18px, env(safe-area-inset-top)) 16px max(18px, env(safe-area-inset-bottom)); background-position: center; }
    .menu-copy h1 { font-size: clamp(2.7rem, 16vw, 4.4rem); }
    .menu-copy > p:last-child { margin-top: 12px; font-size: .78rem; }
    .world-grid { grid-template-columns: 1fr; gap: 9px; }
    .world-card { min-height: 116px; border-radius: 17px; }
    .world-card img { object-position: center 58%; }
    .world-card > span { bottom: 12px; left: 14px; }
    .menu-actions { align-items: stretch; flex-direction: column; gap: 8px; }
    .primary-button { width: 100%; min-width: 0; }
    .menu-actions > p { text-align: center; }
    .hud { inset: max(10px, env(safe-area-inset-top)) max(10px, env(safe-area-inset-right)) auto max(10px, env(safe-area-inset-left)); grid-template-columns: 1fr auto; gap: 8px; }
    .level-chip { min-width: 0; padding: 7px 10px; border-radius: 12px; }
    .level-chip small { font-size: .48rem; }
    .level-chip strong { font-size: .78rem; }
    .star-meter { position: absolute; top: 58px; left: 0; gap: 5px; padding: 5px 9px; font-size: 1.25rem; }
    .hud-actions { grid-column: 2; }
    .hud-actions button { width: 40px; height: 40px; border-radius: 12px; font-size: 1rem; }
    .hint { right: 10px; bottom: max(10px, env(safe-area-inset-bottom)); left: 10px; justify-content: center; max-width: none; padding: 7px 10px; border-radius: 13px; font-size: .68rem; }
    .hint i { width: 29px; height: 29px; border-radius: 9px; }
    .cut-guide { bottom: 16%; font-size: .64rem; }
  }

  @media (max-height: 610px) and (orientation: landscape) {
    .menu-screen { grid-template-columns: minmax(260px, .8fr) 1.5fr; grid-template-rows: 1fr auto; align-items: center; gap: 14px 24px; padding: 18px 24px; }
    .menu-copy h1 { font-size: clamp(2.8rem, 7vw, 4.8rem); }
    .menu-copy > p:last-child { display: none; }
    .world-grid { grid-template-columns: repeat(3, 1fr); }
    .world-card { min-height: 180px; }
    .menu-actions { grid-column: 1 / -1; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
  }
</style>
