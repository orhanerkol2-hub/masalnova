---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameEditorial from './GameEditorial.astro';

interface Props {
  title: string;
  slug: string;
  shortDescription: string;
  cover: string;
  coverAlt: string;
  age: string;
  mechanic: string;
  accent: string;
  howTo: string;
  mastery: string;
}

const {
  title,
  slug,
  shortDescription,
  cover,
  coverAlt,
  age,
  mechanic,
  accent,
  howTo,
  mastery,
} = Astro.props;

const gamePath = `/games/${slug}/index.html`;
const gameUrl = `https://masalnova.com/oyna/${slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: title,
    description: shortDescription,
    url: gameUrl,
    image: `https://masalnova.com${cover}`,
    inLanguage: 'tr-TR',
    applicationCategory: 'Game',
    genre: ['Puzzle game', 'Pattern game', "Children's game"],
    gamePlatform: ['Web browser', 'Mobile web'],
    playMode: 'SinglePlayer',
    typicalAgeRange: age,
    numberOfPlayers: 1,
    publisher: { '@type': 'Organization', name: 'MasalNova' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
      { '@type': 'ListItem', position: 2, name: 'Oyunlar', item: 'https://masalnova.com/oyunlar/' },
      { '@type': 'ListItem', position: 3, name: title, item: gameUrl },
    ],
  },
];
---

<BaseLayout
  title={`${title} Oyna | MasalNova`}
  description={`${shortDescription} MasalNova’ya özel, reklamsız ve ücretsiz Türkçe çocuk oyununu oyna.`}
  path={`/oyna/${slug}/`}
  image={cover}
  imageAlt={coverAlt}
  activeNav="oyunlar"
  allowAds={false}
  jsonLd={jsonLd}
>
  <section class="game-page" style={`--kilim-accent:${accent}; --kilim-cover:url('${cover}')`}>
    <div class="container">
      <nav class="breadcrumbs" aria-label="İçerik yolu">
        <a href="/">Ana Sayfa</a><span aria-hidden="true">›</span>
        <a href="/oyunlar/">Oyunlar</a><span aria-hidden="true">›</span>
        <span>{title}</span>
      </nav>

      <div class="game-heading">
        <div>
          <div class="meta-row">
            <span class="exclusive-pill"><i class="ph ph-seal-check" aria-hidden="true"></i> MasalNova Original</span>
            <span>{mechanic}</span>
            <span>Öneri: {age}</span>
          </div>
          <h1>{title}</h1>
          <p>{shortDescription}</p>
        </div>
        <div class="heading-actions">
          <a class="fullscreen-link" href={gamePath} data-fullscreen-trigger>
            <i class="ph ph-arrows-out" aria-hidden="true"></i> Tam ekran oyna
          </a>
          <a class="back-link" href="/oyunlar/"><i class="ph ph-grid-four" aria-hidden="true"></i> Tüm oyunlar</a>
        </div>
      </div>

      <section class="player-shell" aria-label={`${title} oyun alanı`} data-player-shell>
        <iframe
          src={gamePath}
          title={`${title} — MasalNova oyun alanı`}
          allow="fullscreen"
          allowfullscreen
          loading="eager"
          data-game-frame
        ></iframe>
        <a class="inline-game-launch" href={gamePath} data-fullscreen-trigger>
          <i class="ph ph-arrows-out" aria-hidden="true"></i>
          <span><strong>Tam ekranda oyna</strong><small>Dokun ve kilim macerasını başlat.</small></span>
        </a>
      </section>

      <p class="local-note">
        <i class="ph ph-shield-check" aria-hidden="true"></i>
        Reklam ve dış bağlantı yoktur. İlerleme yalnızca bu cihazda saklanır.
      </p>

      <div class="game-info-grid">
        <article class="info-card">
          <span class="info-icon"><i class="ph ph-hand-tap" aria-hidden="true"></i></span>
          <div><h2>Nasıl oynanır?</h2><p>{howTo}</p></div>
        </article>
        <article class="info-card">
          <span class="info-icon"><i class="ph ph-sparkle" aria-hidden="true"></i></span>
          <div><h2>Deseni tamamla</h2><p>{mastery}</p></div>
        </article>
        <article class="info-card">
          <span class="info-icon"><i class="ph ph-device-mobile" aria-hidden="true"></i></span>
          <div><h2>Her ekranda oynanır</h2><p>Dokunmatik ekran, fare ve klavye desteğiyle telefon, tablet ve bilgisayarda çalışır.</p></div>
        </article>
      </div>

      <GameEditorial slug={slug} title={title} minimumWords={200} />
    </div>
  </section>

  <script>
    const shell = document.querySelector('[data-player-shell]');
    const frame = document.querySelector('[data-game-frame]');
    document.querySelectorAll('[data-fullscreen-trigger]').forEach((trigger) => {
      trigger.addEventListener('click', async (event) => {
        if (!(shell instanceof HTMLElement) || !(frame instanceof HTMLIFrameElement)) return;
        if (!shell.requestFullscreen) return;
        event.preventDefault();
        try {
          await shell.requestFullscreen();
          document.documentElement.classList.add('game-fullscreen-active');
          document.body.classList.add('game-fullscreen-active');
          frame.focus();
        } catch {
          window.location.href = trigger.getAttribute('href') || frame.src;
        }
      });
    });
    document.addEventListener('fullscreenchange', () => {
      if (document.fullscreenElement) return;
      document.documentElement.classList.remove('game-fullscreen-active');
      document.body.classList.remove('game-fullscreen-active');
    });
  </script>
</BaseLayout>

<style>
  .game-page { position:relative; isolation:isolate; overflow:hidden; min-height:100dvh; padding:28px 0 62px; background:#102f61; }
  .game-page::before { position:absolute; z-index:-2; inset:0 0 auto; height:min(760px,76vw); background:linear-gradient(180deg,rgba(6,29,67,.24),#102f61 90%),var(--kilim-cover) center 42%/cover no-repeat; content:''; opacity:.48; filter:saturate(.92); }
  .game-page::after { position:absolute; z-index:-1; inset:0; background:linear-gradient(135deg,rgba(255,255,255,.025),transparent 40%); content:''; pointer-events:none; }
  .game-page .container { position:relative; max-width:1280px; }
  .breadcrumbs { display:flex; flex-wrap:wrap; align-items:center; gap:8px; color:rgba(255,255,255,.72); font-size:.78rem; font-weight:800; }
  .breadcrumbs a:hover { color:#fff; text-decoration:underline; }
  .game-heading { display:flex; align-items:end; justify-content:space-between; gap:28px; margin:22px 0 18px; color:#fff; }
  .game-heading h1 { max-width:850px; font-size:clamp(2rem,5vw,3.65rem); letter-spacing:-.045em; }
  .game-heading p { max-width:800px; margin-top:9px; color:rgba(255,255,255,.84); }
  .meta-row { display:flex; flex-wrap:wrap; gap:7px; margin-bottom:10px; }
  .meta-row span { display:inline-flex; align-items:center; gap:5px; padding:5px 10px; border:1px solid rgba(255,255,255,.28); border-radius:999px; background:rgba(6,38,77,.62); font-size:.73rem; font-weight:900; backdrop-filter:blur(8px); }
  .meta-row .exclusive-pill { border-color:#ffe19a; background:var(--kilim-accent); color:#533500; }
  .heading-actions { display:flex; flex:0 0 auto; gap:9px; }
  .fullscreen-link,.back-link { display:inline-flex; align-items:center; gap:8px; padding:10px 14px; border:1px solid rgba(255,255,255,.3); border-radius:999px; background:rgba(6,38,77,.65); color:#fff; font-size:.8rem; font-weight:900; backdrop-filter:blur(8px); }
  .fullscreen-link { border-color:var(--kilim-accent); background:var(--kilim-accent); color:#503400; }
  .fullscreen-link:hover,.back-link:hover { transform:translateY(-2px); }
  .player-shell { position:relative; overflow:hidden; aspect-ratio:16/9; border:1px solid rgba(255,224,142,.5); border-radius:26px; background:#081d3d; box-shadow:0 34px 90px rgba(2,12,31,.52),0 0 0 7px rgba(255,255,255,.025); }
  .player-shell::before { position:absolute; z-index:3; inset:0; border-radius:inherit; box-shadow:inset 0 0 0 1px rgba(255,255,255,.1); content:''; pointer-events:none; }
  .player-shell iframe { display:block; width:100%; height:100%; border:0; background:#081d3d; pointer-events:none; }
  .inline-game-launch { position:absolute; z-index:5; right:18px; bottom:18px; display:flex; max-width:min(350px,calc(100% - 36px)); align-items:center; gap:11px; padding:11px 15px; border:2px solid #fff1bd; border-radius:17px; background:rgba(7,39,80,.94); color:#fff; box-shadow:0 14px 34px rgba(2,12,32,.42); }
  .inline-game-launch i { flex:0 0 auto; color:var(--kilim-accent); font-size:1.45rem; }
  .inline-game-launch span { display:grid; gap:2px; }
  .inline-game-launch strong { font-size:.88rem; }
  .inline-game-launch small { color:rgba(255,255,255,.76); font-size:.68rem; line-height:1.3; }
  .player-shell:fullscreen { width:100vw; height:100dvh; aspect-ratio:auto; border:0; border-radius:0; box-shadow:none; }
  .player-shell:fullscreen iframe { width:100%; height:100%; pointer-events:auto; }
  .player-shell:fullscreen .inline-game-launch { display:none; }
  :global(html.game-fullscreen-active),:global(body.game-fullscreen-active) { height:100%; overflow:hidden!important; overscroll-behavior:none; }
  .local-note { display:flex; align-items:flex-start; gap:9px; margin:15px 4px 0; color:rgba(255,255,255,.74); font-size:.78rem; }
  .local-note i { flex:0 0 auto; margin-top:2px; color:#8ee6ae; font-size:1rem; }
  .game-info-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin-top:18px; }
  .info-card { display:flex; gap:14px; min-height:150px; padding:20px; border:1px solid rgba(255,255,255,.12); border-radius:22px; background:rgba(255,255,255,.94); color:#172c5b; box-shadow:0 16px 38px rgba(3,19,47,.2); }
  .info-icon { display:grid; flex:0 0 42px; width:42px; height:42px; place-items:center; border-radius:14px; background:#fff0bb; color:#173f91; font-size:1.35rem; }
  .info-card h2 { margin:2px 0 7px; font-size:1rem; }
  .info-card p { color:#5d6680; font-size:.84rem; line-height:1.55; }
  @media (max-width:900px) { .game-heading { align-items:flex-start; flex-direction:column; } .heading-actions { width:100%; flex-wrap:wrap; } .game-info-grid { grid-template-columns:1fr; } }
  @media (max-width:640px) { .game-page { padding:18px 0 42px; } .game-heading h1 { font-size:2rem; } .player-shell { margin-inline:calc(var(--container-pad,20px) * -1); border-radius:0; } .inline-game-launch { inset:auto 10px 10px; max-width:none; } .heading-actions a { flex:1; justify-content:center; } }
</style>
