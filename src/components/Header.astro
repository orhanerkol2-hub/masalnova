---
interface Props { active?: string }

const { active = '' } = Astro.props;
const activeKey = active === 'home'
  ? 'today'
  : ['masallar', 'masal-bul'].includes(active)
    ? 'discover'
    : active;

const mobileNavKeys = ['today', 'discover', 'videolar', 'oyunlar', 'boyama'];

const links = [
  { href: '/', label: 'Bugün', key: 'today', icon: 'house' },
  { href: '/masallar/', label: 'Masallar', key: 'discover', icon: 'compass' },
  { href: '/videolar/', label: 'Videolar', key: 'videolar', icon: 'play-circle' },
  { href: '/oyunlar/', label: 'Oyunlar', key: 'oyunlar', icon: 'game-controller' },
  { href: '/boyama/', label: 'Boyama', key: 'boyama', icon: 'paint-brush-broad' },
  { href: '/kitapligim/', label: 'Kitaplığım', key: 'library', icon: 'book-bookmark' },
  { href: '/#ayarlar', label: 'Ayarlar', key: 'settings', icon: 'gear' },
];

const railCategories = [
  { href: '/masallar/kategori/uyku/', label: 'Uyku masalları', icon: 'moon-stars' },
  { href: '/masallar/kategori/hayvan/', label: 'Hayvan masalları', icon: 'paw-print' },
  { href: '/masallar/kategori/egitici/', label: 'Eğitici masallar', icon: 'student' },
];
---

<header class:list={['app-header', { 'app-header--tile-nav': activeKey === 'today' }]} data-app-header>
  <aside class="app-rail" aria-label="Uygulama menüsü">
    <a class="rail-brand" href="/" aria-label="MasalNova ana sayfa">
      <img class="rail-logo rail-logo--full" src="/logo.webp" alt="MasalNova" width="188" height="48" />
      <img class="rail-logo rail-logo--compact" src="/app-icon-192.png" alt="" width="48" height="48" />
    </a>

    <nav class="rail-nav" aria-label="Ana menü">
      {links.filter((item) => item.key !== 'settings').map((item) => (
        <a
          href={item.href}
          class:list={['rail-link', { 'is-active': activeKey === item.key }]}
          aria-current={activeKey === item.key ? 'page' : undefined}
        >
          <i class={`ph ph-${item.icon}`} aria-hidden="true"></i>
          <span>{item.label}</span>
        </a>
      ))}
    </nav>

    <div class="rail-categories">
      <p>Kategoriler</p>
      <nav aria-label="Masal kategorileri">
        {railCategories.map((item) => (
          <a href={item.href}>
            <i class={`ph ph-${item.icon}`} aria-hidden="true"></i>
            <span>{item.label}</span>
          </a>
        ))}
      </nav>
    </div>

    <a class="rail-settings" href="/#ayarlar">
      <i class="ph ph-gear" aria-hidden="true"></i>
      <span>Ayarlar</span>
    </a>

    <div class="rail-note">
      <i class="ph ph-moon-stars" aria-hidden="true"></i>
      <p>Her akşam sakin bir masal.</p>
    </div>

    <div class="rail-legal">
      <a href="/impressum/">Legal Notice</a>
      <a href="/datenschutz/">Privacy</a>
    </div>
  </aside>

  <div class="app-topbar">
    <a class="mobile-brand" href="/" aria-label="MasalNova ana sayfa">
      <img src="/logo.webp" alt="MasalNova" width="154" height="39" />
    </a>
    <div class="topbar-actions">
      <a
        class:list={['games-action', { 'is-active': activeKey === 'oyunlar' }]}
        href="/oyunlar/"
        aria-current={activeKey === 'oyunlar' ? 'page' : undefined}
      >
        <i class="ph ph-game-controller" aria-hidden="true"></i>
        <span>Oyunlar</span>
      </a>
      <a class="top-action" href="/ara/" aria-label="Ara">
        <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
      </a>
      <a
        class:list={['top-action', 'library-action', { 'is-active': activeKey === 'library' }]}
        href="/kitapligim/"
        aria-label="Kitaplığım"
        aria-current={activeKey === 'library' ? 'page' : undefined}
      >
        <i class="ph ph-book-bookmark" aria-hidden="true"></i>
      </a>
      <button class="install-action" type="button" data-install-app aria-label="Uygulamayı yükle">
        <i class="ph ph-download-simple" aria-hidden="true"></i>
        <span>Uygulamayı yükle</span>
      </button>
      <a class="top-action settings-action" href="/#ayarlar" aria-label="Ayarlar">
        <i class="ph ph-gear" aria-hidden="true"></i>
        <span><i class="ph ph-lock-simple" aria-hidden="true"></i>Ayarlar</span>
      </a>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="Mobil ana menü">
    {links.filter((item) => mobileNavKeys.includes(item.key)).map((item) => (
      <a
        href={item.href}
        class:list={['mobile-link', { 'is-active': activeKey === item.key }]}
        aria-current={activeKey === item.key ? 'page' : undefined}
      >
        <i class={`ph ph-${item.icon}`} aria-hidden="true"></i>
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <div class="install-toast" data-install-toast role="status" aria-live="polite" data-nosnippet hidden></div>

  <div class="ios-install-guide" data-ios-install-guide data-nosnippet hidden>
    <section
      class="ios-install-sheet"
      role="dialog"
      aria-modal="true"
      aria-labelledby="ios-install-title"
      aria-describedby="ios-install-description"
    >
      <div class="ios-install-heading">
        <div class="ios-install-app-icon" aria-hidden="true">
          <img src="/apple-touch-icon.png" alt="" width="56" height="56" />
        </div>
        <div>
          <p class="ios-install-eyebrow">iPhone'a uygulama olarak ekle</p>
          <h2 id="ios-install-title">MasalNova hep yanında olsun</h2>
        </div>
        <button class="ios-install-close" type="button" data-ios-install-close aria-label="Kapat">
          <i class="ph ph-x" aria-hidden="true"></i>
        </button>
      </div>

      <p id="ios-install-description" class="ios-install-description">
        Safari'de aşağıdaki kısa adımları izleyerek MasalNova'yı ana ekranına ekleyebilirsin.
      </p>

      <ol class="ios-install-steps">
        <li>
          <span class="ios-install-step-icon" aria-hidden="true"><i class="ph ph-export"></i></span>
          <span><strong>Paylaş</strong> düğmesine dokun.</span>
        </li>
        <li>
          <span class="ios-install-step-icon" aria-hidden="true"><i class="ph ph-plus-square"></i></span>
          <span>Listeden <strong>“Ana Ekrana Ekle”</strong> seçeneğini aç.</span>
        </li>
        <li>
          <span class="ios-install-step-icon" aria-hidden="true"><i class="ph ph-check-circle"></i></span>
          <span><strong>“Web Uygulaması Olarak Aç”</strong> seçeneğini etkinleştirip <strong>“Ekle”</strong>ye dokun.</span>
        </li>
      </ol>

      <p class="ios-install-browser-note" data-ios-browser-note hidden>
        Bu seçenek görünmüyorsa sayfayı önce Safari'de aç.
      </p>

      <button class="ios-install-done" type="button" data-ios-install-close>Anladım</button>
    </section>
  </div>
</header>

<script>
  let installPrompt: any = null;
  const installButtons = [...document.querySelectorAll<HTMLElement>('[data-install-app]')];
  const toast = document.querySelector<HTMLElement>('[data-install-toast]');
  const iosGuide = document.querySelector<HTMLElement>('[data-ios-install-guide]');
  const iosGuideCloseButtons = [...document.querySelectorAll<HTMLElement>('[data-ios-install-close]')];
  const iosBrowserNote = document.querySelector<HTMLElement>('[data-ios-browser-note]');
  let toastTimer: number | undefined;
  let lastFocusedElement: HTMLElement | null = null;

  const userAgent = navigator.userAgent;
  const isIOS = /iphone|ipad|ipod/i.test(userAgent)
    || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  const isIOSSafari = isIOS
    && /safari/i.test(userAgent)
    && !/crios|fxios|edgios|opios/i.test(userAgent);

  if (isIOS) {
    installButtons.forEach((button) => {
      button.classList.add('is-ios');
      button.setAttribute('aria-label', "MasalNova'yı iPhone'a ekle");
      button.setAttribute('title', "iPhone'a ekle");
      const icon = button.querySelector('i');
      icon?.classList.replace('ph-download-simple', 'ph-export');
    });
    if (iosBrowserNote) iosBrowserNote.hidden = isIOSSafari;
  }

  function openIOSInstallGuide() {
    if (!iosGuide) return;
    lastFocusedElement = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    iosGuide.hidden = false;
    document.body.classList.add('is-install-guide-open');
    requestAnimationFrame(() => {
      iosGuide.classList.add('is-visible');
      iosGuide.querySelector<HTMLElement>('[data-ios-install-close]')?.focus();
    });
  }

  function closeIOSInstallGuide() {
    if (!iosGuide || iosGuide.hidden) return;
    iosGuide.classList.remove('is-visible');
    document.body.classList.remove('is-install-guide-open');
    window.setTimeout(() => {
      iosGuide.hidden = true;
      lastFocusedElement?.focus();
    }, 180);
  }

  function showInstallMessage(message: string) {
    if (!toast) return;
    window.clearTimeout(toastTimer);
    toast.textContent = message;
    toast.hidden = false;
    requestAnimationFrame(() => toast.classList.add('is-visible'));
    toastTimer = window.setTimeout(() => {
      toast.classList.remove('is-visible');
      window.setTimeout(() => { toast.hidden = true; }, 180);
    }, 4200);
  }

  window.addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    installPrompt = event;
    installButtons.forEach((button) => button.classList.add('is-ready'));
  });

  window.addEventListener('appinstalled', () => {
    installPrompt = null;
    installButtons.forEach((button) => {
      button.classList.remove('is-ready');
      button.classList.add('is-installed');
      const label = button.querySelector('span');
      if (label) label.textContent = 'Yüklendi';
    });
    showInstallMessage('MasalNova cihazına eklendi.');
  });

  installButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      const standalone = window.matchMedia('(display-mode: standalone)').matches
        || (navigator as Navigator & { standalone?: boolean }).standalone;
      if (standalone) {
        showInstallMessage('MasalNova zaten uygulama olarak açık.');
        return;
      }

      if (isIOS) {
        openIOSInstallGuide();
        return;
      }

      if (installPrompt) {
        await installPrompt.prompt();
        installPrompt = null;
        return;
      }

      showInstallMessage('Tarayıcı menüsünden “Uygulamayı yükle” veya “Ana ekrana ekle”yi seç.');
    });
  });

  iosGuideCloseButtons.forEach((button) => button.addEventListener('click', closeIOSInstallGuide));
  iosGuide?.addEventListener('click', (event) => {
    if (event.target === iosGuide) closeIOSInstallGuide();
  });
  document.addEventListener('keydown', (event) => {
    if (!iosGuide || iosGuide.hidden) return;
    if (event.key === 'Escape') {
      closeIOSInstallGuide();
      return;
    }
    if (event.key !== 'Tab') return;

    const focusableElements = [...iosGuide.querySelectorAll<HTMLElement>('button:not([disabled])')];
    const firstFocusable = focusableElements[0];
    const lastFocusable = focusableElements[focusableElements.length - 1];
    if (!firstFocusable || !lastFocusable) return;

    if (event.shiftKey && document.activeElement === firstFocusable) {
      event.preventDefault();
      lastFocusable.focus();
    } else if (!event.shiftKey && document.activeElement === lastFocusable) {
      event.preventDefault();
      firstFocusable.focus();
    }
  });
</script>

<style>
  .app-rail {
    position: fixed;
    z-index: 130;
    inset: 0 auto 0 0;
    width: var(--app-rail);
    display: flex;
    flex-direction: column;
    padding: 26px 14px 18px;
    border-right: 1px solid #e7e1d4;
    background: #f8f4ea;
    box-shadow: 18px 0 50px rgba(18,38,86,.08);
  }

  .rail-brand {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0 6px;
  }

  .rail-logo--full { width: 176px; height: auto; }
  .rail-logo--compact { display: none; }

  .rail-nav {
    display: grid;
    gap: 6px;
    margin-top: 34px;
  }

  .rail-link {
    display: flex;
    align-items: center;
    gap: 15px;
    min-height: 48px;
    padding: 0 16px;
    border: 1px solid transparent;
    border-radius: 17px;
    color: #244379;
    font-size: .9rem;
    font-weight: 800;
    transition: color .18s ease, background .18s ease, transform .18s ease;
  }

  .rail-link i { font-size: 1.42rem; }
  .rail-link:hover { color: #093cbd; background: #fff; transform: translateX(2px); }
  .rail-link.is-active {
    color: #fff;
    border-color: #093cbd;
    background: #173fbe;
    box-shadow: 0 12px 24px rgba(9,60,189,.2);
  }

  .rail-categories {
    margin: 18px 4px 0;
    padding-top: 16px;
    border-top: 1px solid #e2dccf;
  }

  .rail-categories > p {
    margin: 0 8px 8px;
    color: #7b8190;
    font-size: .63rem;
    font-weight: 900;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .rail-categories nav { display: grid; gap: 2px; }

  .rail-categories a {
    min-height: 38px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 10px;
    border-radius: 12px;
    color: #44557a;
    font-size: .75rem;
    font-weight: 800;
  }

  .rail-categories a i { color: #c39016; font-size: 1rem; }
  .rail-categories a:hover { background: #fff; color: #123d9c; }

  .rail-settings {
    min-height: 44px;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: auto;
    padding: 0 13px;
    border: 1px solid #ddd7ca;
    border-radius: 14px;
    background: #fff;
    color: #27477f;
    font-size: .78rem;
    font-weight: 850;
  }

  .rail-settings:hover { border-color: #c6d2e7; color: #093cbd; }

  .rail-note {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    display: none;
    padding: 16px 14px;
    border: 1px solid #e2dccf;
    border-radius: 17px;
    background: #fff;
    color: #52617d;
    font-size: .82rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .rail-note i { margin-top: 1px; color: var(--app-yellow); font-size: 1.2rem; }

  .rail-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 12px;
    margin: 15px 5px 0;
    color: #8b8f9b;
    font-size: .67rem;
    font-weight: 700;
  }

  .rail-legal a:hover { color: #093cbd; }

  .app-topbar {
    position: fixed;
    z-index: 120;
    top: 0;
    right: 0;
    left: var(--app-rail);
    height: var(--app-nav-height);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding: 12px clamp(22px, 4vw, 54px);
    border-bottom: 1px solid rgba(13,40,105,.1);
    background: rgba(255,253,247,.94);
    backdrop-filter: blur(18px);
  }

  .mobile-brand { display: none; }
  .topbar-actions { display: flex; align-items: center; gap: 10px; }

  .games-action,
  .top-action,
  .install-action {
    min-height: 44px;
    border: 1px solid #d8e0f2;
    background: #fff;
    color: #0d2869;
    box-shadow: 0 8px 20px rgba(13,40,105,.08);
    transition: transform .18s ease, background .18s ease, border-color .18s ease;
  }

  .games-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 15px;
    border-radius: 14px;
    font-size: .84rem;
    font-weight: 900;
  }

  .games-action i { font-size: 1.2rem; }
  .games-action.is-active { border-color: #f4c430; background: var(--app-yellow); color: #193068; }

  .top-action {
    width: 44px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    font-size: 1.22rem;
  }

  .settings-action span { display: none; }
  .library-action { display: none; }
  .library-action.is-active { border-color: #f4c430; background: var(--app-yellow); }

  .install-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 18px;
    border-radius: 15px;
    font-size: .86rem;
    font-weight: 900;
  }

  .install-action.is-ready {
    border-color: rgba(255,215,84,.6);
    background: var(--app-yellow);
    color: #193068;
  }

  .games-action:hover,
  .top-action:hover,
  .install-action:hover { transform: translateY(-2px); background: #f3f6fc; }
  .games-action.is-active:hover { background: #ffd65b; }
  .install-action.is-ready:hover { background: #ffd65b; }
  .mobile-nav { display: none; }

  .install-toast {
    position: fixed;
    z-index: 190;
    right: 28px;
    bottom: 28px;
    max-width: min(360px, calc(100vw - 36px));
    padding: 14px 17px;
    border: 1px solid rgba(255,255,255,.2);
    border-radius: 15px;
    background: #fff;
    color: #102b6d;
    box-shadow: 0 20px 60px rgba(0,20,80,.35);
    font-size: .9rem;
    font-weight: 800;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity .18s ease, transform .18s ease;
  }

  .install-toast.is-visible { opacity: 1; transform: none; }

  @media (min-width: 721px) {
    .app-header--tile-nav .topbar-actions { display: none; }
  }

  :global(body.is-install-guide-open) { overflow: hidden; }

  .ios-install-guide {
    position: fixed;
    z-index: 210;
    inset: 0;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 18px;
    background: rgba(4, 21, 68, .56);
    backdrop-filter: blur(5px);
    opacity: 0;
    transition: opacity .18s ease;
  }

  .ios-install-guide[hidden] { display: none; }
  .ios-install-guide.is-visible { opacity: 1; }

  .ios-install-sheet {
    width: min(100%, 440px);
    max-height: calc(100dvh - 36px);
    overflow-y: auto;
    padding: 22px 20px calc(20px + env(safe-area-inset-bottom));
    border: 1px solid rgba(255,255,255,.7);
    border-radius: 26px;
    background: #fffdf8;
    color: #102b6d;
    box-shadow: 0 28px 80px rgba(0,20,80,.38);
    transform: translateY(24px);
    transition: transform .22s cubic-bezier(.2,.8,.2,1);
  }

  .ios-install-guide.is-visible .ios-install-sheet { transform: none; }

  .ios-install-heading {
    display: grid;
    grid-template-columns: 56px 1fr 40px;
    gap: 12px;
    align-items: center;
  }

  .ios-install-app-icon img {
    display: block;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    box-shadow: 0 8px 20px rgba(13,40,105,.16);
  }

  .ios-install-eyebrow {
    margin: 0 0 3px;
    color: #49628f;
    font-size: .7rem;
    font-weight: 900;
    letter-spacing: .04em;
    text-transform: uppercase;
  }

  .ios-install-heading h2 {
    margin: 0;
    color: #092a78;
    font-size: 1.12rem;
    line-height: 1.15;
  }

  .ios-install-close {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: #edf3ff;
    color: #16377d;
    font-size: 1.12rem;
  }

  .ios-install-description {
    margin: 18px 0 14px;
    color: #536587;
    font-size: .9rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .ios-install-steps {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: ios-install-step;
  }

  .ios-install-steps li {
    counter-increment: ios-install-step;
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: 12px;
    align-items: center;
    min-height: 62px;
    padding: 9px 12px 9px 9px;
    border: 1px solid #dfe7f6;
    border-radius: 17px;
    background: #f7f9fe;
    color: #34496f;
    font-size: .86rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .ios-install-step-icon {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: #e6efff;
    color: #0a50ca;
    font-size: 1.3rem;
  }

  .ios-install-browser-note {
    margin: 12px 0 0;
    padding: 11px 13px;
    border-radius: 13px;
    background: #fff5d6;
    color: #79540a;
    font-size: .78rem;
    font-weight: 800;
    line-height: 1.4;
  }

  .ios-install-done {
    width: 100%;
    min-height: 48px;
    margin-top: 16px;
    border: 0;
    border-radius: 15px;
    background: #0a43c1;
    color: #fff;
    font: inherit;
    font-size: .9rem;
    font-weight: 900;
    box-shadow: 0 10px 24px rgba(10,67,193,.22);
  }

  .ios-install-close:focus-visible,
  .ios-install-done:focus-visible {
    outline: 3px solid #ffcf3e;
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .ios-install-guide,
    .ios-install-sheet { transition: none; }
  }

  @media (max-width: 1099px) and (min-width: 721px) {
    .app-rail { width: var(--app-rail-compact); align-items: center; padding: 24px 12px 20px; }
    .rail-logo--full { display: none; }
    .rail-logo--compact { display: block; width: 50px; height: 50px; border-radius: 15px; }
    .rail-nav { width: 100%; margin-top: 45px; }
    .rail-link { justify-content: center; min-height: 58px; padding: 0; border-radius: 17px; }
    .rail-link i { font-size: 1.55rem; }
    .rail-link span, .rail-note p, .rail-legal, .rail-categories { display: none; }
    .rail-note { justify-content: center; padding: 14px; }
    .rail-settings { width: 58px; justify-content: center; padding: 0; }
