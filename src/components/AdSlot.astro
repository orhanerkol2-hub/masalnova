---
interface Props {
  slot?: string;
  placement: string;
  variant?: 'content' | 'focus-top';
}

const { slot, placement, variant = 'content' } = Astro.props;
const adsenseEnabled = import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true'
  && import.meta.env.PUBLIC_GOOGLE_CERTIFIED_CMP === 'true';
const showAd = adsenseEnabled && Boolean(slot);
---

{
  showAd && (
    <aside class:list={['ad-slot', { 'is-focus-top': variant === 'focus-top' }]} aria-label="Reklam" data-ad-placement={placement} data-ad-safety={variant === 'focus-top' ? 'above-interaction' : 'content-only'}>
      <p class="ad-label">Reklam</p>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-5606540854153205"
        data-ad-slot={slot}
        data-ad-format={variant === 'focus-top' ? 'horizontal' : 'auto'}
        data-full-width-responsive="true"
        data-tag-for-age-treatment="1"
      ></ins>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  )
}

<style>
  .ad-slot {
    width: 100%;
    min-height: 120px;
    margin-block: 72px;
    padding: 22px;
    border: 1px solid #e4e7ef;
    border-radius: 18px;
    background: #fff;
  }

  .ad-label {
    margin-bottom: 12px;
    color: #697590;
    font-size: .66rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .ad-slot.is-focus-top {
    align-self: start;
    width: min(100%, 760px);
    min-height: 90px;
    margin: 0 auto 18px;
    padding: 7px 12px 10px;
    border: 0;
    border-bottom: 1px solid #dce5f7;
    border-radius: 0 0 16px 16px;
    background: #fff;
    box-shadow: 0 6px 18px rgba(8,30,80,.07);
  }

  .ad-slot.is-focus-top .ad-label {
    margin-bottom: 4px;
    text-align: center;
  }

  @media (max-width: 720px) {
    .ad-slot {
      min-height: 100px;
      margin-block: 60px;
      padding: 18px 14px;
    }

    .ad-slot.is-focus-top {
      min-height: 82px;
      margin: 0 auto 14px;
      padding: 5px 10px 8px;
    }

  }
</style>
