---
interface Props {
  slot?: string;
  placement: string;
  /** Fail closed when the surrounding page is not approved for advertising. */
  eligible?: boolean;
}

const { slot, placement, eligible = false } = Astro.props;
const adsenseEnabled = import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true'
  && import.meta.env.PUBLIC_ADSENSE_TAG_ENABLED === 'true'
  && import.meta.env.PUBLIC_GOOGLE_CMP_PUBLISHED === 'true'
  && import.meta.env.PUBLIC_ADSENSE_MANUAL_ONLY === 'true';
const approvedPlacements = new Set([
  'home-after-latest',
  'home-before-guide',
  'boyama-index-after-content',
  'boyama-detail-after-parent-guide',
  'story-after-parent-guide',
]);
const normalizedSlot = slot?.trim();
const hasValidSlot = Boolean(normalizedSlot && /^\d{6,20}$/.test(normalizedSlot));
const showAd = eligible
  && adsenseEnabled
  && approvedPlacements.has(placement)
  && hasValidSlot;
---

{
  showAd && (
    <aside class="ad-slot" aria-label="Reklam" data-ad-placement={placement} data-ad-safety="content-only">
      <p class="ad-label">Reklam</p>
      <ins
        class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-5606540854153205"
        data-ad-slot={normalizedSlot}
        data-ad-format="auto"
        data-full-width-responsive="true"
        data-tag-for-age-treatment="1"
      ></ins>
      <script is:inline>
        window.adsbygoogle = window.adsbygoogle || [];
        window.adsbygoogle.push({});
      </script>
    </aside>
  )
}

<style>
  .ad-slot {
    width: 100%;
    min-height: 120px;
    margin-block: 72px;
    padding: 22px;
    border: 1px solid #e4e7ef;
    border-radius: 18px;
    background: #fff;
  }

  .ad-label {
    margin-bottom: 12px;
    color: #697590;
    font-size: .66rem;
    font-weight: 800;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  @media (max-width: 720px) {
    .ad-slot {
      min-height: 100px;
      margin-block: 60px;
      padding: 18px 14px;
    }

  }
</style>
