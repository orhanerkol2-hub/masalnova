---
interface Game {
  slug: string;
  title: string;
  category: string;
  age: string;
  image: string;
  imageAlt: string;
  shortDescription: string;
  skills: string[];
}

interface Props { game: Game }
const { game } = Astro.props;
---
<article class="game-card">
  <a class="game-cover" href={`/oyna/${game.slug}/`} aria-label={`${game.title} oyununu incele`}>
    <img src={game.image} alt={game.imageAlt} width="640" height="394" loading="lazy" />
    <span class="game-badge"><i class="ph ph-game-controller" aria-hidden="true"></i> Oyun</span>
  </a>
  <div class="game-body">
    <div class="game-meta">
      <span>{game.category}</span>
      <span>{game.age}</span>
    </div>
    <h2><a href={`/oyna/${game.slug}/`}>{game.title}</a></h2>
    <p>{game.shortDescription}</p>
    <ul aria-label="Geliştirdiği beceriler">
      {game.skills.slice(0, 2).map((skill) => <li>{skill}</li>)}
    </ul>
    <a class="game-cta" href={`/oyna/${game.slug}/`}>
      Oyunu incele <i class="ph ph-arrow-right" aria-hidden="true"></i>
    </a>
  </div>
</article>

<style>
  .game-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 24px;
    background: #fff;
    color: var(--ink);
    box-shadow: 0 18px 42px rgba(3,26,92,.24);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .game-card:hover { transform: translateY(-5px); box-shadow: 0 24px 52px rgba(3,26,92,.31); }
  .game-cover { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #dce7ff; }
  .game-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform .28s ease; }
  .game-card:hover .game-cover img { transform: scale(1.035); }
  .game-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 11px;
    border: 1px solid rgba(255,255,255,.55);
    border-radius: 999px;
    background: rgba(8,38,112,.88);
    color: #fff;
    font-size: .76rem;
    font-weight: 900;
    backdrop-filter: blur(8px);
  }
  .game-body { display: flex; flex: 1; flex-direction: column; padding: 18px; }
  .game-meta { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 10px; }
  .game-meta span, li {
    border-radius: 999px;
    background: #edf3ff;
    color: #1c51bd;
    font-size: .72rem;
    font-weight: 900;
  }
  .game-meta span { padding: 4px 9px; }
  h2 { font-size: 1.18rem; }
  h2 a:hover { color: var(--blue-d); }
  p { margin-top: 8px; color: var(--ink-soft); font-size: .91rem; line-height: 1.5; }
  ul { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 14px; list-style: none; }
  li { padding: 4px 9px; background: #fff4dc; color: #8a5700; }
  .game-cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 17px;
    color: #174ab7;
    font-weight: 900;
  }
  .game-cta i { transition: transform .18s ease; }
  .game-card:hover .game-cta i { transform: translateX(3px); }
</style>
