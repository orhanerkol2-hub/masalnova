---
interface Props {
  /** Disable AdSense loading on gameplay and other sensitive pages. */
  allowAds?: boolean;
}

const { allowAds = false } = Astro.props;
// These flags may be enabled only after the certified CMP is active and
// account-wide Auto ads are disabled. They are deployment assertions, not a
// technical certification or a substitute for the account-side settings.
const adsenseEnabled = allowAds
  && import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true'
  && import.meta.env.PUBLIC_GOOGLE_CERTIFIED_CMP === 'true'
  && import.meta.env.PUBLIC_ADSENSE_MANUAL_ONLY === 'true';
---

{
  adsenseEnabled && (
    <script
      async
      is:inline
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5606540854153205"
      crossorigin="anonymous"
    ></script>
  )
}
