---
interface Props {
  /** Disable AdSense loading on gameplay and other sensitive pages. */
  allowAds?: boolean;
}

const { allowAds = false } = Astro.props;
// The publisher tag displays Google's certified CMP and allows AdSense to
// review eligible surfaces. It does not render a manual ad unit by itself;
// PUBLIC_ADSENSE_ENABLED remains a separate, fail-closed switch in AdSlot.
const publisherTagEnabled = allowAds
  && import.meta.env.PUBLIC_ADSENSE_TAG_ENABLED === 'true'
  && import.meta.env.PUBLIC_GOOGLE_CMP_PUBLISHED === 'true'
  && import.meta.env.PUBLIC_ADSENSE_MANUAL_ONLY === 'true';
---

{
  publisherTagEnabled && (
    <script
      async
      is:inline
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5606540854153205"
      crossorigin="anonymous"
    ></script>
  )
}
