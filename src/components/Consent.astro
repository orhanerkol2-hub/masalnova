---
// Google Privacy & messaging is the only consent interface on ad-capable
// pages. Analytics stays disabled so visitors never see a second banner.
---

{/* Establish conservative defaults before the Google publisher tag runs. */}
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('consent', 'default', {
    ad_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    analytics_storage: 'denied',
    wait_for_update: 500
  });
  gtag('set', 'ads_data_redaction', true);
  window['ga-disable-G-YZYEN24W6J'] = true;

  window.googlefc = window.googlefc || {};
  window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
</script>

<script is:inline>
  (function () {
    var LEGACY_STORAGE_KEY = 'masalnova:cookie-consent:v2';

    function removeLegacyAnalyticsData() {
      try {
        localStorage.removeItem(LEGACY_STORAGE_KEY);
      } catch (error) {}

      try {
        document.cookie.split(';').forEach(function (entry) {
          var name = entry.split('=')[0].trim();
          if (name !== '_ga' && name.indexOf('_ga_') !== 0) return;
          document.cookie = name + '=; Max-Age=0; Path=/; SameSite=Lax';
          document.cookie = name + '=; Max-Age=0; Path=/; Domain=.masalnova.com; SameSite=Lax';
        });
      } catch (error) {}
    }

    function isCmpSurface() {
      return Boolean(document.querySelector('meta[name="masalnova-cmp-surface"]'));
    }

    function showRevocationMessage() {
      if (typeof window.googlefc.showRevocationMessage === 'function') {
        window.googlefc.callbackQueue.push(window.googlefc.showRevocationMessage);
      }
    }

    function requestPrivacySettings() {
      var completed = false;
      var fallbackTimer = window.setTimeout(function () {
        if (!completed) window.location.assign('/datenschutz/');
      }, 2500);

      function showWhenReady() {
        if (typeof window.googlefc.showRevocationMessage !== 'function') return;
        completed = true;
        window.clearTimeout(fallbackTimer);
        showRevocationMessage();
      }

      if (typeof window.googlefc.showRevocationMessage === 'function') {
        showWhenReady();
        return;
      }
      window.googlefc.callbackQueue.push({ CONSENT_API_READY: showWhenReady });
    }

    function openPrivacySettings(event) {
      if (!isCmpSurface()) return;
      event.preventDefault();
      requestPrivacySettings();
    }

    function bindPrivacySettings() {
      document.querySelectorAll('[data-open-cookie-settings]').forEach(function (trigger) {
        trigger.addEventListener('click', openPrivacySettings);
      });

      var parameters = new URLSearchParams(window.location.search);
      if (parameters.get('privacy-settings') !== '1' || !isCmpSurface()) return;
      parameters.delete('privacy-settings');
      var cleanQuery = parameters.toString();
      window.history.replaceState(null, '', window.location.pathname + (cleanQuery ? '?' + cleanQuery : '') + window.location.hash);
      requestPrivacySettings();
    }

    removeLegacyAnalyticsData();

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bindPrivacySettings, { once: true });
    } else {
      bindPrivacySettings();
    }
  })();
</script>
