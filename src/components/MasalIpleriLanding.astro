---
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  slug: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  friend: string;
  mission: string;
}

const game = Astro.props;
const gameUrl = `https://masalnova.com/oyna/${game.slug}/`;
const gamePath = `/games/${game.slug}/`;
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'VideoGame', name: game.title,
    description: game.description, url: gameUrl, image: `https://masalnova.com${game.image}`,
    inLanguage: 'tr-TR', applicationCategory: 'Game', genre: ['Physics puzzle', "Children's game"],
    gamePlatform: ['Web browser', 'Mobile web'], playMode: 'SinglePlayer', typicalAgeRange: '5-9',
    numberOfPlayers: 1, publisher: { '@type': 'Organization', name: 'MasalNova' },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana Sayfa', item: 'https://masalnova.com/' },
      { '@type': 'ListItem', position: 2, name: 'Oyunlar', item: 'https://masalnova.com/oyunlar/' },
      { '@type': 'ListItem', position: 3, name: game.title, item: gameUrl },
    ],
  },
];
---

<BaseLayout
  title={`${game.title} Oyna | MasalNova`}
  description={`${game.description} MasalNova’ya özel, reklamsız ve ücretsiz Türkçe tarayıcı oyununu oyna.`}
  path={`/oyna/${game.slug}/`}
  image={game.image}
  imageAlt={game.imageAlt}
  activeNav="oyunlar"
  allowAds={false}
  jsonLd={jsonLd}
>
  <section class="game-page" style={`--game-cover: url('${game.image}')`}>
    <div class="container">
      <nav class="breadcrumbs" aria-label="İçerik yolu">
        <a href="/">Ana Sayfa</a><span aria-hidden="true">›</span>
        <a href="/oyunlar/">Oyunlar</a><span aria-hidden="true">›</span><span>{game.title}</span>
      </nav>

      <div class="game-heading">
        <div>
          <div class="meta-row">
            <span class="exclusive-pill"><i class="ph ph-seal-check" aria-hidden="true"></i> MasalNova’ya özel</span>
            <span>3 fizik bulmacası</span><span>Direkt başlangıç</span><span>Öneri: 5+</span>
          </div>
          <h1>{game.title}</h1><p>{game.description}</p>
        </div>
        <div class="heading-actions">
          <a class="fullscreen-link" href={gamePath} data-fullscreen-trigger><i class="ph ph-arrows-out" aria-hidden="true"></i> Tam ekran oyna</a>
          <a class="back-link" href="/oyunlar/"><i class="ph ph-grid-four" aria-hidden="true"></i> Tüm oyunlar</a>
        </div>
      </div>

      <section class="player-shell" aria-label={`${game.title} oyun alanı`} data-player-shell>
        <iframe data-src={gamePath} title={`${game.title} — MasalNova oyun alanı`} allow="fullscreen" allowfullscreen loading="lazy" data-game-frame></iframe>
        <a class="mobile-game-launch" href={gamePath} aria-label={`${game.title} oyununu tam ekranda başlat`} data-fullscreen-trigger>
          <span><i class="ph ph-arrows-out" aria-hidden="true"></i><b>Tam ekran oyna<small>Dokun ve masala gir</small></b></span>
        </a>
      </section>

      <p class="local-note"><i class="ph ph-shield-check" aria-hidden="true"></i> Reklamsız, güvenli ve doğrudan MasalNova tarafından sunulur.</p>

      <div class="game-info-grid">
        <article class="info-card"><span class="info-icon"><i class="ph ph-scissors"></i></span><div><h2>Nasıl oynanır?</h2><p>Fareyi veya parmağını ipin üzerinden kaydır. Emanetin yönünü değiştirip doğru anda serbest bırak.</p></div></article>
        <article class="info-card"><span class="info-icon"><i class="ph ph-star"></i></span><div><h2>Her yıldızı bul</h2><p>Her bölümde üç yıldızı topla. Rüzgârları, zıplama yüzeylerini ve hareketli engelleri kullan.</p></div></article>
        <article class="info-card"><span class="info-icon"><i class="ph ph-sparkle"></i></span><div><h2>{game.friend} için masal</h2><p>{game.mission}</p></div></article>
      </div>
    </div>
  </section>
  <script>import '../scripts/masal-ipleri-shell';</script>
</BaseLayout>

<style>
  .game-page { position: relative; isolation: isolate; overflow: hidden; min-height: 100dvh; padding: 28px 0 64px; background: radial-gradient(circle at 50% 15%, rgba(79,116,218,.32), transparent 44%), linear-gradient(180deg,#07152e,#030814 70%,#07142a); }
  .game-page::before { position: absolute; z-index: -2; inset: 0 0 auto; height: min(760px,76vw); background: linear-gradient(180deg,rgba(4,12,30,.18),#07152e 75%,#030814),linear-gradient(90deg,rgba(3,10,27,.62),transparent 50%,rgba(3,10,27,.48)),var(--game-cover) center / cover no-repeat; content:''; filter:saturate(.88); opacity:.5; pointer-events:none; }
  .game-page .container { position:relative; max-width:1260px; }
  .breadcrumbs { display:flex; flex-wrap:wrap; align-items:center; gap:8px; color:rgba(255,255,255,.72); font-size:.78rem; font-weight:800; }
  .breadcrumbs a:hover { color:#fff; text-decoration:underline; }
  .game-heading { display:flex; align-items:end; justify-content:space-between; gap:28px; margin:22px 0 18px; color:#fff; }
  .meta-row { display:flex; flex-wrap:wrap; gap:7px; margin-bottom:10px; }
  .meta-row span { display:inline-flex; align-items:center; gap:5px; padding:5px 10px; border:1px solid rgba(255,255,255,.28); border-radius:999px; background:rgba(5,19,47,.52); font-size:.73rem; font-weight:900; backdrop-filter:blur(9px); }
  .meta-row .exclusive-pill { border-color:#ffe18b; background:#ffd25b; color:#5f3700; }
  h1 { font-size:clamp(2rem,5vw,3.65rem); letter-spacing:-.04em; }
  .game-heading p { max-width:770px; margin-top:9px; color:rgba(255,255,255,.82); }
  .heading-actions { display:flex; flex:0 0 auto; gap:9px; }
  .fullscreen-link,.back-link { display:inline-flex; align-items:center; gap:8px; padding:10px 14px; border:1px solid rgba(255,255,255,.3); border-radius:999px; background:rgba(5,19,47,.56); color:#fff; font-size:.8rem; font-weight:900; backdrop-filter:blur(9px); }
  .fullscreen-link { border-color:#ffd45b; background:#ffd45b; color:#593600; }
  .player-shell { position:relative; overflow:hidden; border:1px solid rgba(255,218,113,.38); border-radius:26px; background:#030916; box-shadow:0 34px 90px rgba(0,0,0,.56),0 0 0 7px rgba(255,255,255,.025),0 0 58px rgba(57,115,218,.18); }
  .player-shell::before { position:absolute; z-index:3; inset:0; border-radius:inherit; box-shadow:inset 0 0 0 1px rgba(255,255,255,.09),inset 0 20px 38px rgba(0,0,0,.12); content:''; pointer-events:none; }
  .player-shell iframe { display:block; width:100%; height:min(760px,calc(100dvh - 116px)); min-height:600px; border:0; background:#0c1d36; }
  .mobile-game-launch { display:none; }
  .player-shell:fullscreen { width:100vw; height:100dvh; border:0; border-radius:0; }
  .player-shell:fullscreen iframe { width:100%; height:100%; min-height:100%; }
  .player-shell:fullscreen .mobile-game-launch { display:none; }
  :global(html.game-fullscreen-active),:global(body.game-fullscreen-active) { height:100%; overflow:hidden!important; }
  .local-note { display:flex; align-items:flex-start; gap:9px; margin:16px 4px 0; color:rgba(220,231,255,.68); font-size:.78rem; }
  .local-note i { color:#72dca7; font-size:1rem; }
  .game-info-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; margin-top:18px; }
  .info-card { display:flex; gap:15px; padding:22px; border:1px solid rgba(255,255,255,.13); border-radius:20px; background:linear-gradient(145deg,rgba(19,43,84,.76),rgba(8,23,52,.74)); color:#fff; box-shadow:0 18px 44px rgba(0,0,0,.18); backdrop-filter:blur(12px); }
  .info-icon { display:grid; flex:0 0 auto; width:42px; height:42px; place-items:center; border-radius:13px; background:#ffd14b; color:#173169; font-size:1.3rem; }
  .info-card h2 { font-size:1.08rem; }
  .info-card p { margin-top:6px; color:rgba(255,255,255,.75); font-size:.88rem; }
  @media(max-width:980px){.game-info-grid{grid-template-columns:1fr}}
  @media(max-width:820px){.game-heading{align-items:flex-start;flex-direction:column}.heading-actions{width:100%}.fullscreen-link{justify-content:center;flex:1}.back-link{display:none}.player-shell{height:min(680px,calc(100dvh - 164px));min-height:500px;background:linear-gradient(0deg,rgba(3,15,39,.7),transparent),var(--game-cover) center/cover no-repeat}.player-shell iframe{height:100%;min-height:100%;pointer-events:none}.mobile-game-launch{position:absolute;z-index:4;inset:0;display:flex;align-items:flex-end;justify-content:center;padding:22px}.mobile-game-launch>span{display:inline-flex;align-items:center;gap:10px;padding:12px 18px;border:1px solid #fff;border-radius:999px;background:#ffd45b;color:#593600;box-shadow:0 12px 30px rgba(0,15,66,.34)}.mobile-game-launch b{display:grid;font-size:.84rem}.mobile-game-launch small{font-size:.67rem;opacity:.72}.player-shell:fullscreen iframe{pointer-events:auto}}
  @media(max-width:480px){.game-page{padding-top:22px}.player-shell{margin-inline:-12px;border-radius:20px}}
</style>
