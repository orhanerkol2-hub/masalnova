---
interface LegalSection {
  heading: string;
  paragraphs?: string[];
  lines?: string[];
  bullets?: string[];
}

interface LegalDocumentData {
  title: string;
  subtitle: string;
  sections: LegalSection[];
  note?: string;
}

interface Props {
  document: LegalDocumentData;
  lang?: string;
  homeLabel?: string;
}

const { document, lang = 'en', homeLabel = 'Home' } = Astro.props;
---

<article class="legal-document" lang={lang}>
  <header>
    <h1>{document.title}</h1>
    <p class="legal-document__subtitle">{document.subtitle}</p>
  </header>

  {document.sections.map((section) => (
    <section>
      <h2>{section.heading}</h2>
      {section.paragraphs?.map((paragraph) => <p>{paragraph}</p>)}
      {section.lines && (
        <div class="legal-document__lines">
          {section.lines.map((line) => <p>{line}</p>)}
        </div>
      )}
      {section.bullets && (
        <ul>
          {section.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
      )}
    </section>
  ))}

  {document.note && <p class="legal-document__note">{document.note}</p>}
  <a class="btn btn-ghost" href="/">← {homeLabel}</a>
</article>

<style>
  .legal-document {
    max-width: 900px;
    margin: 0 auto;
    padding: 32px clamp(20px, 5vw, 46px);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: #fff;
    box-shadow: var(--shadow-lg);
    color: var(--ink);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.6rem, 4vw, 2.3rem);
  }

  .legal-document__subtitle {
    margin: 8px 0 0;
    color: var(--muted);
    font-weight: 700;
  }

  section {
    margin-top: 28px;
  }

  h2 {
    margin: 0 0 10px;
    font-size: clamp(1.15rem, 2.4vw, 1.4rem);
  }

  p,
  li {
    line-height: 1.72;
  }

  section > p,
  .legal-document__lines p {
    margin: 8px 0 0;
  }

  .legal-document__lines {
    margin-top: 10px;
  }

  ul {
    margin: 10px 0 0;
    padding-left: 22px;
  }

  .legal-document__note {
    margin: 28px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-weight: 800;
  }

  .btn {
    margin-top: 28px;
    border-color: var(--blue);
    color: var(--blue-d);
  }
</style>
